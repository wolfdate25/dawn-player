<?xml version="1.0" encoding="utf-8"?>
<Window
    x:Class="DawnPlayer.App.MainWindow"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:local="using:DawnPlayer.App"
    xmlns:controls="using:DawnPlayer.App.Controls"
    xmlns:views="using:DawnPlayer.App.Views">

    <Grid x:Name="RootGrid" AllowDrop="True" Background="Transparent"
          DragOver="OnRootDragOver" Drop="OnRootDrop" PointerPressed="OnRootPointerPressed" KeyDown="OnRootKeyDown">
        <Grid.RowDefinitions>
            <RowDefinition Height="40"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <!-- Eole Blurred Artwork Wallpaper Background Layer -->
        <Grid Grid.RowSpan="3" IsHitTestVisible="False">
            <Image x:Name="WallpaperImage" Stretch="UniformToFill" Opacity="0"
                   HorizontalAlignment="Center" VerticalAlignment="Center"/>
            <Rectangle x:Name="WallpaperDimOverlay" Fill="#9918181D" Opacity="0"/>
        </Grid>

        <!-- 1. Eole Style Horizontal Top Bar & Navigation.
             Column contract (pinned by MainWindowTitleBarLayoutTests): the status text owns the
             flexible (*) column so narrowing ellipsizes it instead of pushing the nav tabs under
             the system caption buttons; Auto columns hold only content that must not shrink.
             The stepwise shedding (status → brand) lives in OnTitleBarSizeChanged —
             AdaptiveTrigger did not re-evaluate on programmatic/live resizes in this window. -->
        <Grid x:Name="AppTitleBar" Grid.Row="0" Height="40" Padding="12,0,140,0"
              BorderBrush="{ThemeResource SeparatorSubtleBrush}" BorderThickness="0,0,0,1"
              SizeChanged="OnTitleBarSizeChanged">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto"/>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="Auto"/>
                <ColumnDefinition Width="Auto"/>
            </Grid.ColumnDefinitions>

            <!-- Brand & Status Text -->
            <StackPanel Grid.Column="0" Orientation="Horizontal" VerticalAlignment="Center" Spacing="8" Margin="0,0,24,0">
                <Button x:Uid="MainWindow_TitleMenuButton" Style="{StaticResource TitleMenuButtonStyle}" ToolTipService.ToolTip="메뉴">
                    <FontIcon Glyph="&#xE700;" FontSize="13" Foreground="{ThemeResource TextSecondaryBrush}"/>
                    <Button.Flyout>
                        <MenuFlyout Opening="OnTitleMenuOpening">
                            <MenuFlyoutItem x:Uid="MainWindow_Menu_Rescan" Text="라이브러리 새로고침" Click="OnMenuRescan">
                                <MenuFlyoutItem.Icon><FontIcon Glyph="&#xE72C;"/></MenuFlyoutItem.Icon>
                            </MenuFlyoutItem>
                            <MenuFlyoutItem x:Uid="MainWindow_Menu_OpenUrl" Text="네트워크 스트림 열기 (라디오)..." Click="OnMenuOpenUrl">
                                <MenuFlyoutItem.Icon><FontIcon Glyph="&#xE968;"/></MenuFlyoutItem.Icon>
                            </MenuFlyoutItem>
                            <MenuFlyoutSubItem x:Uid="MainWindow_Menu_SleepTimer" x:Name="SleepTimerMenu" Text="수면 타이머">
                                <MenuFlyoutSubItem.Icon><FontIcon Glyph="&#xE708;"/></MenuFlyoutSubItem.Icon>
                                <ToggleMenuFlyoutItem x:Uid="MainWindow_Menu_Sleep_Off" x:Name="SleepOffItem" Text="끔" Click="OnSleepTimerOff"/>
                                <ToggleMenuFlyoutItem x:Uid="MainWindow_Menu_Sleep_15" x:Name="Sleep15Item" Text="15분" Click="OnSleepTimer15"/>
                                <ToggleMenuFlyoutItem x:Uid="MainWindow_Menu_Sleep_30" x:Name="Sleep30Item" Text="30분" Click="OnSleepTimer30"/>
                                <ToggleMenuFlyoutItem x:Uid="MainWindow_Menu_Sleep_60" x:Name="Sleep60Item" Text="1시간" Click="OnSleepTimer60"/>
                                <ToggleMenuFlyoutItem x:Uid="MainWindow_Menu_Sleep_Track" x:Name="SleepTrackItem" Text="현재 곡 끝나고" Click="OnSleepTimerAfterTrack"/>
                            </MenuFlyoutSubItem>
                            <MenuFlyoutItem x:Uid="MainWindow_Menu_Mini" x:Name="MiniModeMenuItem" Text="미니 플레이어 (Mini Player)" Click="OnMenuMiniToggle">
                                <MenuFlyoutItem.Icon><FontIcon Glyph="&#xE740;"/></MenuFlyoutItem.Icon>
                            </MenuFlyoutItem>
                            <MenuFlyoutItem x:Uid="MainWindow_Menu_Fullscreen" x:Name="FullscreenMenuItem" Text="풀스크린 Now Playing (Full-screen Now Playing)" Click="OnMenuFullscreen">
                                <MenuFlyoutItem.Icon><FontIcon Glyph="&#xE7F4;"/></MenuFlyoutItem.Icon>
                            </MenuFlyoutItem>
                            <MenuFlyoutItem x:Uid="MainWindow_Menu_Report" Text="청취 리포트 (Listening Report)..." Click="OnMenuReport">
                                <MenuFlyoutItem.Icon><FontIcon Glyph="&#xE9D9;"/></MenuFlyoutItem.Icon>
                            </MenuFlyoutItem>
                            <MenuFlyoutSeparator/>
                            <MenuFlyoutItem x:Uid="MainWindow_Menu_Exit" Text="종료" Click="OnMenuExit">
                                <MenuFlyoutItem.Icon><FontIcon Glyph="&#xE711;"/></MenuFlyoutItem.Icon>
                            </MenuFlyoutItem>
                        </MenuFlyout>
                    </Button.Flyout>
                </Button>
                <StackPanel x:Name="AppBrandText" Orientation="Horizontal" Spacing="8" VerticalAlignment="Center">
                    <TextBlock x:Uid="AppBrand" Text="Dawn Player" FontSize="{StaticResource FontBody}" FontWeight="SemiBold"
                               Foreground="{ThemeResource TextPrimaryBrush}" VerticalAlignment="Center"/>
                    <TextBlock Text="|" FontSize="11" Foreground="{ThemeResource SeparatorSubtleBrush}" VerticalAlignment="Center"/>
                </StackPanel>
            </StackPanel>

            <!-- Live status text: the flexible column is also the drag surface (a non-interactive
                 TextBlock never blocks dragging), so it ellipsizes away before the tabs move. -->
            <Grid x:Name="AppTitleBarDragArea" Grid.Column="1" Background="Transparent">
                <TextBlock x:Uid="MainWindow_TitleBarTrack" x:Name="TitleBarTrack" Text="No sound — Nothing played" FontSize="{StaticResource FontBodySmall}"
                           Foreground="{ThemeResource TextTertiaryBrush}" VerticalAlignment="Center" HorizontalAlignment="Left"
                           MaxWidth="320" Margin="0,0,24,0" TextTrimming="CharacterEllipsis"
                           AutomationProperties.LiveSetting="Polite"/>
            </Grid>

            <!-- Eole Horizontal Navigation Tabs (Library / Playlists / Network) -->
            <StackPanel x:Name="TopNavPanel" Grid.Column="2" Orientation="Horizontal" Spacing="2" VerticalAlignment="Stretch"
                        DoubleTapped="OnTabDoubleTapped">
                <RadioButton x:Name="TabLibrary" GroupName="TopNavGroup" IsChecked="True"
                             AutomationProperties.AutomationId="TabLibrary"
                             Style="{StaticResource EoleNavTabStyle}" Click="OnTabLibraryClick"
                             DoubleTapped="OnTabDoubleTapped">
                    <StackPanel Orientation="Horizontal" Spacing="6" VerticalAlignment="Center">
                        <FontIcon Glyph="&#xE8B9;" FontSize="12"/>
                        <TextBlock x:Uid="MainWindow_Tab_Library" Text="Library" FontSize="{StaticResource FontBody}"/>
                    </StackPanel>
                </RadioButton>
                <RadioButton x:Name="TabPlaylists" GroupName="TopNavGroup"
                             AutomationProperties.AutomationId="TabPlaylists"
                             Style="{StaticResource EoleNavTabStyle}" Click="OnTabPlaylistsClick"
                             DoubleTapped="OnTabDoubleTapped">
                    <StackPanel Orientation="Horizontal" Spacing="6" VerticalAlignment="Center">
                        <FontIcon Glyph="&#xE90B;" FontSize="12"/>
                        <TextBlock x:Uid="MainWindow_Tab_Playlists" Text="Playlists" FontSize="{StaticResource FontBody}"/>
                    </StackPanel>
                </RadioButton>
                <RadioButton x:Name="TabNetwork" GroupName="TopNavGroup"
                             AutomationProperties.AutomationId="TabNetwork"
                             Style="{StaticResource EoleNavTabStyle}" Click="OnTabNetworkClick"
                             DoubleTapped="OnTabDoubleTapped">
                    <StackPanel Orientation="Horizontal" Spacing="6" VerticalAlignment="Center">
                        <FontIcon Glyph="&#xE777;" FontSize="12"/>
                        <TextBlock x:Uid="MainWindow_Tab_Network" Text="Network" FontSize="{StaticResource FontBody}"/>
                    </StackPanel>
                </RadioButton>
            </StackPanel>

            <!-- 3. Dedicated Draggable Title Bar Area & Right Tools -->
            <StackPanel Grid.Column="3" Orientation="Horizontal" VerticalAlignment="Center" Margin="0,0,4,0">
                <Button x:Uid="MainWindow_SettingsGearButton" x:Name="SettingsGearButton" Style="{StaticResource TitleMenuButtonStyle}" Click="OnMenuSettings" ToolTipService.ToolTip="환경설정">
                    <FontIcon x:Name="SettingsGearIcon" Glyph="&#xE713;" FontSize="13" Foreground="{ThemeResource TextSecondaryBrush}"/>
                </Button>
            </StackPanel>
        </Grid>

        <!-- 2. Main Content Viewport (Full Width).
             The lyrics pane lives inside LibraryPage and PlaylistPage, which own their own
             splitter and width; a third window-level pane was never reachable and only cost a
             duplicate lyrics load and polling timer per track change. -->
        <Grid x:Name="ContentHost" Grid.Row="1">
            <views:LibraryPage x:Name="LibraryPageView" Visibility="Visible"/>
            <views:PlaylistPage x:Name="PlaylistPageView" Visibility="Collapsed"/>
            <views:NetworkPage x:Name="NetworkPageView" Visibility="Collapsed"/>
            <Frame x:Name="ContentFrame" Visibility="Collapsed"/>
        </Grid>

        <!-- 3. Bottom Player Bar -->
        <controls:NowPlayingBar x:Name="PlayerBar" Grid.Row="2"/>

        <InfoBar x:Name="NotifyBar" Grid.Row="1" HorizontalAlignment="Right" VerticalAlignment="Bottom"
                 Margin="0,0,16,12" MaxWidth="460" IsOpen="False" Severity="Informational"
                 Closed="OnNotifyBarClosed"
                 AutomationProperties.LiveSetting="Polite"/>
    </Grid>
</Window>

<?xml version="1.0" encoding="utf-8"?>
<Page
    x:Name="RootPage"
    x:Class="DawnPlayer.App.Views.LibraryPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:core="using:DawnPlayer.Core.Models"
    xmlns:controls="using:DawnPlayer.App.Controls"
    xmlns:local="using:DawnPlayer.App.Views"
    xmlns:lib="using:DawnPlayer.Core.Playlists"
    xmlns:services="using:DawnPlayer.App.Services"
    NavigationCacheMode="Enabled">

    <Page.Resources>
        <services:TimeSpanTextConverter x:Key="TimeSpanText"/>
        <services:TrackNoFormatterConverter x:Key="TrackNoText"/>
        <services:BoolToVisibilityConverter x:Key="BoolToVis"/>
        <services:BoolToVisibilityConverter x:Key="PlayingVis"/>
        <services:InverseBoolToVisibilityConverter x:Key="NotPlayingVis"/>
        <services:InverseBoolToVisibilityConverter x:Key="NotFolderVis"/>
        <services:IsPlayingToBrushConverter x:Key="PlayingBrush"/>
        <services:IsPlayingToFontWeightConverter x:Key="PlayingFontWeight"/>
        <services:RatingToStarsConverter x:Key="RatingStars"/>
        <services:RatingAccessibilityConverter x:Key="RatingAccess"/>

        <!-- L11 shared rating flyout for the track table (single shared instance, like PlaylistPage). -->
        <Flyout x:Name="LibraryRatingFlyout" Placement="Top" Closed="OnLibraryRatingFlyoutClosed">
            <StackPanel Spacing="6" MinWidth="190">
                <RatingControl x:Name="LibraryRatingSelector" x:Uid="Rating_Selector"
                               MaxRating="5" IsClearEnabled="True"
                               ValueChanged="OnLibraryRatingSelectorValueChanged"/>
                <TextBlock x:Uid="Rating_ClearHint" Text="선택한 별을 다시 누르면 평점이 지워집니다."
                           FontSize="11" Foreground="{ThemeResource TextTertiaryBrush}"
                           TextWrapping="Wrap" HorizontalAlignment="Center"/>
            </StackPanel>
        </Flyout>

        <CollectionViewSource x:Name="RightQueueCvs" IsSourceGrouped="True" ItemsPath="Items"/>

        <Style x:Key="ColumnHeaderButton" TargetType="Button">
            <Setter Property="UseSystemFocusVisuals" Value="True"/>
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Padding" Value="4,2"/>
            <Setter Property="HorizontalContentAlignment" Value="Left"/>
            <Setter Property="VerticalContentAlignment" Value="Center"/>
            <Setter Property="HorizontalAlignment" Value="Stretch"/>
        </Style>

        <Style x:Key="AlbumCardButtonStyle" TargetType="Button">
            <Setter Property="UseSystemFocusVisuals" Value="True"/>
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Padding" Value="0"/>
            <Setter Property="Margin" Value="6"/>
            <Setter Property="CornerRadius" Value="4"/>
            <Setter Property="HorizontalContentAlignment" Value="Left"/>
            <Setter Property="VerticalContentAlignment" Value="Top"/>
        </Style>

        <Style x:Key="TrackRowButtonStyle" TargetType="Button">
            <Setter Property="UseSystemFocusVisuals" Value="True"/>
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Padding" Value="4,1"/>
            <Setter Property="MinHeight" Value="24"/>
            <Setter Property="CornerRadius" Value="3"/>
            <Setter Property="Margin" Value="0,0.5"/>
            <Setter Property="HorizontalAlignment" Value="Stretch"/>
            <Setter Property="HorizontalContentAlignment" Value="Stretch"/>
        </Style>

        <!-- 2026-10-03 (사용자 지정 기하학): 셰브런 폭 8px, 셰브런→제목 간격 1px, 상하 패딩 1px.
             WinUI 기본 템플릿은 셰브런 칸에 하드코딩 Padding 14,0 + 글리프 12px, 그리고
             PresenterMargin 4,2 / PresenterPadding 0,3,0,5 테마 리소스를 더해 간격을 못 좞는다.
             기본 템플릿(WinUI 2.3.6 generic.xaml MUX_TreeViewItemStyle)을 그대로 복제하고
             세 기하학 값만 바꿨다 — 시각 상태(선택·호버·드래그)와 색은 원본 그대로다. -->
        <Style x:Key="EoleTreeItemStyle" TargetType="TreeViewItem">
            <Setter Property="Padding" Value="1,1"/>
            <Setter Property="Background" Value="{ThemeResource TreeViewItemBackground}"/>
            <Setter Property="BorderBrush" Value="{ThemeResource TreeViewItemBorderBrush}"/>
            <Setter Property="BorderThickness" Value="{ThemeResource TreeViewItemBorderThemeThickness}"/>
            <Setter Property="GlyphBrush" Value="{ThemeResource TreeViewItemForeground}"/>
            <Setter Property="MinHeight" Value="28"/>
            <Setter Property="CornerRadius" Value="{ThemeResource ControlCornerRadius}"/>
            <Setter Property="FocusVisualMargin" Value="0,-1,0,-1"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="TreeViewItem">
                        <Grid x:Name="ContentPresenterGrid" Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}" BorderThickness="{TemplateBinding BorderThickness}" Margin="0" Padding="0" CornerRadius="{TemplateBinding CornerRadius}">

                            <VisualStateManager.VisualStateGroups>
                                <VisualStateGroup x:Name="CommonStates">
                                    <VisualState x:Name="Normal"/>

                                    <VisualState x:Name="PointerOver">
                                        <VisualState.Setters>
                                            <Setter Target="ContentPresenterGrid.Background" Value="{ThemeResource TreeViewItemBackgroundPointerOver}"/>
                                            <Setter Target="ContentPresenter.Foreground" Value="{ThemeResource TreeViewItemForegroundPointerOver}"/>
                                            <Setter Target="SelectionIndicator.Fill" Value="{ThemeResource TreeViewItemSelectionIndicatorForegroundPointerOver}"/>
                                            <Setter Target="CollapsedGlyph.Foreground" Value="{ThemeResource TreeViewItemForegroundPointerOver}"/>
                                            <Setter Target="ExpandedGlyph.Foreground" Value="{ThemeResource TreeViewItemForegroundPointerOver}"/>
                                            <Setter Target="ContentPresenterGrid.BorderBrush" Value="{ThemeResource TreeViewItemBorderBrushPointerOver}"/>
                                            <Setter Target="SelectionIndicator.Opacity" Value="0"/>
                                        </VisualState.Setters>
                                    </VisualState>

                                    <VisualState x:Name="Pressed">
                                        <VisualState.Setters>
                                            <Setter Target="ContentPresenterGrid.Background" Value="{ThemeResource TreeViewItemBackgroundPressed}"/>
                                            <Setter Target="ContentPresenter.Foreground" Value="{ThemeResource TreeViewItemForegroundPressed}"/>
                                            <Setter Target="SelectionIndicator.Fill" Value="{ThemeResource TreeViewItemSelectionIndicatorForegroundPressed}"/>
                                            <Setter Target="CollapsedGlyph.Foreground" Value="{ThemeResource TreeViewItemForegroundPressed}"/>
                                            <Setter Target="ExpandedGlyph.Foreground" Value="{ThemeResource TreeViewItemForegroundPressed}"/>
                                            <Setter Target="ContentPresenterGrid.BorderBrush" Value="{ThemeResource TreeViewItemBorderBrushPressed}"/>
                                            <Setter Target="SelectionIndicator.Opacity" Value="0"/>
                                        </VisualState.Setters>
                                    </VisualState>

                                    <VisualState x:Name="Selected">
                                        <VisualState.Setters>
                                            <Setter Target="ContentPresenterGrid.Background" Value="{ThemeResource TreeViewItemBackgroundSelected}"/>
                                            <Setter Target="ContentPresenter.Foreground" Value="{ThemeResource TreeViewItemForegroundSelected}"/>
                                            <Setter Target="SelectionIndicator.Fill" Value="{ThemeResource TreeViewItemSelectionIndicatorForeground}"/>
                                            <Setter Target="CollapsedGlyph.Foreground" Value="{ThemeResource TreeViewItemForegroundSelected}"/>
                                            <Setter Target="ExpandedGlyph.Foreground" Value="{ThemeResource TreeViewItemForegroundSelected}"/>
                                            <Setter Target="ContentPresenterGrid.BorderBrush" Value="{ThemeResource TreeViewItemBorderBrushSelected}"/>
                                            <Setter Target="SelectionIndicator.Opacity" Value="1"/>
                                        </VisualState.Setters>
                                    </VisualState>

                                    <VisualState x:Name="Disabled">
                                        <VisualState.Setters>
                                            <Setter Target="ContentPresenterGrid.Background" Value="{ThemeResource TreeViewItemBackgroundDisabled}"/>
                                            <Setter Target="ContentPresenter.Foreground" Value="{ThemeResource TreeViewItemForegroundDisabled}"/>
                                            <Setter Target="SelectionIndicator.Fill" Value="{ThemeResource TreeViewItemSelectionIndicatorForegroundDisabled}"/>
                                            <Setter Target="CollapsedGlyph.Foreground" Value="{ThemeResource TreeViewItemForegroundDisabled}"/>
                                            <Setter Target="ExpandedGlyph.Foreground" Value="{ThemeResource TreeViewItemForegroundDisabled}"/>
                                            <Setter Target="ContentPresenterGrid.BorderBrush" Value="{ThemeResource TreeViewItemBorderBrushDisabled}"/>
                                        </VisualState.Setters>
                                    </VisualState>

                                    <VisualState x:Name="PointerOverSelected">
                                        <VisualState.Setters>
                                            <Setter Target="ContentPresenterGrid.Background" Value="{ThemeResource TreeViewItemBackgroundSelectedPointerOver}"/>
                                            <Setter Target="ContentPresenter.Foreground" Value="{ThemeResource TreeViewItemForegroundSelectedPointerOver}"/>
                                            <Setter Target="SelectionIndicator.Fill" Value="{ThemeResource TreeViewItemSelectionIndicatorForegroundPointerOver}"/>
                                            <Setter Target="CollapsedGlyph.Foreground" Value="{ThemeResource TreeViewItemForegroundSelectedPointerOver}"/>
                                            <Setter Target="ExpandedGlyph.Foreground" Value="{ThemeResource TreeViewItemForegroundSelectedPointerOver}"/>
                                            <Setter Target="ContentPresenterGrid.BorderBrush" Value="{ThemeResource TreeViewItemBorderBrushSelectedPointerOver}"/>
                                            <Setter Target="SelectionIndicator.Opacity" Value="1"/>
                                        </VisualState.Setters>
                                    </VisualState>

                                    <VisualState x:Name="PressedSelected">
                                        <VisualState.Setters>
                                            <Setter Target="ContentPresenterGrid.Background" Value="{ThemeResource TreeViewItemBackgroundSelectedPressed}"/>
                                            <Setter Target="ContentPresenter.Foreground" Value="{ThemeResource TreeViewItemForegroundSelectedPressed}"/>
                                            <Setter Target="SelectionIndicator.Fill" Value="{ThemeResource TreeViewItemSelectionIndicatorForegroundPressed}"/>
                                            <Setter Target="CollapsedGlyph.Foreground" Value="{ThemeResource TreeViewItemForegroundSelectedPressed}"/>
                                            <Setter Target="ExpandedGlyph.Foreground" Value="{ThemeResource TreeViewItemForegroundSelectedPressed}"/>
                                            <Setter Target="ContentPresenterGrid.BorderBrush" Value="{ThemeResource TreeViewItemBorderBrushSelectedPressed}"/>
                                            <Setter Target="SelectionIndicator.Opacity" Value="1"/>
                                        </VisualState.Setters>
                                    </VisualState>

                                    <VisualState x:Name="SelectedDisabled">
                                        <VisualState.Setters>
                                            <Setter Target="ContentPresenterGrid.Background" Value="{ThemeResource TreeViewItemBackgroundSelectedDisabled}"/>
                                            <Setter Target="ContentPresenter.Foreground" Value="{ThemeResource TreeViewItemForegroundSelectedDisabled}"/>
                                            <Setter Target="SelectionIndicator.Fill" Value="{ThemeResource TreeViewItemSelectionIndicatorForegroundDisabled}"/>
                                            <Setter Target="CollapsedGlyph.Foreground" Value="{ThemeResource TreeViewItemForegroundSelectedDisabled}"/>
                                            <Setter Target="ExpandedGlyph.Foreground" Value="{ThemeResource TreeViewItemForegroundSelectedDisabled}"/>
                                            <Setter Target="ContentPresenterGrid.BorderBrush" Value="{ThemeResource TreeViewItemBorderBrushSelectedDisabled}"/>
                                            <Setter Target="SelectionIndicator.Opacity" Value="1"/>
                                        </VisualState.Setters>
                                    </VisualState>

                                    <VisualState x:Name="ReorderedPlaceholder">
                                        <Storyboard>
                                            <FadeOutThemeAnimation TargetName="MultiSelectGrid"/>
                                        </Storyboard>
                                    </VisualState>
                                </VisualStateGroup>

                                <VisualStateGroup x:Name="DragStates">
                                    <VisualState x:Name="NotDragging"/>
                                    <VisualState x:Name="MultipleDraggingPrimary">
                                        <VisualState.Setters>
                                            <Setter Target="MultiSelectCheckBox.Opacity" Value="0"/>
                                            <Setter Target="MultiArrangeOverlayTextBorder.Visibility" Value="Visible"/>
                                        </VisualState.Setters>
                                    </VisualState>
                                </VisualStateGroup>
                            </VisualStateManager.VisualStateGroups>

                            <Rectangle x:Name="SelectionIndicator" Width="3" Height="16" Fill="{ThemeResource TreeViewItemSelectionIndicatorForeground}" Opacity="0" HorizontalAlignment="Left" VerticalAlignment="Center" RadiusX="2" RadiusY="2"/>
                            <Grid x:Name="MultiSelectGrid" Margin="{ThemeResource TreeViewItemMultiSelectSelectedItemBorderMargin}" Padding="{Binding RelativeSource={RelativeSource TemplatedParent}, Path=TreeViewItemTemplateSettings.Indentation}" BorderBrush="Transparent" BorderThickness="{ThemeResource TreeViewItemBorderThemeThickness}" CornerRadius="{ThemeResource ControlCornerRadius}">

                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="Auto"/>
                                    <ColumnDefinition Width="Auto"/>
                                    <ColumnDefinition/>
                                </Grid.ColumnDefinitions>
                                <Grid Grid.Column="0">
                                    <CheckBox x:Name="MultiSelectCheckBox" Width="32" MinWidth="32" MinHeight="{ThemeResource TreeViewItemMultiSelectCheckBoxMinHeight}" Margin="10,0,0,0" VerticalAlignment="Center" Visibility="Collapsed" IsTabStop="False" AutomationProperties.AccessibilityView="Raw"/>
                                    <Border x:Name="MultiArrangeOverlayTextBorder" Visibility="Collapsed" IsHitTestVisible="False" MinWidth="20" Height="20" VerticalAlignment="Center" HorizontalAlignment="Center" Background="{ThemeResource SystemControlBackgroundAccentBrush}" BorderThickness="1" BorderBrush="{ThemeResource SystemControlBackgroundChromeWhiteBrush}" CornerRadius="{ThemeResource ControlCornerRadius}">
                                        <TextBlock x:Name="MultiArrangeOverlayText" Text="{Binding RelativeSource={RelativeSource TemplatedParent}, Path=TreeViewItemTemplateSettings.DragItemsCount}" Style="{ThemeResource CaptionTextBlockStyle}" Foreground="{ThemeResource SystemControlForegroundChromeWhiteBrush}" IsHitTestVisible="False" VerticalAlignment="Center" HorizontalAlignment="Center" AutomationProperties.AccessibilityView="Raw"/>
                                    </Border>
                                </Grid>
                                <!-- 셰브런 칸 8px 고정(원본 Auto + Padding 14,0), 글리프 8×8(원본 12×12 + 내부 패딩 2) -->
                                <Grid x:Name="ExpandCollapseChevron" Grid.Column="1" Padding="0" Width="8" Opacity="{TemplateBinding GlyphOpacity}" Background="Transparent">
                                    <TextBlock x:Name="CollapsedGlyph" Foreground="{TemplateBinding GlyphBrush}" Width="8" Height="8" Visibility="{Binding RelativeSource={RelativeSource TemplatedParent}, Path=TreeViewItemTemplateSettings.CollapsedGlyphVisibility}" FontSize="8" Text="{TemplateBinding CollapsedGlyph}" FontFamily="{StaticResource SymbolThemeFontFamily}" VerticalAlignment="Center" AutomationProperties.AccessibilityView="Raw" IsTextScaleFactorEnabled="False" IsHitTestVisible="False"/>
                                    <TextBlock x:Name="ExpandedGlyph" Foreground="{TemplateBinding GlyphBrush}" Width="8" Height="8" Visibility="{Binding RelativeSource={RelativeSource TemplatedParent}, Path=TreeViewItemTemplateSettings.ExpandedGlyphVisibility}" FontSize="8" Text="{TemplateBinding ExpandedGlyph}" FontFamily="{StaticResource SymbolThemeFontFamily}" VerticalAlignment="Center" AutomationProperties.AccessibilityView="Raw" IsTextScaleFactorEnabled="False" IsHitTestVisible="False"/>
                                </Grid>
                                <!-- Padding이 여기 흘러든다: 좌 1px = 셰브런→제목 간격, 상하 1px -->
                                <ContentPresenter x:Name="ContentPresenter" Grid.Column="2" ContentTransitions="{TemplateBinding ContentTransitions}" ContentTemplate="{TemplateBinding ContentTemplate}" Content="{TemplateBinding Content}" Foreground="{TemplateBinding Foreground}" HorizontalAlignment="{TemplateBinding HorizontalContentAlignment}" VerticalAlignment="{TemplateBinding VerticalContentAlignment}" MinHeight="{TemplateBinding MinHeight}" Margin="{TemplateBinding Padding}"/>

                            </Grid>

                        </Grid>

                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </Page.Resources>

    <Grid x:Name="MainLayoutGrid" Background="{ThemeResource LayerBgBrush}">
        <Grid.ColumnDefinitions>
            <!-- Left Panel: Library Tree (Resizable) -->
            <ColumnDefinition x:Name="ColLeft" Width="220" MinWidth="140" MaxWidth="550"/>
            <!-- Center Panel: Cover Grid or Track List (Fluid) -->
            <ColumnDefinition x:Name="ColCenter" Width="*"/>
            <!-- Lyrics Panel: Situated to the LEFT of the Right Panel (Auto/Resizable) -->
            <ColumnDefinition x:Name="ColLyrics" Width="Auto"/>
            <!-- Right Panel: Album Details / Quick Track View (Resizable) -->
            <ColumnDefinition x:Name="ColRight" Width="300" MinWidth="180" MaxWidth="500"/>
        </Grid.ColumnDefinitions>

        <!-- [Panel 1] Left Filter Tree (Library Tree with Grouping Mode Selector) -->
        <Grid Grid.Column="0" Background="{ThemeResource PanelSubtleBrush}"
              BorderBrush="{ThemeResource SeparatorSubtleBrush}" BorderThickness="0,0,1,0">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="*"/>
            </Grid.RowDefinitions>

            <Grid Grid.Row="0" Margin="12,10,12,6">
                <TextBlock x:Uid="Library_TreeHeader" Text="Library Tree" FontSize="11" FontWeight="SemiBold"
                           Foreground="{ThemeResource TextTertiaryBrush}" VerticalAlignment="Center"/>
            </Grid>

            <!-- Tree Grouping Mode Selector Dropdown -->
            <ComboBox x:Name="TreeGroupModeBox" Grid.Row="1" Margin="10,0,10,8"
                      HorizontalAlignment="Stretch" Height="30" Padding="8,3"
                      SelectedIndex="0" SelectionChanged="OnTreeGroupModeChanged">
                <ComboBoxItem x:Uid="Library_TreeMode_ArtistAlbum" Content="아티스트 / 앨범"/>
                <ComboBoxItem x:Uid="Library_TreeMode_Artist" Content="아티스트"/>
                <ComboBoxItem x:Uid="Library_TreeMode_GenreArtist" Content="장르 / 아티스트"/>
                <ComboBoxItem x:Uid="Library_TreeMode_GenreArtistAlbum" Content="장르 / 아티스트 / 앨범"/>
                <ComboBoxItem x:Uid="Library_TreeMode_Album" Content="앨범"/>
                <ComboBoxItem x:Uid="Library_TreeMode_Genre" Content="장르"/>
                <ComboBoxItem x:Uid="Library_TreeMode_Folder" Content="폴더 구조"/>
            </ComboBox>

            <!-- Hierarchical Library TreeView -->
            <!-- KeyDown is wired in code with handledEventsToo: a TreeViewItem marks Enter handled
                 for its own invoke/expand behaviour, so a KeyDown handler declared here never ran
                 and "Enter plays the selected node" did nothing. -->
            <TreeView x:Name="LibraryTree" Grid.Row="2" SelectionMode="Single"
                      ItemInvoked="OnTreeItemInvoked"
                      SelectionChanged="OnTreeSelectionChanged"
                      Expanding="OnTreeExpanding"
                      Padding="0,0,4,16">
                <!-- A: container diet — rows draw their own 26px template, so the
                     TreeViewItem adds no extra height or horizontal gutter.
                     Chevron column and indent stay template-owned. -->
                <!-- 2026-10-03 사용자 지정 기하학: EoleTreeItemStyle(페이지 리소스) — 셰브런 8px,
                     셰브런→제목 1px, 상하 패딩 1px. 행 본체는 아래 26px 템플릿. -->
                <TreeView.ItemContainerStyle>
                    <Style TargetType="TreeViewItem" BasedOn="{StaticResource EoleTreeItemStyle}"/>
                </TreeView.ItemContainerStyle>
                <TreeView.ItemTemplate>
                    <DataTemplate>
                        <Grid Height="26" ColumnSpacing="0" Background="Transparent" DoubleTapped="OnTreeItemDoubleTapped"
                              AutomationProperties.Name="{Binding Content.Title}">
                            <Grid.ContextFlyout>
                                <MenuFlyout Opening="OnTreeContextMenuOpening">
                                    <MenuFlyoutItem x:Uid="Library_TreeMenu_Play" Text="재생 (플레이리스트 대체)" Click="OnTreeContextMenuPlay">
                                        <MenuFlyoutItem.Icon><FontIcon Glyph="&#xE768;"/></MenuFlyoutItem.Icon>
                                    </MenuFlyoutItem>
                                    <MenuFlyoutItem x:Uid="Library_TreeMenu_AddToPlaylist" Text="현재 재생목록에 추가" Click="OnTreeContextMenuAddToPlaylist">
                                        <MenuFlyoutItem.Icon><FontIcon Glyph="&#xE710;"/></MenuFlyoutItem.Icon>
                                    </MenuFlyoutItem>
                                    <MenuFlyoutSubItem x:Uid="Library_TreeMenu_SendToPlaylist" Tag="SendToPlaylist" Text="특정 재생목록에 추가">
                                        <MenuFlyoutSubItem.Icon><FontIcon Glyph="&#xE8B9;"/></MenuFlyoutSubItem.Icon>
                                    </MenuFlyoutSubItem>
                                    <MenuFlyoutItem x:Uid="Library_TreeMenu_Enqueue" Text="대기열에 추가" Click="OnTreeContextMenuEnqueue">
                                        <MenuFlyoutItem.Icon><FontIcon Glyph="&#xE8D2;"/></MenuFlyoutItem.Icon>
                                    </MenuFlyoutItem>
                                </MenuFlyout>
                            </Grid.ContextFlyout>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto"/>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>
                            <FontIcon Grid.Column="0" Glyph="{Binding Content.Glyph}" FontSize="11" Margin="0,0,6,0"
                                      Visibility="{Binding Content.IsFolder, Converter={StaticResource NotFolderVis}}"
                                      Foreground="{ThemeResource TextTertiaryBrush}"/>
                            <TextBlock Grid.Column="1" Text="{Binding Content.Title}" FontSize="12"
                                       VerticalAlignment="Center" TextTrimming="CharacterEllipsis"
                                       Foreground="{ThemeResource TextPrimaryBrush}"/>
                            <TextBlock Grid.Column="2" Text="{Binding Content.CountText}" FontSize="{StaticResource FontCaption}"
                                       Foreground="{ThemeResource TextTertiaryBrush}" VerticalAlignment="Center"
                                       Margin="6,0,6,0"/>
                        </Grid>
                    </DataTemplate>
                </TreeView.ItemTemplate>
            </TreeView>

            <!-- Left Splitter Grip (Spanning all 3 rows of the left panel) -->
            <Border x:Name="LeftSplitter" Grid.RowSpan="3" HorizontalAlignment="Right" Width="10" Margin="0,0,-5,0"
                    Background="Transparent" Canvas.ZIndex="50"
                    PointerEntered="OnSplitterPointerEntered" PointerExited="OnSplitterPointerExited"
                    PointerPressed="OnLeftSplitterPressed" PointerMoved="OnLeftSplitterMoved" PointerReleased="OnLeftSplitterReleased">
                <Rectangle x:Name="LeftSplitterLine" Width="2" HorizontalAlignment="Center" Fill="Transparent"/>
            </Border>
        </Grid>

        <!-- [Panel 2] Center Area: Sub-Header + Cover Grid or Track List -->
        <Grid Grid.Column="1">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="*"/>
            </Grid.RowDefinitions>

            <!-- 1. Eole Sub-Header Bar (Breadcrumb, Stats & Search) -->
            <Grid Grid.Row="0" Padding="14,6,14,6" BorderBrush="{ThemeResource SeparatorSubtleBrush}" BorderThickness="0,0,0,1">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>

                <!-- Left: Selection & Stats Breadcrumb -->
                <StackPanel Grid.Column="0" Orientation="Horizontal" Spacing="8" VerticalAlignment="Center">
                    <FontIcon Glyph="&#xE8B9;" FontSize="11" Foreground="{ThemeResource DawnAccentTextBrush}"/>
                    <TextBlock x:Name="StatusText" FontSize="{StaticResource FontBodySmall}" Foreground="{ThemeResource TextSecondaryBrush}"
                               Text="" VerticalAlignment="Center" TextTrimming="CharacterEllipsis"/>
                </StackPanel>

                <!-- Right: Search, View Mode Toggle, Zoom Flyout & Rescan -->
                <StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="6" VerticalAlignment="Center">
                    <AutoSuggestBox x:Uid="Library_SearchBox" x:Name="SearchBox" Width="140" Height="28" PlaceholderText="Search..."
                                    QueryIcon="Find" TextChanged="OnSearchChanged" FontSize="{StaticResource FontBodySmall}"/>

                    <!-- Segmented View Mode Toggle (Grid / List) -->
                    <Border Background="{ThemeResource PanelSubtleBrush}" BorderBrush="{ThemeResource BorderSubtleBrush}"
                            BorderThickness="1" CornerRadius="4" Padding="2" Height="28" VerticalAlignment="Center">
                        <StackPanel Orientation="Horizontal" Spacing="2">
                            <RadioButton x:Uid="Library_ViewGridBtn" x:Name="ViewGridBtn" GroupName="ViewModeGroup" IsChecked="True"
                                         Style="{StaticResource SegmentedTabStyle}" Click="OnViewGridClick"
 ToolTipService.ToolTip="커버 그리드 뷰">
                                <FontIcon Glyph="&#xE80A;" FontSize="11"/>
                            </RadioButton>
                            <RadioButton x:Uid="Library_ViewListBtn" x:Name="ViewListBtn" GroupName="ViewModeGroup"
                                         Style="{StaticResource SegmentedTabStyle}" Click="OnViewListClick"
 ToolTipService.ToolTip="목록 테이블 뷰">
                                <FontIcon Glyph="&#xEA37;" FontSize="11"/>
                            </RadioButton>
                        </StackPanel>
                    </Border>

                    <!-- Cover Zoom Flyout Button -->
                    <Button x:Uid="Library_Zoom_Button" Style="{StaticResource TransportButton}" Width="32" Height="32"
 ToolTipService.ToolTip="커버 크기 조절 (Ctrl+마우스 휠)">
                        <!-- Cover-size mark: MDL2 Picture (E91B), same language/weight/size
                             as the neighboring toolbar glyphs (E80A/EA37/E72C @11). -->
                        <FontIcon Glyph="&#xE91B;" FontSize="11"/>
                        <Button.Flyout>
                            <Flyout Placement="Bottom" Opened="OnCoverZoomFlyoutOpened">
                                <StackPanel Width="190" Spacing="8" Padding="6">
                                    <Grid>
                                        <TextBlock x:Uid="Library_Zoom_Title" Text="커버 크기" FontSize="{StaticResource FontBodySmall}" FontWeight="SemiBold"/>
                                        <TextBlock x:Name="ZoomLabel" Text="144px" FontSize="11" Foreground="{ThemeResource TextTertiaryBrush}" HorizontalAlignment="Right"/>
                                    </Grid>
                                    <Slider x:Name="CoverZoomSlider" Minimum="80" Maximum="260" StepFrequency="4"
                                            Value="144" Loaded="OnCoverZoomSliderLoaded" ValueChanged="OnCoverZoomSliderChanged"/>
                                    <Grid ColumnSpacing="4">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*"/>
                                            <ColumnDefinition Width="*"/>
                                            <ColumnDefinition Width="*"/>
                                            <ColumnDefinition Width="*"/>
                                        </Grid.ColumnDefinitions>
                                        <Button x:Uid="Library_Zoom_Small" Grid.Column="0" Content="소" FontSize="{StaticResource FontCaption}" Padding="0,2" HorizontalAlignment="Stretch" Click="OnZoomSmall"/>
                                        <Button x:Uid="Library_Zoom_Medium" Grid.Column="1" Content="중" FontSize="{StaticResource FontCaption}" Padding="0,2" HorizontalAlignment="Stretch" Click="OnZoomMedium"/>
                                        <Button x:Uid="Library_Zoom_Large" Grid.Column="2" Content="대" FontSize="{StaticResource FontCaption}" Padding="0,2" HorizontalAlignment="Stretch" Click="OnZoomLarge"/>
                                        <Button x:Uid="Library_Zoom_ExtraLarge" Grid.Column="3" Content="특대" FontSize="{StaticResource FontCaption}" Padding="0,2" HorizontalAlignment="Stretch" Click="OnZoomExtraLarge"/>
                                    </Grid>
                                </StackPanel>
                            </Flyout>
                        </Button.Flyout>
                    </Button>

                    <Button x:Uid="Library_RescanButton" x:Name="RescanButton" Style="{StaticResource TransportButton}" Width="32" Height="32"
                            Click="OnRescanClick" ToolTipService.ToolTip="라이브러리 새로고침">
                        <FontIcon Glyph="&#xE72C;" FontSize="11"/>
                    </Button>
                </StackPanel>
            </Grid>

            <!-- 2. Scan Progress Bar -->
            <ProgressBar x:Name="ScanProgress" Grid.Row="1" Visibility="Collapsed" ShowPaused="False" Height="2"
                         AutomationProperties.LiveSetting="Polite"/>

            <!-- 3. Center Content Viewport -->
            <Grid Grid.Row="2">
                <!-- A: Cover Grid View (Default) with Eole In-line Album Tracklist Inspector -->
                <Grid x:Name="CoverGridViewContainer" Visibility="Visible" SizeChanged="OnCoverGridSizeChanged">
                    <ScrollViewer x:Name="CoverScrollViewer"
                                  VerticalScrollBarVisibility="Auto"
                                  HorizontalScrollBarVisibility="Disabled"
                                  PointerWheelChanged="OnCoverGridPointerWheelChanged"
                                  Padding="14,14,14,24">
                        <!-- ItemsRepeater (not ItemsControl) so only the rows actually on screen are
                             realized: an ItemsControl builds every row, every album card, every card's
                             context flyout and every cover BitmapImage up front, which costs hundreds of
                             milliseconds and hundreds of megabytes on a real library. -->
                        <ItemsRepeater x:Name="AlbumRowsControl" ItemsSource="{x:Bind AlbumRows}">
                            <ItemsRepeater.Layout>
                                <StackLayout Orientation="Vertical" Spacing="8"/>
                            </ItemsRepeater.Layout>
                            <ItemsRepeater.ItemTemplate>
                                <DataTemplate x:DataType="local:AlbumRowVm">
                                    <StackPanel Margin="0,0,0,8">
                                        <!-- Row of Album Cards -->
                                        <ItemsControl ItemsSource="{x:Bind Cards}">
                                            <ItemsControl.ItemsPanel>
                                                <ItemsPanelTemplate>
                                                    <StackPanel Orientation="Horizontal"/>
                                                </ItemsPanelTemplate>
                                            </ItemsControl.ItemsPanel>
                                            <ItemsControl.ItemTemplate>
                                                <DataTemplate x:DataType="local:AlbumCard">
                                                    <Button Style="{StaticResource AlbumCardButtonStyle}"
                                                            Tapped="OnAlbumCardTapped"
                                                            DoubleTapped="OnAlbumCardDoubleTapped">
                                                         <Button.ContextFlyout>
                                                            <MenuFlyout Opening="OnAlbumMenuOpening">
                                                                <MenuFlyoutItem x:Uid="Library_AlbumMenu_Play" Text="앨범 재생" Click="OnAlbumPlaySelected">
                                                                    <MenuFlyoutItem.Icon><FontIcon Glyph="&#xE768;"/></MenuFlyoutItem.Icon>
                                                                </MenuFlyoutItem>
                                                                <MenuFlyoutItem x:Uid="Library_AlbumMenu_AddToPlaylist" Text="현재 재생목록에 추가" Click="OnAlbumAddToPlaylist">
                                                                    <MenuFlyoutItem.Icon><FontIcon Glyph="&#xE710;"/></MenuFlyoutItem.Icon>
                                                                </MenuFlyoutItem>
                                                                <MenuFlyoutSubItem x:Uid="Library_AlbumMenu_SendToPlaylist" Tag="SendToPlaylist" Text="특정 재생목록에 추가">
                                                                    <MenuFlyoutSubItem.Icon><FontIcon Glyph="&#xE8B9;"/></MenuFlyoutSubItem.Icon>
                                                                </MenuFlyoutSubItem>
                                                                <MenuFlyoutItem x:Uid="Library_AlbumMenu_Enqueue" Text="대기열에 추가" Click="OnAlbumEnqueue">
                                                                    <MenuFlyoutItem.Icon><FontIcon Glyph="&#xE8FD;"/></MenuFlyoutItem.Icon>
                                                                </MenuFlyoutItem>
                                                                <MenuFlyoutItem x:Uid="Library_AlbumMenu_EditTags" Text="앨범 태그 편집…" Click="OnAlbumEditTags">
                                                                    <MenuFlyoutItem.Icon><FontIcon Glyph="&#xE70F;"/></MenuFlyoutItem.Icon>
                                                                </MenuFlyoutItem>
                                                            </MenuFlyout>
                                                        </Button.ContextFlyout>
                                                        <Grid Width="{x:Bind CardWidth, Mode=OneWay}" Background="Transparent" Padding="2">
                                                            <Grid.RowDefinitions>
                                                                <RowDefinition Height="Auto"/>
                                                                <RowDefinition Height="Auto"/>
                                                                <RowDefinition Height="Auto"/>
                                                                <RowDefinition Height="Auto"/>
                                                            </Grid.RowDefinitions>

                                                            <!-- Cover Art + Year Badge Overlay -->
                                                            <Border Grid.Row="0" Height="{x:Bind ImageHeight, Mode=OneWay}" CornerRadius="4" Background="{ThemeResource PanelBrush}"
                                                                    BorderBrush="{ThemeResource BorderSubtleBrush}" BorderThickness="1">
                                                                <Grid>
                                                                    <FontIcon Glyph="&#xE90B;" FontSize="28" Foreground="{ThemeResource TextTertiaryBrush}"/>
                                                                    <Image Source="{x:Bind Art}" Stretch="UniformToFill"/>

                                                                    <!-- Eole Year Badge Overlay (Top-Left) -->
                                                                    <Border Style="{StaticResource YearBadgeStyle}"
                                                                            Visibility="{x:Bind HasYear, Converter={StaticResource BoolToVis}}">
                                                                        <TextBlock Text="{x:Bind YearString}" FontSize="{StaticResource FontCaption}" FontWeight="SemiBold"
                                                                                   Foreground="#FFF0F0F0"/>
                                                                    </Border>
                                                                </Grid>
                                                            </Border>

                                                            <!-- 1st Line: Bold Artist / Album -->
                                                            <TextBlock Grid.Row="1" Text="{x:Bind Artist}" FontSize="12" FontWeight="SemiBold"
                                                                       Foreground="{ThemeResource TextPrimaryBrush}" Margin="0,5,0,0"
                                                                       TextTrimming="CharacterEllipsis"/>

                                                            <!-- 2nd Line: Secondary Text -->
                                                            <TextBlock Grid.Row="2" Text="{x:Bind Album}" FontSize="11"
                                                                       Foreground="{ThemeResource TextSecondaryBrush}"
                                                                       TextTrimming="CharacterEllipsis"/>

                                                            <!-- Eole Active Selection Downward Caret Arrow (▼) -->
                                                            <FontIcon Grid.Row="3" Glyph="&#xE96E;" FontSize="11"
                                                                      Foreground="{ThemeResource DawnAccentTextBrush}"
                                                                      HorizontalAlignment="Center" Margin="0,2,0,-6"
                                                                      Visibility="{x:Bind IsSelected, Mode=OneWay, Converter={StaticResource BoolToVis}}"/>
                                                        </Grid>
                                                    </Button>
                                                </DataTemplate>
                                            </ItemsControl.ItemTemplate>
                                        </ItemsControl>

                                        <!-- Eole In-line Album Tracklist Drawer (Showlist) directly below this row.
                                             x:Load defers the whole drawer subtree until this row's drawer is
                                             actually opened; a Visibility binding alone would still build the
                                             header, both track lists and their context flyouts for every row. -->
                                        <Border x:Name="RowDrawer"
                                                x:Load="{x:Bind IsDrawerOpen, Mode=OneWay}"
                                                Visibility="{x:Bind IsDrawerOpen, Mode=OneWay, Converter={StaticResource BoolToVis}}"
                                                Background="{ThemeResource PanelSubtleBrush}"
                                                BorderBrush="{ThemeResource SeparatorSubtleBrush}" BorderThickness="0,1,0,1"
                                                Padding="22,14,22,16" Margin="0,8,0,4">
                                            <Grid>
                                                <Grid.RowDefinitions>
                                                    <RowDefinition Height="Auto"/>
                                                    <RowDefinition Height="Auto"/>
                                                </Grid.RowDefinitions>

                                                <!-- 1. Drawer Header (Album Title, Artist, Stats, Genre, Quick Actions, Close Button) -->
                                                <Grid Grid.Row="0" Margin="0,0,0,12">
                                                    <Grid.ColumnDefinitions>
                                                        <ColumnDefinition Width="*"/>
                                                        <ColumnDefinition Width="Auto"/>
                                                    </Grid.ColumnDefinitions>

                                                    <!-- Left: Album Title (Italic SemiBold) & Artist -->
                                                    <StackPanel Grid.Column="0" Spacing="2" VerticalAlignment="Center">
                                                        <TextBlock Text="{x:Bind DrawerAlbumTitle, Mode=OneWay}"
                                                                   FontSize="{StaticResource FontTitle}" FontWeight="SemiBold" FontStyle="Italic"
                                                                   Foreground="{ThemeResource TextPrimaryBrush}" TextTrimming="CharacterEllipsis"/>
                                                        <TextBlock Text="{x:Bind DrawerArtist, Mode=OneWay}"
                                                                   FontSize="{StaticResource FontBody}" Foreground="{ThemeResource TextSecondaryBrush}"
                                                                   TextTrimming="CharacterEllipsis"/>
                                                    </StackPanel>

                                                    <!-- Right: Stats, Genre & Quick Action Buttons -->
                                                    <Grid Grid.Column="1" HorizontalAlignment="Right">
                                                        <Grid.RowDefinitions>
                                                            <RowDefinition Height="Auto"/>
                                                            <RowDefinition Height="Auto"/>
                                                        </Grid.RowDefinitions>
                                                        <StackPanel Grid.Row="0" Orientation="Horizontal" Spacing="10" HorizontalAlignment="Right" VerticalAlignment="Center">
                                                            <TextBlock Text="{x:Bind DrawerStats, Mode=OneWay}"
                                                                       FontSize="{StaticResource FontBodySmall}" Foreground="{ThemeResource TextTertiaryBrush}" VerticalAlignment="Center"/>
                                                            
                                                            <!-- Quick Action Toolbar -->
                                                            <StackPanel Orientation="Horizontal" Spacing="4" VerticalAlignment="Center" Margin="6,0,0,0">
                                                                <Button x:Uid="Library_Drawer_PlayAlbum" Style="{StaticResource TransportButton}" Width="32" Height="32"
                                                                        Click="OnDrawerPlayAlbumClick" ToolTipService.ToolTip="앨범 전체 재생">
                                                                    <FontIcon Glyph="&#xE768;" FontSize="11" Foreground="{ThemeResource TextSecondaryBrush}"/>
                                                                </Button>
                                                                <Button x:Uid="Library_Drawer_EnqueueAlbum" Style="{StaticResource TransportButton}" Width="32" Height="32"
                                                                        Click="OnDrawerEnqueueAlbumClick" ToolTipService.ToolTip="대기열에 추가">
                                                                    <FontIcon Glyph="&#xE8FD;" FontSize="11" Foreground="{ThemeResource TextSecondaryBrush}"/>
                                                                </Button>
                                                                <Button x:Uid="Library_Drawer_AddToPlaylist" Style="{StaticResource TransportButton}" Width="32" Height="32"
                                                                        Click="OnDrawerAddToPlaylistClick" ToolTipService.ToolTip="현재 재생목록에 추가">
                                                                    <FontIcon Glyph="&#xE710;" FontSize="11" Foreground="{ThemeResource TextSecondaryBrush}"/>
                                                                </Button>
                                                                <Button x:Uid="Library_Drawer_Close" Style="{StaticResource TransportButton}" Width="32" Height="32"
                                                                        Click="OnCloseRowDrawerClick" ToolTipService.ToolTip="닫기 (Esc)" Margin="4,0,0,0">
                                                                    <FontIcon Glyph="&#xE711;" FontSize="{StaticResource FontCaption}" Foreground="{ThemeResource TextTertiaryBrush}"/>
                                                                </Button>
                                                            </StackPanel>
                                                        </StackPanel>
                                                        <TextBlock Grid.Row="1" Text="{x:Bind DrawerGenre, Mode=OneWay}"
                                                                   Visibility="{x:Bind HasGenre, Mode=OneWay, Converter={StaticResource BoolToVis}}"
                                                                   FontSize="11" Foreground="{ThemeResource TextTertiaryBrush}"
                                                                   HorizontalAlignment="Right" Margin="0,2,0,0"/>
                                                    </Grid>
                                                </Grid>

                                                <!-- 2. 2-Column Track List -->
                                                <Grid Grid.Row="1" ColumnSpacing="28">
                                                    <Grid.ColumnDefinitions>
                                                        <ColumnDefinition Width="*"/>
                                                        <ColumnDefinition Width="*"/>
                                                    </Grid.ColumnDefinitions>

                                                    <!-- Left Column Track List -->
                                                    <ItemsControl Grid.Column="0"
                                                                  ItemsSource="{x:Bind LeftTracks, Mode=OneWay}">
                                                        <ItemsControl.ItemTemplate>
                                                            <DataTemplate x:DataType="lib:AlbumTrackItemVm">
                                                                <Button Style="{StaticResource TrackRowButtonStyle}"
                                                                        DoubleTapped="OnDrawerTrackDoubleTapped"
                                                                        KeyDown="OnDrawerTrackKeyDown">
                                                                    <Button.ContextFlyout>
                                                                        <MenuFlyout Opening="OnDrawerTrackMenuOpening">
                                                                            <MenuFlyoutItem x:Uid="Library_TrackMenu_Play" Text="재생" Click="OnDrawerTrackPlaySelected">
                                                                                <MenuFlyoutItem.Icon><FontIcon Glyph="&#xE768;"/></MenuFlyoutItem.Icon>
                                                                            </MenuFlyoutItem>
                                                                            <MenuFlyoutItem x:Uid="Library_TrackMenu_AddToPlaylist" Text="현재 재생목록에 추가" Click="OnDrawerTrackAddToPlaylist">
                                                                                <MenuFlyoutItem.Icon><FontIcon Glyph="&#xE710;"/></MenuFlyoutItem.Icon>
                                                                            </MenuFlyoutItem>
                                                                            <MenuFlyoutSubItem x:Uid="Library_TrackMenu_SendToPlaylist" Tag="SendToPlaylist" Text="특정 재생목록에 추가">
                                                                                <MenuFlyoutSubItem.Icon><FontIcon Glyph="&#xE8B9;"/></MenuFlyoutSubItem.Icon>
                                                                            </MenuFlyoutSubItem>
                                                                            <MenuFlyoutItem x:Uid="Library_TrackMenu_Enqueue" Text="대기열에 추가" Click="OnDrawerTrackEnqueue">
                                                                                <MenuFlyoutItem.Icon><FontIcon Glyph="&#xE8FD;"/></MenuFlyoutItem.Icon>
                                                                            </MenuFlyoutItem>
                                                                            <MenuFlyoutSeparator/>
                                                                            <MenuFlyoutItem x:Uid="Library_TrackMenu_ShowInExplorer" Text="탐색기에서 보기" Click="OnDrawerTrackShowInExplorer">
                                                                                <MenuFlyoutItem.Icon><FontIcon Glyph="&#xE838;"/></MenuFlyoutItem.Icon>
                                                                            </MenuFlyoutItem>
                                                                        </MenuFlyout>
                                                                    </Button.ContextFlyout>
                                                                    <Grid ColumnSpacing="6" Padding="2,1">
                                                                        <Grid.ColumnDefinitions>
                                                                            <ColumnDefinition Width="32"/>
                                                                            <ColumnDefinition Width="*"/>
                                                                            <ColumnDefinition Width="Auto"/>
                                                                        </Grid.ColumnDefinitions>

                                                                        <!-- Track No / Playing Speaker Icon -->
                                                                        <Grid Grid.Column="0" VerticalAlignment="Center">
                                                                            <TextBlock Text="{x:Bind TrackNoFormatted}"
                                                                                       Visibility="{x:Bind IsPlaying, Mode=OneWay, Converter={StaticResource NotPlayingVis}}"
                                                                                       FontSize="{StaticResource FontBodySmall}" FontStyle="Italic" Foreground="{ThemeResource TextTertiaryBrush}"/>
                                                                            <FontIcon Glyph="&#xE767;" FontSize="11"
                                                                                       Foreground="{ThemeResource DawnAccentTextBrush}"
                                                                                       Visibility="{x:Bind IsPlaying, Mode=OneWay, Converter={StaticResource BoolToVis}}"/>
                                                                        </Grid>

                                                                        <!-- Title -->
                                                                        <TextBlock Grid.Column="1" Text="{x:Bind Title}"
                                                                                   FontSize="{StaticResource FontBodySmall}"
                                                                                   Foreground="{x:Bind IsPlaying, Mode=OneWay, Converter={StaticResource PlayingBrush}}"
                                                                                   FontWeight="{x:Bind IsPlaying, Mode=OneWay, Converter={StaticResource PlayingFontWeight}}"
                                                                                   TextTrimming="CharacterEllipsis" VerticalAlignment="Center"/>

                                                                        <!-- Duration -->
                                                                        <TextBlock Grid.Column="2" Text="{x:Bind DurationFormatted}"
                                                                                   FontSize="11" Foreground="{ThemeResource TextTertiaryBrush}"
                                                                                   HorizontalAlignment="Right" VerticalAlignment="Center" Margin="0,0,2,0"/>
                                                                    </Grid>
                                                                </Button>
                                                            </DataTemplate>
                                                        </ItemsControl.ItemTemplate>
                                                    </ItemsControl>

                                                    <!-- Right Column Track List -->
                                                    <ItemsControl Grid.Column="1"
                                                                  ItemsSource="{x:Bind RightTracks, Mode=OneWay}">
                                                        <ItemsControl.ItemTemplate>
                                                            <DataTemplate x:DataType="lib:AlbumTrackItemVm">
                                                                <Button Style="{StaticResource TrackRowButtonStyle}"
                                                                        DoubleTapped="OnDrawerTrackDoubleTapped"
                                                                        KeyDown="OnDrawerTrackKeyDown">
                                                                    <Button.ContextFlyout>
                                                                        <MenuFlyout Opening="OnDrawerTrackMenuOpening">
                                                                            <MenuFlyoutItem x:Uid="Library_TrackMenu_Play" Text="재생" Click="OnDrawerTrackPlaySelected">
                                                                                <MenuFlyoutItem.Icon><FontIcon Glyph="&#xE768;"/></MenuFlyoutItem.Icon>
                                                                            </MenuFlyoutItem>
                                                                            <MenuFlyoutItem x:Uid="Library_TrackMenu_AddToPlaylist" Text="현재 재생목록에 추가" Click="OnDrawerTrackAddToPlaylist">
                                                                                <MenuFlyoutItem.Icon><FontIcon Glyph="&#xE710;"/></MenuFlyoutItem.Icon>
                                                                            </MenuFlyoutItem>
                                                                            <MenuFlyoutSubItem x:Uid="Library_TrackMenu_SendToPlaylist" Tag="SendToPlaylist" Text="특정 재생목록에 추가">
                                                                                <MenuFlyoutSubItem.Icon><FontIcon Glyph="&#xE8B9;"/></MenuFlyoutSubItem.Icon>
                                                                            </MenuFlyoutSubItem>
                                                                            <MenuFlyoutItem x:Uid="Library_TrackMenu_Enqueue" Text="대기열에 추가" Click="OnDrawerTrackEnqueue">
                                                                                <MenuFlyoutItem.Icon><FontIcon Glyph="&#xE8FD;"/></MenuFlyoutItem.Icon>
                                                                            </MenuFlyoutItem>
                                                                            <MenuFlyoutSeparator/>
                                                                            <MenuFlyoutItem x:Uid="Library_TrackMenu_ShowInExplorer" Text="탐색기에서 보기" Click="OnDrawerTrackShowInExplorer">
                                                                                <MenuFlyoutItem.Icon><FontIcon Glyph="&#xE838;"/></MenuFlyoutItem.Icon>
                                                                            </MenuFlyoutItem>
                                                                        </MenuFlyout>
                                                                    </Button.ContextFlyout>
                                                                    <Grid ColumnSpacing="6" Padding="2,1">
                                                                        <Grid.ColumnDefinitions>
                                                                            <ColumnDefinition Width="32"/>
                                                                            <ColumnDefinition Width="*"/>
                                                                            <ColumnDefinition Width="Auto"/>
                                                                        </Grid.ColumnDefinitions>

                                                                        <!-- Track No / Playing Speaker Icon -->
                                                                        <Grid Grid.Column="0" VerticalAlignment="Center">
                                                                            <TextBlock Text="{x:Bind TrackNoFormatted}"
                                                                                       Visibility="{x:Bind IsPlaying, Mode=OneWay, Converter={StaticResource NotPlayingVis}}"
                                                                                       FontSize="{StaticResource FontBodySmall}" FontStyle="Italic" Foreground="{ThemeResource TextTertiaryBrush}"/>
                                                                            <FontIcon Glyph="&#xE767;" FontSize="11"
                                                                                       Foreground="{ThemeResource DawnAccentTextBrush}"
                                                                                       Visibility="{x:Bind IsPlaying, Mode=OneWay, Converter={StaticResource BoolToVis}}"/>
                                                                        </Grid>

                                                                        <!-- Title -->
                                                                        <TextBlock Grid.Column="1" Text="{x:Bind Title}"
                                                                                   FontSize="{StaticResource FontBodySmall}"
                                                                                   Foreground="{x:Bind IsPlaying, Mode=OneWay, Converter={StaticResource PlayingBrush}}"
                                                                                   FontWeight="{x:Bind IsPlaying, Mode=OneWay, Converter={StaticResource PlayingFontWeight}}"
                                                                                   TextTrimming="CharacterEllipsis" VerticalAlignment="Center"/>

                                                                        <!-- Duration -->
                                                                        <TextBlock Grid.Column="2" Text="{x:Bind DurationFormatted}"
                                                                                   FontSize="11" Foreground="{ThemeResource TextTertiaryBrush}"
                                                                                   HorizontalAlignment="Right" VerticalAlignment="Center" Margin="0,0,2,0"/>
                                                                    </Grid>
                                                                </Button>
                                                            </DataTemplate>
                                                        </ItemsControl.ItemTemplate>
                                                    </ItemsControl>
                                                </Grid>
                                            </Grid>
                                        </Border>
                                    </StackPanel>
                                </DataTemplate>
                            </ItemsRepeater.ItemTemplate>
                        </ItemsRepeater>
                    </ScrollViewer>
                </Grid>

                <!-- PT2-07: central empty state — "library is empty" and "search found nothing"
                     are different situations and used to share one misleading status line. -->
                <StackPanel x:Name="LibraryEmptyState" HorizontalAlignment="Center" VerticalAlignment="Center"
                            Spacing="8" Visibility="Collapsed">
                    <FontIcon Glyph="&#xE8B9;" FontSize="28" Foreground="{ThemeResource TextTertiaryBrush}"
                              HorizontalAlignment="Center"/>
                    <TextBlock x:Name="LibraryEmptyTitle" Text="" FontSize="14" FontWeight="SemiBold"
                               Foreground="{ThemeResource TextPrimaryBrush}" TextAlignment="Center"
                               TextWrapping="Wrap" MaxWidth="380"/>
                    <TextBlock x:Name="LibraryEmptyHint" Text="" FontSize="12"
                               Foreground="{ThemeResource TextSecondaryBrush}" TextAlignment="Center"
                               TextWrapping="Wrap" MaxWidth="380"/>
                    <StackPanel Orientation="Horizontal" Spacing="8" HorizontalAlignment="Center">
                        <Button x:Name="LibraryEmptySettingsButton" Click="OnEmptyOpenSettingsClick" Padding="14,6" CornerRadius="4"
                                Visibility="Collapsed">
                            <TextBlock x:Uid="Library_Empty_OpenSettings" Text="설정 열기" FontSize="12"/>
                        </Button>
                        <Button x:Name="LibraryEmptyClearSearchButton" Click="OnEmptyClearSearchClick" Padding="14,6" CornerRadius="4"
                                Visibility="Collapsed">
                            <TextBlock x:Uid="Library_Empty_ClearSearch" Text="검색 지우기" FontSize="12"/>
                        </Button>
                    </StackPanel>
                </StackPanel>

                <!-- B: Track List View (Alternative) -->
                <Grid x:Name="TrackListViewContainer" Visibility="Collapsed">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="*"/>
                    </Grid.RowDefinitions>

                    <Grid Grid.Row="0" Padding="14,4,14,6" BorderBrush="{ThemeResource SeparatorSubtleBrush}" BorderThickness="0,0,0,1">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="38"/>
                            <ColumnDefinition Width="2*"/>
                            <ColumnDefinition Width="1.3*"/>
                            <ColumnDefinition Width="1.7*"/>
                            <ColumnDefinition Width="Auto"/>
                            <ColumnDefinition Width="58"/>
                        </Grid.ColumnDefinitions>

                        <Button Grid.Column="0" Style="{StaticResource ColumnHeaderButton}" Click="OnSortByTrackNo">
                            <TextBlock x:Uid="Library_Header_TrackNo" x:Name="HeaderTrackNo" Text="#" Style="{StaticResource ColumnHeaderText}"/>
                        </Button>
                        <Button Grid.Column="1" Style="{StaticResource ColumnHeaderButton}" Click="OnSortByTitle">
                            <TextBlock x:Uid="Library_Header_Title" x:Name="HeaderTitle" Text="제목" Style="{StaticResource ColumnHeaderText}"/>
                        </Button>
                        <Button Grid.Column="2" Style="{StaticResource ColumnHeaderButton}" Click="OnSortByArtist">
                            <TextBlock x:Uid="Library_Header_Artist" x:Name="HeaderArtist" Text="아티스트" Style="{StaticResource ColumnHeaderText}"/>
                        </Button>
                        <Button Grid.Column="3" Style="{StaticResource ColumnHeaderButton}" Click="OnSortByAlbum">
                            <TextBlock x:Uid="Library_Header_Album" x:Name="HeaderAlbum" Text="앨범" Style="{StaticResource ColumnHeaderText}"/>
                        </Button>
                        <Button Grid.Column="4" Style="{StaticResource ColumnHeaderButton}" Click="OnSortByRating">
                            <TextBlock x:Uid="Library_Header_Rating" x:Name="HeaderRating" Text="평점" Style="{StaticResource ColumnHeaderText}"/>
                        </Button>
                        <Button Grid.Column="5" Style="{StaticResource ColumnHeaderButton}" Click="OnSortByDuration">
                            <TextBlock x:Uid="Library_Header_Duration" x:Name="HeaderDuration" Text="길이" Style="{StaticResource ColumnHeaderText}" HorizontalAlignment="Right"/>
                        </Button>
                    </Grid>

                    <ListView x:Name="TracksList" Grid.Row="1" SelectionMode="Extended"
                              DoubleTapped="OnTrackDoubleTapped"
                              KeyDown="OnTracksListKeyDown"
                              RightTapped="OnTracksListRightTapped"
                              ContextRequested="OnTracksListContextRequested"
                              Padding="8,4,8,20">
                        <ListView.ItemContainerStyle>
                            <Style TargetType="ListViewItem">
                                <Setter Property="HorizontalContentAlignment" Value="Stretch"/>
                                <Setter Property="Padding" Value="8,3"/>
                                <Setter Property="MinHeight" Value="28"/>
                                <Setter Property="CornerRadius" Value="4"/>
                                <Setter Property="Margin" Value="0,1"/>
                            </Style>
                        </ListView.ItemContainerStyle>
                        <ListView.ItemTemplate>
                            <DataTemplate x:DataType="core:Track">
                                <Grid ColumnSpacing="8">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="38"/>
                                        <ColumnDefinition Width="2*"/>
                                        <ColumnDefinition Width="1.3*"/>
                                        <ColumnDefinition Width="1.7*"/>
                                        <ColumnDefinition Width="Auto"/>
                                        <ColumnDefinition Width="58"/>
                                    </Grid.ColumnDefinitions>
                                    <!-- PT2-10: identity (title) realizes at phase 0; the rest —
                                         converters, the rating stars, layout-heavy cells — defer to
                                         phase 1 so fast panning paints titles first. Valid here
                                         because TracksList is a ListView (phases ride on its
                                         ContainerContentChanging; the ItemsRepeater album grid
                                         above has no such callback and must not use x:Phase). -->
                                    <TextBlock Grid.Column="0" Text="{x:Bind TrackNo, Converter={StaticResource TrackNoText}}" Style="{StaticResource TrackNumText}" x:Phase="1"/>
                                    <TextBlock Grid.Column="1" Text="{x:Bind Title}" Style="{StaticResource TrackTitleText}"/>
                                    <TextBlock Grid.Column="2" Text="{x:Bind Artist}" Style="{StaticResource TrackDimText}" x:Phase="1"/>
                                    <TextBlock Grid.Column="3" Text="{x:Bind Album}" Style="{StaticResource TrackDimText}" x:Phase="1"/>
                                    <!-- Star Rating cell (L11): click opens the shared rating flyout.
                                         Track has no INPC — x:Bind re-binds when the container re-realizes. -->
                                    <Button Grid.Column="4" x:Uid="Rating_Cell" Style="{StaticResource RatingCellButton}"
                                            Tag="{x:Bind}" Click="OnLibraryRatingCellClick"
                                            AutomationProperties.Name="{x:Bind Rating, Converter={StaticResource RatingAccess}}"
                                            x:Phase="1">
                                        <TextBlock Text="{x:Bind Rating, Converter={StaticResource RatingStars}}"
                                                   FontSize="{StaticResource FontCaption}" Foreground="{ThemeResource DawnAccentTextBrush}"
                                                   VerticalAlignment="Center"/>
                                    </Button>
                                    <TextBlock Grid.Column="5" Text="{x:Bind Duration, Converter={StaticResource TimeSpanText}}"
                                               Style="{StaticResource TrackDurationText}" x:Phase="1"/>
                                </Grid>
                            </DataTemplate>
                        </ListView.ItemTemplate>
                        <ListView.ContextFlyout>
                            <MenuFlyout Opening="OnTrackMenuOpening">
                                <MenuFlyoutItem x:Uid="Library_TrackMenu_Play" Text="재생" Click="OnPlaySelected">
                                    <MenuFlyoutItem.Icon>
                                        <FontIcon Glyph="&#xE768;"/>
                                    </MenuFlyoutItem.Icon>
                                </MenuFlyoutItem>
                                <MenuFlyoutItem x:Uid="Library_TrackMenu_AddToPlaylist" Text="현재 재생목록에 추가" Click="OnAddSelectedToPlaylist">
                                    <MenuFlyoutItem.Icon>
                                        <FontIcon Glyph="&#xE710;"/>
                                    </MenuFlyoutItem.Icon>
                                </MenuFlyoutItem>
                                <MenuFlyoutSubItem x:Uid="Library_TrackMenu_SendToPlaylist" x:Name="TrackSendToPlaylistSubMenu" Text="특정 재생목록에 추가">
                                    <MenuFlyoutSubItem.Icon>
                                        <FontIcon Glyph="&#xE8B9;"/>
                                    </MenuFlyoutSubItem.Icon>
                                </MenuFlyoutSubItem>
                                <MenuFlyoutItem x:Uid="Library_TrackMenu_Enqueue" Text="대기열에 추가" Click="OnQueueSelected">
                                    <MenuFlyoutItem.Icon>
                                        <FontIcon Glyph="&#xE8FD;"/>
                                    </MenuFlyoutItem.Icon>
                                </MenuFlyoutItem>
                                <MenuFlyoutItem x:Uid="Library_TrackMenu_EditTags" Text="태그 편집…" Click="OnEditTrackTags">
                                    <MenuFlyoutItem.Icon>
                                        <FontIcon Glyph="&#xE70F;"/>
                                    </MenuFlyoutItem.Icon>
                                </MenuFlyoutItem>
                                <MenuFlyoutSubItem x:Uid="Playlist_TrackMenu_Rating" Text="평점">
                                    <MenuFlyoutSubItem.Icon>
                                        <FontIcon Glyph="&#xE735;"/>
                                    </MenuFlyoutSubItem.Icon>
                                    <MenuFlyoutItem x:Uid="Playlist_TrackMenu_Rate1" Text="★" Click="OnRateSelected1"/>
                                    <MenuFlyoutItem x:Uid="Playlist_TrackMenu_Rate2" Text="★★" Click="OnRateSelected2"/>
                                    <MenuFlyoutItem x:Uid="Playlist_TrackMenu_Rate3" Text="★★★" Click="OnRateSelected3"/>
                                    <MenuFlyoutItem x:Uid="Playlist_TrackMenu_Rate4" Text="★★★★" Click="OnRateSelected4"/>
                                    <MenuFlyoutItem x:Uid="Playlist_TrackMenu_Rate5" Text="★★★★★" Click="OnRateSelected5"/>
                                    <MenuFlyoutSeparator/>
                                    <MenuFlyoutItem x:Uid="Playlist_TrackMenu_Unrate" Text="평점 없음" Click="OnUnrateSelected"/>
                                </MenuFlyoutSubItem>
                                <MenuFlyoutSeparator/>
                                <MenuFlyoutItem x:Uid="Library_TrackMenu_ShowInExplorer" Text="탐색기에서 보기" Click="OnShowInExplorer">
                                    <MenuFlyoutItem.Icon>
                                        <FontIcon Glyph="&#xE838;"/>
                                    </MenuFlyoutItem.Icon>
                                </MenuFlyoutItem>
                            </MenuFlyout>
                        </ListView.ContextFlyout>
                    </ListView>
                </Grid>
            </Grid>
        </Grid>

        <!-- [Panel 2.5] Lyrics Sidebar Panel (Left of Right Panel, Resizable) -->
        <Grid x:Name="LyricsPanelContainer" Grid.Column="2" Visibility="Collapsed">
            <controls:LyricsPane x:Name="LibraryLyricsPane" Width="300"/>
            <Border x:Name="LyricsSplitter" HorizontalAlignment="Left" Width="8" Margin="-4,0,0,0"
                    Background="Transparent" Canvas.ZIndex="20"
                    PointerEntered="OnSplitterPointerEntered" PointerExited="OnSplitterPointerExited"
                    PointerPressed="OnLyricsSplitterPressed" PointerMoved="OnLyricsSplitterMoved" PointerReleased="OnLyricsSplitterReleased">
                <Rectangle x:Name="LyricsSplitterLine" Width="2" HorizontalAlignment="Center" Fill="Transparent"/>
            </Border>
        </Grid>

        <!-- [Panel 3] Right Panel: Eole Now Playing / Playback Queue Sidebar (Playing tracks...) -->
        <Grid Grid.Column="3" Background="{ThemeResource PanelSubtleBrush}"
              BorderBrush="{ThemeResource SeparatorSubtleBrush}" BorderThickness="1,0,0,0">
            <Grid.RowDefinitions>
                <!-- Top Header: 🔍 Playing tracks... + Items count -->
                <RowDefinition Height="38"/>
                <!-- Grouped Tracks List with Album Headers -->
                <RowDefinition Height="*"/>
            </Grid.RowDefinitions>

            <!-- Right Splitter Grip -->
            <Border x:Name="RightSplitter" Grid.RowSpan="2" HorizontalAlignment="Left" Width="8" Margin="-4,0,0,0"
                    Background="Transparent" Canvas.ZIndex="20"
                    PointerEntered="OnSplitterPointerEntered" PointerExited="OnSplitterPointerExited"
                    PointerPressed="OnRightSplitterPressed" PointerMoved="OnRightSplitterMoved" PointerReleased="OnRightSplitterReleased">
                <Rectangle x:Name="RightSplitterLine" Width="2" HorizontalAlignment="Center" Fill="Transparent"/>
            </Border>

            <!-- Top Header: 🔍 Playing tracks... + Count -->
            <Grid Grid.Row="0" Padding="14,0,14,0" Background="Transparent">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>

                <FontIcon Grid.Column="0" Glyph="&#xE721;" FontSize="{StaticResource FontBodySmall}" Foreground="{ThemeResource TextTertiaryBrush}" Margin="0,0,8,0"/>
                <TextBlock x:Uid="Library_RightQueue_Title" Grid.Column="1" Text="Playing tracks..." FontSize="12"
                           Foreground="{ThemeResource TextSecondaryBrush}" VerticalAlignment="Center" TextTrimming="CharacterEllipsis"/>
                <TextBlock Grid.Column="2" x:Name="RightQueueStatsText" Text="0 items" FontSize="11"
                           Foreground="{ThemeResource TextTertiaryBrush}" VerticalAlignment="Center"/>
            </Grid>

            <!-- Hairline Divider -->
            <Border Grid.Row="0" Height="1" VerticalAlignment="Bottom" Background="{ThemeResource BorderSubtleBrush}"/>

            <!-- Grouped Playback Queue List (Multiple Albums + Tracks) -->
            <ListView x:Name="RightQueueList" Grid.Row="1"
                      ItemsSource="{x:Bind RightQueueCvs.View, Mode=OneWay}"
                      SelectionMode="Single"
                      DoubleTapped="OnRightQueueTrackDoubleTapped"
                      Padding="10,4,10,16">
                <ListView.ItemContainerStyle>
                    <Style TargetType="ListViewItem">
                        <Setter Property="HorizontalContentAlignment" Value="Stretch"/>
                        <Setter Property="Padding" Value="2,1"/>
                        <Setter Property="MinHeight" Value="{ThemeResource TrackRowMinHeight}"/>
                        <Setter Property="CornerRadius" Value="3"/>
                        <Setter Property="Margin" Value="0,0.5"/>
                    </Style>
                </ListView.ItemContainerStyle>

                <!-- Track Row Template (Eole Flat Style with Playing Highlight Box) -->
                <ListView.ItemTemplate>
                    <DataTemplate x:DataType="core:PlaylistItem">
                        <Grid Margin="0,0.5" MinHeight="{ThemeResource TrackRowMinHeight}">
                            <!-- Normal Track Row (when not playing) -->
                            <Grid Height="{ThemeResource TrackRowMinHeight}" Padding="2,0" ColumnSpacing="6"
                                  Visibility="{x:Bind IsPlaying, Converter={StaticResource NotPlayingVis}, Mode=OneWay}">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="22"/>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="Auto"/>
                                </Grid.ColumnDefinitions>

                                <!-- Italic Track No -->
                                <TextBlock Grid.Column="0" Text="{x:Bind Track.TrackNo, Converter={StaticResource TrackNoText}}"
                                           FontStyle="Italic" FontSize="11" Foreground="{ThemeResource TextTertiaryBrush}"
                                           VerticalAlignment="Center"/>

                                <!-- Track Title -->
                                <TextBlock Grid.Column="1" Text="{x:Bind Track.Title}" FontSize="{StaticResource FontBodySmall}"
                                           Foreground="{ThemeResource TextPrimaryBrush}"
                                           TextTrimming="CharacterEllipsis" VerticalAlignment="Center"/>

                                <!-- Static Duration -->
                                <TextBlock Grid.Column="2" Text="{x:Bind DurationDisplay, Mode=OneWay}"
                                           FontSize="11" Foreground="{ThemeResource TextTertiaryBrush}"
                                           HorizontalAlignment="Right" VerticalAlignment="Center" Margin="0,0,2,0"/>
                            </Grid>

                            <!-- Eole Active Playing Highlight Box (when playing) -->
                            <Border Height="28" CornerRadius="3"
                                    Background="{ThemeResource DawnAccentMutedBrush}" BorderBrush="{ThemeResource DawnAccentGlowBrush}" BorderThickness="1"
                                    Visibility="{x:Bind IsPlaying, Converter={StaticResource PlayingVis}, Mode=OneWay}">
                                <Grid ColumnSpacing="6" Padding="0,0,6,0">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="24"/>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="Auto"/>
                                    </Grid.ColumnDefinitions>

                                    <!-- Left Amber Accent Line -->
                                    <Border Grid.Column="0" Width="3" HorizontalAlignment="Left"
                                            Background="{ThemeResource DawnAccentBrush}" VerticalAlignment="Stretch"/>

                                    <!-- Speaker Icon -->
                                    <FontIcon Grid.Column="0" Glyph="&#xE767;" FontSize="11"
                                              Foreground="{ThemeResource DawnAccentTextBrush}"
                                              HorizontalAlignment="Center" VerticalAlignment="Center"/>

                                    <!-- Track Title (White, SemiBold) -->
                                    <TextBlock Grid.Column="1" Text="{x:Bind Track.Title}" FontSize="{StaticResource FontBodySmall}"
                                               FontWeight="SemiBold" Foreground="{ThemeResource TextPrimaryBrush}"
                                               TextTrimming="CharacterEllipsis" VerticalAlignment="Center"/>

                                    <!-- Dynamic Remaining Time (e.g. -3:40) -->
                                    <TextBlock Grid.Column="2" Text="{x:Bind DurationDisplay, Mode=OneWay}"
                                               FontSize="11" Foreground="{ThemeResource TextSecondaryBrush}"
                                               HorizontalAlignment="Right" VerticalAlignment="Center"/>
                                </Grid>
                            </Border>
                        </Grid>
                    </DataTemplate>
                </ListView.ItemTemplate>

                <!-- Album Group Header Template (48x48 Art + 2-line info matching screenshot) -->
                <ListView.GroupStyle>
                    <GroupStyle>
                        <GroupStyle.HeaderTemplate>
                            <DataTemplate>
                                <Grid Margin="0,12,0,4" Padding="2,2" Background="Transparent" ColumnSpacing="10">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="48"/>
                                        <ColumnDefinition Width="*"/>
                                    </Grid.ColumnDefinitions>

                                    <!-- 48x48 Album Art Thumbnail -->
                                    <Border Grid.Column="0" Width="48" Height="48" CornerRadius="4"
                                            Background="{ThemeResource PanelBrush}"
                                            BorderBrush="{ThemeResource BorderSubtleBrush}" BorderThickness="1">
                                        <Grid>
                                            <FontIcon Glyph="&#xE90B;" FontSize="18" Foreground="{ThemeResource TextTertiaryBrush}"/>
                                            <Border CornerRadius="3">
                                                <Image Source="{Binding Art}" Stretch="UniformToFill"/>
                                            </Border>
                                        </Grid>
                                    </Border>

                                    <!-- 2-Line Metadata: Line 1 (Italic Album + Duration), Line 2 (Artist + Year) -->
                                    <Grid Grid.Column="1" VerticalAlignment="Center" RowSpacing="2">
                                        <Grid.RowDefinitions>
                                            <RowDefinition Height="Auto"/>
                                            <RowDefinition Height="Auto"/>
                                        </Grid.RowDefinitions>

                                        <Grid Grid.Row="0">
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="*"/>
                                                <ColumnDefinition Width="Auto"/>
                                            </Grid.ColumnDefinitions>
                                            <TextBlock Text="{Binding Album}" FontSize="{StaticResource FontBody}" FontWeight="SemiBold" FontStyle="Italic"
                                                       Foreground="{ThemeResource TextPrimaryBrush}" TextTrimming="CharacterEllipsis"/>
                                            <TextBlock Grid.Column="1" Text="{Binding DurationFormatted}" FontSize="11"
                                                       Foreground="{ThemeResource TextTertiaryBrush}" HorizontalAlignment="Right" Margin="4,0,2,0"/>
                                        </Grid>

                                        <Grid Grid.Row="1">
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="*"/>
                                                <ColumnDefinition Width="Auto"/>
                                            </Grid.ColumnDefinitions>
                                            <TextBlock Text="{Binding Artist}" FontSize="{StaticResource FontBodySmall}"
                                                       Foreground="{ThemeResource TextSecondaryBrush}" TextTrimming="CharacterEllipsis"/>
                                            <TextBlock Grid.Column="1" Text="{Binding YearFormatted}" FontSize="11"
                                                       Foreground="{ThemeResource TextTertiaryBrush}" HorizontalAlignment="Right" Margin="4,0,2,0"/>
                                        </Grid>
                                    </Grid>
                                </Grid>
                            </DataTemplate>
                        </GroupStyle.HeaderTemplate>
                    </GroupStyle>
                </ListView.GroupStyle>
            </ListView>
        </Grid>
    </Grid>
</Page>

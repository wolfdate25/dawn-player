<?xml version="1.0" encoding="utf-8"?>
<Window
    x:Class="DawnPlayer.App.Views.LyricsSearchWindow"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:local="using:DawnPlayer.App.Views"
    x:Uid="LyricsSearch_Window"
    Title="온라인 가사 검색 — Dawn Player">

    <Grid Background="{ThemeResource ApplicationPageBackgroundThemeBrush}" Padding="20">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <!-- 1. Header -->
        <Grid Grid.Row="0" Margin="0,0,0,12">
            <StackPanel Orientation="Horizontal" Spacing="8">
                <FontIcon Glyph="&#xE721;" FontSize="16" Foreground="{ThemeResource DawnAccentBrush}"/>
                <TextBlock x:Name="TrackHeaderTitle" x:Uid="LyricsSearch_TrackHeaderTitle" Text="곡 제목" FontSize="15" FontWeight="SemiBold"
                           Foreground="{ThemeResource TextPrimaryBrush}" VerticalAlignment="Center"/>
                <TextBlock x:Name="TrackHeaderArtist" x:Uid="LyricsSearch_TrackHeaderArtist" Text="— 아티스트" FontSize="13"
                           Foreground="{ThemeResource TextSecondaryBrush}" VerticalAlignment="Center"/>
            </StackPanel>
        </Grid>

        <!-- 2. Search form + results | preview -->
        <Grid Grid.Row="1" ColumnSpacing="14">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="400"/>
                <ColumnDefinition Width="*"/>
            </Grid.ColumnDefinitions>

            <!-- Left: form + results -->
            <Grid Grid.Column="0" RowSpacing="8">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="*"/>
                </Grid.RowDefinitions>

                <TextBox x:Name="TitleBox" x:Uid="LyricsSearch_TitleBox" Grid.Row="0" Header="제목" PlaceholderText="제목"/>
                <TextBox x:Name="ArtistBox" x:Uid="LyricsSearch_ArtistBox" Grid.Row="1" Header="아티스트" PlaceholderText="아티스트"/>
                <TextBox x:Name="AlbumBox" x:Uid="LyricsSearch_AlbumBox" Grid.Row="2" Header="앨범 (제목·아티스트 없이 앨범명만으로 검색)" PlaceholderText="앨범"/>
                <Button x:Name="SearchButton" x:Uid="LyricsSearch_SearchButton" Grid.Row="3" Content="검색" Style="{StaticResource AccentButtonStyle}"
                        Click="OnSearchClick" HorizontalAlignment="Stretch"/>

                <Grid Grid.Row="4">
                    <TextBlock x:Name="StatusText" Text="" FontSize="11.5" Foreground="{ThemeResource TextTertiaryBrush}"
                               TextWrapping="Wrap" VerticalAlignment="Top" Margin="0,2,0,8"/>
                    <ListView x:Name="ResultsList" SelectionMode="Single" SelectionChanged="OnResultSelectionChanged">
                        <ListView.ItemContainerStyle>
                            <Style TargetType="ListViewItem">
                                <Setter Property="HorizontalContentAlignment" Value="Stretch"/>
                                <Setter Property="Padding" Value="8,6"/>
                                <Setter Property="Margin" Value="0,1"/>
                                <Setter Property="CornerRadius" Value="6"/>
                            </Style>
                        </ListView.ItemContainerStyle>
                        <ListView.ItemTemplate>
                            <DataTemplate x:DataType="local:LyricsResultItemVm">
                                <Grid ColumnSpacing="8">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="Auto"/>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="Auto"/>
                                    </Grid.ColumnDefinitions>
                                    <Border Grid.Column="0" Background="{ThemeResource BadgeBgBrush}" CornerRadius="4"
                                            Padding="6,2" VerticalAlignment="Center">
                                        <TextBlock Text="{x:Bind PluginName}" FontSize="10" FontWeight="SemiBold"
                                                   Foreground="{ThemeResource DawnAccentBrush}"/>
                                    </Border>
                                    <StackPanel Grid.Column="1" VerticalAlignment="Center">
                                        <TextBlock Text="{x:Bind Title}" FontSize="12.5" TextTrimming="CharacterEllipsis"/>
                                        <TextBlock Text="{x:Bind Subtitle}" FontSize="11"
                                                   Foreground="{ThemeResource TextTertiaryBrush}" TextTrimming="CharacterEllipsis"/>
                                    </StackPanel>
                                    <StackPanel Grid.Column="2" VerticalAlignment="Center" Spacing="2">
                                        <TextBlock Text="{x:Bind SyncLabel}" FontSize="10"
                                                   Foreground="{ThemeResource TextSecondaryBrush}" HorizontalAlignment="Right"/>
                                        <TextBlock Text="{x:Bind DurationLabel}" FontSize="10"
                                                   Foreground="{ThemeResource TextTertiaryBrush}" HorizontalAlignment="Right"/>
                                    </StackPanel>
                                </Grid>
                            </DataTemplate>
                        </ListView.ItemTemplate>
                    </ListView>
                </Grid>
            </Grid>

            <!-- Right: preview + actions -->
            <Grid Grid.Column="1" RowSpacing="10">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="*"/>
                    <RowDefinition Height="Auto"/>
                </Grid.RowDefinitions>

                <TextBlock x:Uid="LyricsSearch_PreviewHeader" Grid.Row="0" Text="미리보기 (선택하면 불러옵니다)" FontSize="12.5" FontWeight="SemiBold"
                           Foreground="{ThemeResource TextSecondaryBrush}"/>

                <Border Grid.Row="1" Background="{ThemeResource PanelBrush}" BorderBrush="{ThemeResource BorderSubtleBrush}"
                        BorderThickness="1" CornerRadius="8" Padding="12">
                    <ScrollViewer VerticalScrollBarVisibility="Auto">
                        <TextBlock x:Name="PreviewText" x:Uid="LyricsSearch_PreviewText" Text="왼쪽에서 검색 결과를 선택하세요." FontSize="11.5" FontFamily="Consolas"
                                   Foreground="{ThemeResource TextSecondaryBrush}" TextWrapping="Wrap" IsTextSelectionEnabled="True"/>
                    </ScrollViewer>
                </Border>

                <StackPanel Grid.Row="2" Orientation="Horizontal" Spacing="8" HorizontalAlignment="Right">
                    <Button x:Name="ApplyButton" x:Uid="LyricsSearch_ApplyButton" Content="현재 곡에 적용" Click="OnApplyClick" IsEnabled="False"/>
                    <Button x:Name="SaveButton" x:Uid="LyricsSearch_SaveButton" Content="파일로 저장" Click="OnSaveClick" IsEnabled="False"
                            ToolTipService.ToolTip="설정된 저장 위치와 파일명 템플릿으로 저장합니다"/>
                </StackPanel>
            </Grid>
        </Grid>
    </Grid>
</Window>

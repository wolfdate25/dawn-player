<?xml version="1.0" encoding="utf-8"?>
<Window
    x:Class="DawnPlayer.App.Views.LyricsEditorWindow"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:local="using:DawnPlayer.App.Views">

    <Grid Background="{ThemeResource ApplicationPageBackgroundThemeBrush}" Padding="20">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <!-- 1. Header: Track & File Info -->
        <Grid Grid.Row="0" Margin="0,0,0,14">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="Auto"/>
            </Grid.ColumnDefinitions>

            <StackPanel Spacing="3">
                <StackPanel Orientation="Horizontal" Spacing="8" VerticalAlignment="Center">
                    <FontIcon Glyph="&#xE7E7;" FontSize="{StaticResource FontTitle}" Foreground="{ThemeResource DawnAccentTextBrush}"/>
                    <TextBlock x:Name="TrackHeaderTitle" x:Uid="LyricsEditor_TrackHeaderTitle" Text="곡 제목" FontSize="{StaticResource FontTitle}" FontWeight="SemiBold"
                               Foreground="{ThemeResource TextPrimaryBrush}"/>
                    <TextBlock x:Name="TrackHeaderArtist" x:Uid="LyricsEditor_TrackHeaderArtist" Text="— 아티스트" FontSize="{StaticResource FontSubtitle}"
                               Foreground="{ThemeResource TextSecondaryBrush}" VerticalAlignment="Center"/>
                </StackPanel>
                <TextBlock x:Name="FilePathLabel" Text="C:\Music\..." FontSize="{StaticResource FontBodySmall}"
                           Foreground="{ThemeResource TextTertiaryBrush}" TextTrimming="CharacterEllipsis"/>
            </StackPanel>

            <StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="8" VerticalAlignment="Center">
                <Button x:Name="PlayPauseBtn" x:Uid="LyricsEditor_PlayPauseBtn" Style="{StaticResource TransportButton}" Click="OnPlayPauseClick" ToolTipService.ToolTip="재생/일시정지 (Space)">
                    <FontIcon x:Name="PlayPauseIcon" Glyph="&#xE768;" FontSize="{StaticResource FontBody}"/>
                </Button>
                <TextBlock x:Name="PositionText" Text="0:00.000" FontSize="{StaticResource FontBody}" FontWeight="SemiBold"
                           Foreground="{ThemeResource DawnAccentTextBrush}" VerticalAlignment="Center" Width="72" TextAlignment="Right"/>
            </StackPanel>
        </Grid>

        <!-- 2. Offset Variable Step Controller -->
        <Border Grid.Row="1" Background="{ThemeResource PanelBrush}" BorderBrush="{ThemeResource BorderSubtleBrush}"
                BorderThickness="1" CornerRadius="8" Padding="14,10" Margin="0,0,0,14">
            <Grid RowSpacing="8">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                </Grid.RowDefinitions>

                <!-- Row 1: Step Delta Setting & Presets -->
                <Grid Grid.Row="0">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="*"/>
                    </Grid.ColumnDefinitions>

                    <StackPanel Orientation="Horizontal" Spacing="8" VerticalAlignment="Center">
                        <TextBlock x:Uid="LyricsEditor_StepDeltaLabel" Text="조절 스텝 단위:" FontSize="{StaticResource FontBodySmall}" FontWeight="SemiBold"
                                   Foreground="{ThemeResource TextPrimaryBrush}" VerticalAlignment="Center"/>
                        <NumberBox x:Name="StepDeltaBox" Width="90" Value="500" Minimum="1" Maximum="5000"
                                   SmallChange="10" LargeChange="100" SpinButtonPlacementMode="Compact"
                                   ValueChanged="OnStepDeltaValueChanged"/>
                        <TextBlock Text="ms" FontSize="{StaticResource FontBodySmall}" Foreground="{ThemeResource TextSecondaryBrush}" VerticalAlignment="Center"/>
                    </StackPanel>

                    <StackPanel Grid.Column="2" Orientation="Horizontal" Spacing="4" HorizontalAlignment="Right">
                        <TextBlock x:Uid="LyricsEditor_StepPresetsLabel" Text="스텝 프리셋:" FontSize="{StaticResource FontBodySmall}" Foreground="{ThemeResource TextTertiaryBrush}" VerticalAlignment="Center" Margin="0,0,4,0"/>
                        <Button x:Uid="LyricsEditor_Preset10" Content="10ms" FontSize="{StaticResource FontCaption}" Padding="6,2" Click="OnPresetStepClick" Tag="10"/>
                        <Button x:Uid="LyricsEditor_Preset50" Content="50ms" FontSize="{StaticResource FontCaption}" Padding="6,2" Click="OnPresetStepClick" Tag="50"/>
                        <Button x:Uid="LyricsEditor_Preset100" Content="100ms" FontSize="{StaticResource FontCaption}" Padding="6,2" Click="OnPresetStepClick" Tag="100"/>
                        <Button x:Uid="LyricsEditor_Preset500" Content="500ms" FontSize="{StaticResource FontCaption}" Padding="6,2" Click="OnPresetStepClick" Tag="500"/>
                        <Button x:Uid="LyricsEditor_Preset1000" Content="1000ms" FontSize="{StaticResource FontCaption}" Padding="6,2" Click="OnPresetStepClick" Tag="1000"/>
                    </StackPanel>
                </Grid>

                <!-- Row 2: Big Adjust Buttons and Total Offset Input.
                     One horizontal StackPanel, centered — a three-column Grid here proved fragile
                     (star column collapsed and the right button vanished at wide window sizes). -->
                <StackPanel Grid.Row="1" Orientation="Horizontal" Spacing="14" HorizontalAlignment="Center" VerticalAlignment="Center">
                    <Button x:Name="StepMinusBtn" Content="◀ 가사 앞당김 0.5s" Style="{StaticResource AccentButtonStyle}"
                            Click="OnStepMinusClick" MinWidth="130" VerticalAlignment="Center" HorizontalContentAlignment="Center"/>

                    <TextBlock x:Uid="LyricsEditor_TotalOffsetLabel" Text="현재 총 오프셋:" FontSize="{StaticResource FontBody}" FontWeight="SemiBold"
                               Foreground="{ThemeResource TextPrimaryBrush}" VerticalAlignment="Center"/>
                    <NumberBox x:Name="TotalOffsetBox" Width="110" Value="0" Minimum="-3600000" Maximum="3600000"
                               SpinButtonPlacementMode="Compact" KeyDown="OnTotalOffsetBoxKeyDown" LostFocus="OnTotalOffsetBoxLostFocus" VerticalAlignment="Center"/>
                    <TextBlock Text="ms" FontSize="{StaticResource FontBodySmall}" Foreground="{ThemeResource TextSecondaryBrush}" VerticalAlignment="Center"/>
                    <TextBlock x:Name="TotalOffsetSecLabel" Text="(= 0.0000초)" FontSize="{StaticResource FontBodySmall}"
                               Foreground="{ThemeResource TextTertiaryBrush}" VerticalAlignment="Center"/>
                    <Button x:Uid="LyricsEditor_RestoreOriginalTimesBtn" Content="원본 시간으로 되돌리기" FontSize="{StaticResource FontCaption}" Click="OnRestoreOriginalTimesClick"
                            ToolTipService.ToolTip="모든 라인 시간을 불러온 시점의 원본으로 되돌립니다 (저장 전에만 의미 있음)" VerticalAlignment="Center"/>

                    <Button x:Name="StepPlusBtn" Content="가사 뒤로 미룸 0.5s ▶" Style="{StaticResource AccentButtonStyle}"
                            Click="OnStepPlusClick" MinWidth="130" VerticalAlignment="Center" HorizontalContentAlignment="Center"/>
                </StackPanel>
            </Grid>
        </Border>

        <!-- 3. Dual Editor Tabs -->
        <TabView x:Name="EditorTabs" Grid.Row="2" IsAddTabButtonVisible="False" SelectionChanged="OnEditorTabSelectionChanged">
            <TabView.TabItems>
                <!-- Tab 1: Line-by-line Sync Editor -->
                <TabViewItem x:Uid="LyricsEditor_TabSync" Header="라인별 싱크 에디터" IsClosable="False">
                    <Grid Padding="0,10,0,0">
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="*"/>
                        </Grid.RowDefinitions>

                        <!-- Line Tools -->
                        <Grid Grid.Row="0" Margin="0,0,0,8">
                            <StackPanel Orientation="Horizontal" Spacing="6">
                                <Button Click="OnStampCurrentTimeClick" Style="{StaticResource AccentButtonStyle}">
                                    <StackPanel Orientation="Horizontal" Spacing="6">
                                        <FontIcon Glyph="&#xE916;" FontSize="{StaticResource FontBodySmall}"/>
                                        <TextBlock x:Uid="LyricsEditor_StampCurrentTimeText" Text="현재 시간 스탬프 (F5)"/>
                                    </StackPanel>
                                </Button>
                                <Button Click="OnAddLineClick">
                                    <StackPanel Orientation="Horizontal" Spacing="6">
                                        <FontIcon Glyph="&#xE710;" FontSize="{StaticResource FontBodySmall}"/>
                                        <TextBlock x:Uid="LyricsEditor_AddLineText" Text="줄 추가"/>
                                    </StackPanel>
                                </Button>
                                <Button Click="OnDeleteSelectedLineClick">
                                    <StackPanel Orientation="Horizontal" Spacing="6">
                                        <FontIcon Glyph="&#xE74D;" FontSize="{StaticResource FontBodySmall}"/>
                                        <TextBlock x:Uid="LyricsEditor_DeleteLineText" Text="줄 삭제"/>
                                    </StackPanel>
                                </Button>
                                <Button x:Uid="LyricsEditor_MoveLineUpBtn" Click="OnMoveLineUpClick" ToolTipService.ToolTip="선택 줄 위로">
                                    <FontIcon Glyph="&#xE70E;" FontSize="{StaticResource FontBodySmall}"/>
                                </Button>
                                <Button x:Uid="LyricsEditor_MoveLineDownBtn" Click="OnMoveLineDownClick" ToolTipService.ToolTip="선택 줄 아래로">
                                    <FontIcon Glyph="&#xE70D;" FontSize="{StaticResource FontBodySmall}"/>
                                </Button>
                                <Button x:Uid="LyricsEditor_PasteClipboardBtn" Click="OnPasteFromClipboardClick" ToolTipService.ToolTip="클립보드에서 가사 텍스트 가져오기">
                                    <StackPanel Orientation="Horizontal" Spacing="6">
                                        <FontIcon Glyph="&#xE77F;" FontSize="{StaticResource FontBodySmall}"/>
                                        <TextBlock x:Uid="LyricsEditor_PasteClipboardText" Text="클립보드 붙여넣기"/>
                                    </StackPanel>
                                </Button>
                            </StackPanel>
                        </Grid>

                        <!-- Lines List -->
                        <ListView x:Name="LinesListView" Grid.Row="1" SelectionMode="Single"
                                  BorderBrush="{ThemeResource BorderSubtleBrush}" BorderThickness="1" CornerRadius="6">
                            <ListView.ItemTemplate>
                                <DataTemplate x:DataType="local:LrcEditLineVm">
                                    <Grid ColumnSpacing="8" Padding="4,2">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="Auto"/>
                                            <ColumnDefinition Width="80"/>
                                            <ColumnDefinition Width="*"/>
                                            <ColumnDefinition Width="Auto"/>
                                        </Grid.ColumnDefinitions>

                                        <!-- Playhead highlight: soft accent wash + left bar, driven by
                                             numeric x:Bind so theme brushes stay in XAML -->
                                        <Border Grid.Column="0" Grid.ColumnSpan="4" IsHitTestVisible="False"
                                                Background="{ThemeResource DawnAccentMutedBrush}" CornerRadius="6"
                                                Opacity="{x:Bind CurrentRowHighlightOpacity, Mode=OneWay}"/>
                                        <Border Grid.Column="0" Grid.ColumnSpan="4" IsHitTestVisible="False" HorizontalAlignment="Left"
                                                Width="{x:Bind CurrentAccentBarWidth, Mode=OneWay}" Margin="-2,0,0,0"
                                                Background="{ThemeResource DawnAccentBrush}" CornerRadius="2"/>

                                        <TextBlock Grid.Column="0" Text="{x:Bind LineNo}" Width="28" FontSize="{StaticResource FontCaption}"
                                                   Foreground="{ThemeResource TextTertiaryBrush}" VerticalAlignment="Center"/>

                                        <TextBox Grid.Column="1" Text="{x:Bind TimeString, Mode=TwoWay}" FontSize="{StaticResource FontBodySmall}"
                                                 FontFamily="Consolas, Cascadia Code" TextAlignment="Center"/>

                                        <TextBox Grid.Column="2" Text="{x:Bind Text, Mode=TwoWay}" FontSize="{StaticResource FontBody}"/>

                                        <Button x:Uid="LyricsEditor_SeekToLineBtn" Grid.Column="3" Style="{StaticResource TransportButton}" Width="28" Height="28"
                                                Click="OnSeekToLineClick" Tag="{x:Bind}" ToolTipService.ToolTip="이 위치로 오디오 재생">
                                            <FontIcon Glyph="&#xE768;" FontSize="{StaticResource FontBodySmall}"/>
                                        </Button>
                                    </Grid>
                                </DataTemplate>
                            </ListView.ItemTemplate>
                        </ListView>
                    </Grid>
                </TabViewItem>

                <!-- Tab 2: Raw Text Editor -->
                <TabViewItem x:Uid="LyricsEditor_TabRaw" Header="전체 LRC 텍스트 직접 편집" IsClosable="False">
                    <Grid Padding="0,10,0,0">
                        <TextBox x:Name="RawTextEditorBox" AcceptsReturn="True" TextWrapping="NoWrap"
                                 FontFamily="Consolas, Cascadia Code, Courier New" FontSize="{StaticResource FontBody}"
                                 ScrollViewer.HorizontalScrollBarVisibility="Auto"
                                 ScrollViewer.VerticalScrollBarVisibility="Auto"
                                 TextChanged="OnRawTextChanged"/>
                    </Grid>
                </TabViewItem>
            </TabView.TabItems>
        </TabView>

        <!-- 4. Footer: Status & Save Controls -->
        <Grid Grid.Row="3" Margin="0,14,0,0">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="Auto"/>
            </Grid.ColumnDefinitions>

            <TextBlock x:Name="StatusLabel" x:Uid="LyricsEditor_StatusLabel" Text="준비됨" FontSize="{StaticResource FontBodySmall}"
                       Foreground="{ThemeResource TextTertiaryBrush}" VerticalAlignment="Center"
                       TextTrimming="CharacterEllipsis" MaxLines="1" Margin="0,0,12,0"/>

            <StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="8">
                <Button x:Uid="LyricsEditor_CloseBtn" Content="닫기" Click="OnCloseClick" Width="80"/>
                <Button x:Uid="LyricsEditor_SaveBtn" Style="{StaticResource AccentButtonStyle}" Click="OnSaveClick" Width="150">
                    <StackPanel Orientation="Horizontal" Spacing="6">
                        <FontIcon Glyph="&#xE78C;" FontSize="{StaticResource FontBody}"/>
                        <TextBlock x:Uid="LyricsEditor_SaveBtnText" Text="LRC 파일로 저장"/>
                    </StackPanel>
                </Button>
            </StackPanel>
        </Grid>
    </Grid>
</Window>

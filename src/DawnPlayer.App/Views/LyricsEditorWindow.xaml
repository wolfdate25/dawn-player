<?xml version="1.0" encoding="utf-8"?>
<Window
    x:Class="DawnPlayer.App.Views.LyricsEditorWindow"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:local="using:DawnPlayer.App.Views"
    Title="가사 편집기 (Lyrics Editor) — Dawn Player">

    <Grid Background="{ThemeResource ApplicationPageBackgroundThemeBrush}" Padding="20">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <!-- 1. Header: Track & File Info -->
        <Grid Grid.Row="0" Margin="0,0,0,14">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="Auto"/>
            </Grid.ColumnDefinitions>

            <StackPanel Spacing="3">
                <StackPanel Orientation="Horizontal" Spacing="8" VerticalAlignment="Center">
                    <FontIcon Glyph="&#xEC4F;" FontSize="16" Foreground="{ThemeResource DawnAccentBrush}"/>
                    <TextBlock x:Name="TrackHeaderTitle" Text="곡 제목" FontSize="16" FontWeight="SemiBold"
                               Foreground="{ThemeResource TextPrimaryBrush}"/>
                    <TextBlock x:Name="TrackHeaderArtist" Text="— 아티스트" FontSize="14"
                               Foreground="{ThemeResource TextSecondaryBrush}" VerticalAlignment="Center"/>
                </StackPanel>
                <TextBlock x:Name="FilePathLabel" Text="C:\Music\..." FontSize="11.5"
                           Foreground="{ThemeResource TextTertiaryBrush}" TextTrimming="CharacterEllipsis"/>
            </StackPanel>

            <StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="8" VerticalAlignment="Center">
                <Button x:Name="PlayPauseBtn" Style="{StaticResource TransportButton}" Click="OnPlayPauseClick" AutomationProperties.Name="재생/일시정지" ToolTipService.ToolTip="재생/일시정지 (Space)">
                    <FontIcon x:Name="PlayPauseIcon" Glyph="&#xE768;" FontSize="13"/>
                </Button>
                <TextBlock x:Name="PositionText" Text="0:00.000" FontSize="13" FontWeight="SemiBold"
                           Foreground="{ThemeResource DawnAccentBrush}" VerticalAlignment="Center" Width="72" TextAlignment="Right"/>
            </StackPanel>
        </Grid>

        <!-- 2. Offset Variable Step Controller -->
        <Border Grid.Row="1" Background="{ThemeResource PanelBrush}" BorderBrush="{ThemeResource BorderSubtleBrush}"
                BorderThickness="1" CornerRadius="8" Padding="14,10" Margin="0,0,0,14">
            <Grid RowSpacing="8">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                </Grid.RowDefinitions>

                <!-- Row 1: Step Delta Setting & Presets -->
                <Grid Grid.Row="0">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="*"/>
                    </Grid.ColumnDefinitions>

                    <StackPanel Orientation="Horizontal" Spacing="8" VerticalAlignment="Center">
                        <TextBlock Text="조절 스텝 단위:" FontSize="12" FontWeight="SemiBold"
                                   Foreground="{ThemeResource TextPrimaryBrush}" VerticalAlignment="Center"/>
                        <TextBox x:Name="StepDeltaBox" Width="70" Text="0.5" TextAlignment="Right"
                                 TextChanged="OnStepDeltaTextChanged"/>
                        <TextBlock Text="ms" FontSize="12" Foreground="{ThemeResource TextSecondaryBrush}" VerticalAlignment="Center"/>
                    </StackPanel>

                    <StackPanel Grid.Column="2" Orientation="Horizontal" Spacing="4" HorizontalAlignment="Right">
                        <TextBlock Text="스텝 프리셋:" FontSize="11.5" Foreground="{ThemeResource TextTertiaryBrush}" VerticalAlignment="Center" Margin="0,0,4,0"/>
                        <Button Content="0.001ms" FontSize="11" Padding="6,2" Click="OnPresetStepClick" Tag="0.001"/>
                        <Button Content="0.5ms" FontSize="11" Padding="6,2" Click="OnPresetStepClick" Tag="0.5"/>
                        <Button Content="1ms" FontSize="11" Padding="6,2" Click="OnPresetStepClick" Tag="1"/>
                        <Button Content="10ms" FontSize="11" Padding="6,2" Click="OnPresetStepClick" Tag="10"/>
                        <Button Content="100ms" FontSize="11" Padding="6,2" Click="OnPresetStepClick" Tag="100"/>
                        <Button Content="500ms" FontSize="11" Padding="6,2" Click="OnPresetStepClick" Tag="500"/>
                    </StackPanel>
                </Grid>

                <!-- Row 2: Big Adjust Buttons and Total Offset Input -->
                <Grid Grid.Row="1">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>

                    <Button x:Name="StepMinusBtn" Content="◀ - 0.5ms" Style="{StaticResource AccentButtonStyle}"
                            Click="OnStepMinusClick" Width="120" HorizontalContentAlignment="Center"/>

                    <StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="10" HorizontalAlignment="Center" VerticalAlignment="Center">
                        <TextBlock Text="현재 총 오프셋:" FontSize="12.5" FontWeight="SemiBold"
                                   Foreground="{ThemeResource TextPrimaryBrush}" VerticalAlignment="Center"/>
                        <TextBox x:Name="TotalOffsetBox" Width="100" Text="+0.000" TextAlignment="Right"
                                 TextChanged="OnTotalOffsetBoxChanged"/>
                        <TextBlock Text="ms" FontSize="12" Foreground="{ThemeResource TextSecondaryBrush}" VerticalAlignment="Center"/>
                        <TextBlock x:Name="TotalOffsetSecLabel" Text="(= 0.0000초)" FontSize="11.5"
                                   Foreground="{ThemeResource TextTertiaryBrush}" VerticalAlignment="Center"/>
                        <Button Content="0 초기화" FontSize="11" Click="OnResetOffsetClick" Margin="6,0,0,0"/>
                    </StackPanel>

                    <Button x:Name="StepPlusBtn" Grid.Column="2" Content="+ 0.5ms ▶" Style="{StaticResource AccentButtonStyle}"
                            Click="OnStepPlusClick" Width="120" HorizontalContentAlignment="Center"/>
                </Grid>
            </Grid>
        </Border>

        <!-- 3. Dual Editor Tabs -->
        <TabView x:Name="EditorTabs" Grid.Row="2" IsAddTabButtonVisible="False" SelectionChanged="OnEditorTabSelectionChanged">
            <TabView.TabItems>
                <!-- Tab 1: Line-by-line Sync Editor -->
                <TabViewItem Header="라인별 싱크 에디터" IsClosable="False">
                    <Grid Padding="0,10,0,0">
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="*"/>
                        </Grid.RowDefinitions>

                        <!-- Line Tools -->
                        <Grid Grid.Row="0" Margin="0,0,0,8">
                            <StackPanel Orientation="Horizontal" Spacing="6">
                                <Button Click="OnStampCurrentTimeClick" Style="{StaticResource AccentButtonStyle}">
                                    <StackPanel Orientation="Horizontal" Spacing="6">
                                        <FontIcon Glyph="&#xE916;" FontSize="12"/>
                                        <TextBlock Text="현재 시간 스탬프 (F5)"/>
                                    </StackPanel>
                                </Button>
                                <Button Click="OnAddLineClick">
                                    <StackPanel Orientation="Horizontal" Spacing="6">
                                        <FontIcon Glyph="&#xE710;" FontSize="12"/>
                                        <TextBlock Text="줄 추가"/>
                                    </StackPanel>
                                </Button>
                                <Button Click="OnDeleteSelectedLineClick">
                                    <StackPanel Orientation="Horizontal" Spacing="6">
                                        <FontIcon Glyph="&#xE74D;" FontSize="12"/>
                                        <TextBlock Text="줄 삭제"/>
                                    </StackPanel>
                                </Button>
                                <Button Click="OnMoveLineUpClick" AutomationProperties.Name="선택 줄 위로" ToolTipService.ToolTip="선택 줄 위로">
                                    <FontIcon Glyph="&#xE70E;" FontSize="12"/>
                                </Button>
                                <Button Click="OnMoveLineDownClick" AutomationProperties.Name="선택 줄 아래로" ToolTipService.ToolTip="선택 줄 아래로">
                                    <FontIcon Glyph="&#xE70D;" FontSize="12"/>
                                </Button>
                                <Button Click="OnPasteFromClipboardClick" AutomationProperties.Name="클립보드에서 가사 텍스트 가져오기" ToolTipService.ToolTip="클립보드에서 가사 텍스트 가져오기">
                                    <StackPanel Orientation="Horizontal" Spacing="6">
                                        <FontIcon Glyph="&#xE77F;" FontSize="12"/>
                                        <TextBlock Text="클립보드 붙여넣기"/>
                                    </StackPanel>
                                </Button>
                            </StackPanel>
                        </Grid>

                        <!-- Lines List -->
                        <ListView x:Name="LinesListView" Grid.Row="1" SelectionMode="Single"
                                  BorderBrush="{ThemeResource BorderSubtleBrush}" BorderThickness="1" CornerRadius="6">
                            <ListView.ItemTemplate>
                                <DataTemplate x:DataType="local:LrcEditLineVm">
                                    <Grid ColumnSpacing="8" Padding="4,2">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="Auto"/>
                                            <ColumnDefinition Width="80"/>
                                            <ColumnDefinition Width="*"/>
                                            <ColumnDefinition Width="Auto"/>
                                        </Grid.ColumnDefinitions>

                                        <TextBlock Grid.Column="0" Text="{x:Bind LineNo}" Width="28" FontSize="11"
                                                   Foreground="{ThemeResource TextTertiaryBrush}" VerticalAlignment="Center"/>

                                        <TextBox Grid.Column="1" Text="{x:Bind TimeString, Mode=TwoWay}" FontSize="12"
                                                 FontFamily="Consolas, Cascadia Code" TextAlignment="Center"/>

                                        <TextBox Grid.Column="2" Text="{x:Bind Text, Mode=TwoWay}" FontSize="12.5"/>

                                        <Button Grid.Column="3" Style="{StaticResource TransportButton}" Width="28" Height="28"
                                                Click="OnSeekToLineClick" Tag="{x:Bind}" AutomationProperties.Name="이 위치로 오디오 재생" ToolTipService.ToolTip="이 위치로 오디오 재생">
                                            <FontIcon Glyph="&#xE768;" FontSize="11"/>
                                        </Button>
                                    </Grid>
                                </DataTemplate>
                            </ListView.ItemTemplate>
                        </ListView>
                    </Grid>
                </TabViewItem>

                <!-- Tab 2: Raw Text Editor -->
                <TabViewItem Header="전체 LRC 텍스트 직접 편집" IsClosable="False">
                    <Grid Padding="0,10,0,0">
                        <TextBox x:Name="RawTextEditorBox" AcceptsReturn="True" TextWrapping="NoWrap"
                                 FontFamily="Consolas, Cascadia Code, Courier New" FontSize="12.5"
                                 ScrollViewer.HorizontalScrollBarVisibility="Auto"
                                 ScrollViewer.VerticalScrollBarVisibility="Auto"
                                 TextChanged="OnRawTextChanged"/>
                    </Grid>
                </TabViewItem>
            </TabView.TabItems>
        </TabView>

        <!-- 4. Footer: Status & Save Controls -->
        <Grid Grid.Row="3" Margin="0,14,0,0">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="Auto"/>
            </Grid.ColumnDefinitions>

            <TextBlock x:Name="StatusLabel" Text="준비됨" FontSize="12"
                       Foreground="{ThemeResource TextTertiaryBrush}" VerticalAlignment="Center"/>

            <StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="8">
                <Button Content="닫기" Click="OnCloseClick" Width="80"/>
                <Button Content="💾 LRC 파일로 저장" Style="{StaticResource AccentButtonStyle}" Click="OnSaveClick" Width="150"/>
            </StackPanel>
        </Grid>
    </Grid>
</Window>

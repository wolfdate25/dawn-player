<?xml version="1.0" encoding="utf-8"?>
<UserControl
    x:Class="DawnPlayer.App.Views.Network.RadioSection"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:core="using:DawnPlayer.Core.Models"
    xmlns:netw="using:DawnPlayer.App.Views.Network">

    <Grid RowSpacing="10">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <!-- Section header (L16 공용 계약의 기준 구현 — YouTube/DLNA도 이 3존 골격을 따른다):
             아이콘+제목(좌) | 필러 | 메타(카운트·연결 상태) | 액션(우측 끝 앵커) -->
        <Grid Grid.Row="0">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto"/>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="Auto"/>
                <ColumnDefinition Width="Auto"/>
                <ColumnDefinition Width="Auto"/>
            </Grid.ColumnDefinitions>
            <FontIcon Glyph="&#xE968;" FontSize="14" Foreground="{ThemeResource DawnAccentTextBrush}" VerticalAlignment="Center"/>
            <TextBlock x:Uid="Network_Radio_Title" Grid.Column="1" Text="라디오" Style="{StaticResource SectionHeaderText}"
                       Margin="8,0,0,0" VerticalAlignment="Center"/>
            <TextBlock x:Name="StationCountText" Grid.Column="2" Text="0" FontSize="{StaticResource FontBodySmall}"
                       Foreground="{ThemeResource TextTertiaryBrush}" Margin="0,0,12,0" VerticalAlignment="Center"/>
            <StackPanel Grid.Column="3" Orientation="Horizontal" Spacing="8" VerticalAlignment="Center"
                        Margin="0,0,12,0" Visibility="Collapsed" x:Name="ConnectStatusRow">
                <ProgressRing x:Name="ConnectRing" Width="14" Height="14" IsActive="False"/>
                <TextBlock x:Name="ConnectStatusText" Text="" FontSize="{StaticResource FontBodySmall}" VerticalAlignment="Center"
                           Foreground="{ThemeResource TextSecondaryBrush}"/>
            </StackPanel>
            <Button x:Uid="Network_Radio_Add" x:Name="AddStationButton" Grid.Column="4" Click="OnAddStationClick"
                    Padding="10,6" CornerRadius="4">
                <StackPanel Orientation="Horizontal" Spacing="8">
                    <FontIcon Glyph="&#xE710;" FontSize="12" Foreground="{ThemeResource DawnAccentTextBrush}"/>
                    <TextBlock x:Uid="Network_Radio_AddText" Text="방송국 추가" FontSize="{StaticResource FontBodySmall}"/>
                </StackPanel>
            </Button>
        </Grid>

        <!-- Station list (L13 변형 A: 플랫 — 박스 없음, 미디어 행 44/R4) -->
        <ListView x:Name="StationList" Grid.Row="1" SelectionMode="Single"
                  KeyDown="OnStationKeyDown"
                  DoubleTapped="OnStationDoubleTapped"
                  Padding="0,2,0,16">
            <ListView.ItemContainerStyle>
                <Style TargetType="ListViewItem">
                    <Setter Property="HorizontalContentAlignment" Value="Stretch"/>
                    <Setter Property="Padding" Value="6,1"/>
                    <Setter Property="MinHeight" Value="44"/>
                    <Setter Property="CornerRadius" Value="4"/>
                    <Setter Property="Margin" Value="0,1"/>
                </Style>
            </ListView.ItemContainerStyle>
            <ListView.ItemTemplate>
                <DataTemplate x:DataType="netw:RadioRow">
                    <Grid Padding="16,8" Background="Transparent">
                        <Grid.ContextFlyout>
                            <MenuFlyout>
                                <MenuFlyoutItem x:Uid="Network_Radio_Play" Text="재생" Click="OnPlayStationClick">
                                    <MenuFlyoutItem.Icon><FontIcon Glyph="&#xE768;"/></MenuFlyoutItem.Icon>
                                </MenuFlyoutItem>
                                <MenuFlyoutItem x:Uid="Network_Radio_Edit" Text="편집" Click="OnEditStationClick">
                                    <MenuFlyoutItem.Icon><FontIcon Glyph="&#xE70F;"/></MenuFlyoutItem.Icon>
                                </MenuFlyoutItem>
                                <MenuFlyoutItem x:Uid="Network_Radio_Remove" Text="삭제" Click="OnRemoveStationClick">
                                    <MenuFlyoutItem.Icon><FontIcon Glyph="&#xE74D;"/></MenuFlyoutItem.Icon>
                                </MenuFlyoutItem>
                            </MenuFlyout>
                        </Grid.ContextFlyout>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>
                        <Border Grid.Column="0" Width="3" CornerRadius="2" Margin="0,0,10,0" Height="28"
                                Visibility="{x:Bind PlayingBadgeVisibility, Mode=OneWay}"
                                Background="{ThemeResource DawnAccentBrush}"/>
                        <StackPanel Grid.Column="1" Spacing="2">
                            <StackPanel Orientation="Horizontal" Spacing="8">
                                <TextBlock Text="{x:Bind Station.Name}" FontSize="{StaticResource FontBody}" FontWeight="SemiBold"
                                           Foreground="{ThemeResource TextPrimaryBrush}" TextTrimming="CharacterEllipsis"/>
                                <Border CornerRadius="4" Padding="5,1" Background="{ThemeResource DawnAccentBrush}"
                                        Visibility="{x:Bind PlayingBadgeVisibility, Mode=OneWay}">
                                    <TextBlock x:Uid="Network_Radio_PlayingBadge" Text="재생 중" FontSize="{StaticResource FontCaption}"
                                               Foreground="{ThemeResource OnAccentBrush}"/>
                                </Border>
                            </StackPanel>
                            <TextBlock Text="{x:Bind Station.Url}" FontSize="{StaticResource FontCaption}"
                                       Foreground="{ThemeResource TextTertiaryBrush}" TextTrimming="CharacterEllipsis"/>
                        </StackPanel>
                    </Grid>
                </DataTemplate>
            </ListView.ItemTemplate>
        </ListView>

        <!-- Empty state (U2 pattern: message, no action — the header's add button is the action) -->
        <StackPanel x:Name="EmptyState" Grid.Row="1" HorizontalAlignment="Center" VerticalAlignment="Center" Spacing="8">
            <FontIcon Glyph="&#xE968;" FontSize="28" Foreground="{ThemeResource TextTertiaryBrush}" HorizontalAlignment="Center"/>
            <TextBlock x:Uid="Network_Radio_Empty" Text="저장된 방송국이 없습니다. '방송국 추가'로 Icecast/Shoutcast MP3 스트림 URL을 등록하세요."
                       FontSize="{StaticResource FontBodySmall}" Foreground="{ThemeResource TextTertiaryBrush}" HorizontalAlignment="Center"
                       TextWrapping="Wrap" MaxWidth="380" TextAlignment="Center"/>
        </StackPanel>
    </Grid>
</UserControl>

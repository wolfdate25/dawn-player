<?xml version="1.0" encoding="utf-8"?>
<UserControl
    x:Class="DawnPlayer.App.Views.Network.DlnaSection"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:netw="using:DawnPlayer.App.Views.Network">

    <Grid RowSpacing="10">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <!-- Toolbar: server picker + refresh + busy indicator -->
        <Grid Grid.Row="0" ColumnSpacing="10">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="Auto"/>
                <ColumnDefinition Width="Auto"/>
            </Grid.ColumnDefinitions>
            <ComboBox x:Name="ServerList" Grid.Column="0" HorizontalAlignment="Left" MinWidth="240"
                      DisplayMemberPath="DisplayName" SelectionChanged="OnServerSelected"/>
            <Button x:Uid="Network_Dlna_Refresh" Grid.Column="1" Click="OnRefreshServersClick" Padding="10,5" CornerRadius="4">
                <StackPanel Orientation="Horizontal" Spacing="7">
                    <FontIcon Glyph="&#xE72C;" FontSize="12" Foreground="{ThemeResource DawnAccentBrush}"/>
                    <TextBlock x:Uid="Network_Dlna_RefreshText" Text="서버 새로고침" FontSize="12"/>
                </StackPanel>
            </Button>
            <ProgressRing x:Name="BusyRing" Grid.Column="2" Width="18" Height="18" IsActive="False"
                          VerticalAlignment="Center"/>
        </Grid>

        <!-- Breadcrumb: root + container path, clickable to jump back -->
        <ItemsControl x:Name="Breadcrumb" Grid.Row="1" ItemsSource="{x:Bind Crumbs}">
            <ItemsControl.ItemsPanel>
                <ItemsPanelTemplate>
                    <StackPanel Orientation="Horizontal"/>
                </ItemsPanelTemplate>
            </ItemsControl.ItemsPanel>
            <ItemsControl.ItemTemplate>
                <DataTemplate x:DataType="netw:DlnaCrumb">
                    <StackPanel Orientation="Horizontal">
                        <Button Content="{x:Bind Title}" Click="OnCrumbClick" Tag="{x:Bind Index}"
                                Padding="6,2" FontSize="12" Background="Transparent" BorderThickness="0"
                                Foreground="{ThemeResource DawnAccentBrush}"/>
                        <TextBlock Text="›" FontSize="12" Foreground="{ThemeResource TextTertiaryBrush}"
                                   VerticalAlignment="Center" Margin="2,0,2,0"/>
                    </StackPanel>
                </DataTemplate>
            </ItemsControl.ItemTemplate>
        </ItemsControl>

        <!-- Entries: containers navigate on click, tracks play on double-click -->
        <Grid Grid.Row="2">
            <ListView x:Name="EntryList" SelectionMode="Single" IsItemClickEnabled="True"
                      ItemClick="OnEntryItemClick" DoubleTapped="OnEntryDoubleTapped"
                      Background="{ThemeResource PanelSubtleBrush}"
                      BorderBrush="{ThemeResource SeparatorSubtleBrush}" BorderThickness="1" CornerRadius="6">
                <ListView.ItemTemplate>
                    <DataTemplate x:DataType="netw:DlnaRow">
                        <Grid Padding="12,8" Background="Transparent">
                            <Grid.ContextFlyout>
                                <MenuFlyout>
                                    <MenuFlyoutItem x:Uid="Network_Dlna_Play" Text="지금 재생" Click="OnPlayItemClick"
                                                    IsEnabled="{x:Bind IsTrack}">
                                        <MenuFlyoutItem.Icon><FontIcon Glyph="&#xE768;"/></MenuFlyoutItem.Icon>
                                    </MenuFlyoutItem>
                                    <MenuFlyoutItem x:Uid="Network_Dlna_Add" Text="Now Playing에 추가" Click="OnAddItemClick"
                                                    IsEnabled="{x:Bind IsTrack}">
                                        <MenuFlyoutItem.Icon><FontIcon Glyph="&#xE71A;"/></MenuFlyoutItem.Icon>
                                    </MenuFlyoutItem>
                                </MenuFlyout>
                            </Grid.ContextFlyout>
                            <StackPanel Orientation="Horizontal" Spacing="10">
                                <FontIcon Glyph="{x:Bind IconGlyph}" FontSize="12" Foreground="{ThemeResource TextTertiaryBrush}"
                                          VerticalAlignment="Center"/>
                                <StackPanel Spacing="2" VerticalAlignment="Center">
                                    <TextBlock Text="{x:Bind Title}" FontSize="12.5" FontWeight="SemiBold"
                                               Foreground="{ThemeResource TextPrimaryBrush}" TextTrimming="CharacterEllipsis"/>
                                    <TextBlock Text="{x:Bind Subtitle}" FontSize="11"
                                               Foreground="{ThemeResource TextTertiaryBrush}" TextTrimming="CharacterEllipsis"/>
                                </StackPanel>
                            </StackPanel>
                        </Grid>
                    </DataTemplate>
                </ListView.ItemTemplate>
            </ListView>

            <!-- Empty state: no server found -->
            <StackPanel x:Name="EmptyState" HorizontalAlignment="Center" VerticalAlignment="Center" Spacing="8">
                <FontIcon Glyph="&#xE8F1;" FontSize="22" Foreground="{ThemeResource TextTertiaryBrush}" HorizontalAlignment="Center"/>
                <TextBlock x:Uid="Network_Dlna_NoServers" Text="DLNA 서버를 찾지 못했습니다…" FontSize="12"
                           Foreground="{ThemeResource TextTertiaryBrush}" TextWrapping="Wrap" MaxWidth="420" TextAlignment="Center"/>
            </StackPanel>
        </Grid>

        <!-- Pagination footer -->
        <Button x:Name="LoadMoreButton" x:Uid="Network_Dlna_LoadMore" Grid.Row="3" Content="더 불러오기…"
                Click="OnLoadMoreClick" HorizontalAlignment="Center" Padding="14,5" Visibility="Collapsed"/>
    </Grid>
</UserControl>

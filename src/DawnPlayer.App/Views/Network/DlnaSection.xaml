<?xml version="1.0" encoding="utf-8"?>
<UserControl
    x:Class="DawnPlayer.App.Views.Network.DlnaSection"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:netw="using:DawnPlayer.App.Views.Network">

    <Grid RowSpacing="10">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <!-- Section header (L16 공용 계약 — Radio/YouTube와 동일 3존 골격): 아이콘+제목(좌) |
             필러 | 서버 새로고침(우측 끝 앵커 — 섹션의 주 액션은 세 섹션 모두 우측 끝에 있다) -->
        <Grid Grid.Row="0">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto"/>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="Auto"/>
            </Grid.ColumnDefinitions>
            <FontIcon Glyph="&#xE8F1;" FontSize="14" Foreground="{ThemeResource DawnAccentTextBrush}" VerticalAlignment="Center"/>
            <TextBlock x:Uid="Network_Dlna_Title" Grid.Column="1" Text="DLNA" Style="{StaticResource SectionHeaderText}"
                       Margin="8,0,0,0" VerticalAlignment="Center"/>
            <Button x:Uid="Network_Dlna_Refresh" Grid.Column="2" Click="OnRefreshServersClick" Padding="10,6" CornerRadius="4"
                    VerticalAlignment="Center">
                <StackPanel Orientation="Horizontal" Spacing="8">
                    <FontIcon Glyph="&#xE72C;" FontSize="12" Foreground="{ThemeResource DawnAccentTextBrush}"/>
                    <TextBlock x:Uid="Network_Dlna_RefreshText" Text="서버 새로고침" FontSize="{StaticResource FontBodySmall}"/>
                </StackPanel>
            </Button>
        </Grid>

        <!-- Toolbar: server picker + busy indicator (주 액션인 새로고침은 헤더 우측 앵커로) -->
        <Grid Grid.Row="1" ColumnSpacing="10">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="Auto"/>
                <ColumnDefinition Width="Auto"/>
            </Grid.ColumnDefinitions>
            <ComboBox x:Name="ServerList" Grid.Column="0" HorizontalAlignment="Left" MinWidth="240"
                      DisplayMemberPath="DisplayName" SelectionChanged="OnServerSelected"/>
            <ProgressRing x:Name="BusyRing" Grid.Column="1" Width="18" Height="18" IsActive="False"
                          VerticalAlignment="Center"/>
            <Button x:Uid="Network_Dlna_Retry" x:Name="BrowseRetryButton" Grid.Column="2" Click="OnBrowseRetryClick"
                    Padding="10,6" CornerRadius="4" Visibility="Collapsed"/>
        </Grid>

        <!-- Play-prep status: DLNA opens spool the whole file — explain the silent multi-second gap -->
        <StackPanel x:Name="PlayStatusRow" Grid.Row="3" Orientation="Horizontal" Spacing="8"
                    VerticalAlignment="Center" Visibility="Collapsed">
            <ProgressRing Width="14" Height="14" IsActive="True"/>
            <TextBlock x:Name="PlayStatusText" x:Uid="Network_Dlna_Preparing" FontSize="{StaticResource FontBodySmall}"
                       TextWrapping="Wrap" Foreground="{ThemeResource TextSecondaryBrush}"
                       VerticalAlignment="Center"/>
        </StackPanel>

        <!-- Breadcrumb: root + container path, clickable to jump back -->
        <ItemsControl x:Name="Breadcrumb" Grid.Row="2" ItemsSource="{x:Bind Crumbs}">
            <ItemsControl.ItemsPanel>
                <ItemsPanelTemplate>
                    <StackPanel Orientation="Horizontal"/>
                </ItemsPanelTemplate>
            </ItemsControl.ItemsPanel>
            <ItemsControl.ItemTemplate>
                <DataTemplate x:DataType="netw:DlnaCrumb">
                    <StackPanel Orientation="Horizontal">
                        <Button Content="{x:Bind Title}" Click="OnCrumbClick" Tag="{x:Bind Index}"
                                Padding="6,2" FontSize="{StaticResource FontBodySmall}" Background="Transparent" BorderThickness="0"
                                Foreground="{ThemeResource DawnAccentTextBrush}"/>
                        <TextBlock Text="›" FontSize="{StaticResource FontBodySmall}" Foreground="{ThemeResource TextTertiaryBrush}"
                                   VerticalAlignment="Center" Margin="2,0,2,0"/>
                    </StackPanel>
                </DataTemplate>
            </ItemsControl.ItemTemplate>
        </ItemsControl>

        <!-- Entries: containers navigate on click, tracks play on double-click.
             L13 변형 A: 플랫 — 박스 없음, 미디어 행 44/R4. -->
        <Grid Grid.Row="4">
            <ListView x:Name="EntryList" SelectionMode="Single" IsItemClickEnabled="True"
                      KeyDown="OnEntryKeyDown"
                      ItemClick="OnEntryItemClick" DoubleTapped="OnEntryDoubleTapped"
                      Padding="0,2,0,16">
                <ListView.ItemContainerStyle>
                    <Style TargetType="ListViewItem">
                        <Setter Property="HorizontalContentAlignment" Value="Stretch"/>
                        <Setter Property="Padding" Value="6,1"/>
                        <Setter Property="MinHeight" Value="44"/>
                        <Setter Property="CornerRadius" Value="4"/>
                        <Setter Property="Margin" Value="0,1"/>
                    </Style>
                </ListView.ItemContainerStyle>
                <ListView.ItemTemplate>
                    <DataTemplate x:DataType="netw:DlnaRow">
                        <Grid Padding="16,8" Background="Transparent">
                            <Grid.ContextFlyout>
                                <MenuFlyout>
                                    <MenuFlyoutItem x:Uid="Network_Dlna_Play" Text="지금 재생" Click="OnPlayItemClick"
                                                    IsEnabled="{x:Bind IsTrack}">
                                        <MenuFlyoutItem.Icon><FontIcon Glyph="&#xE768;"/></MenuFlyoutItem.Icon>
                                    </MenuFlyoutItem>
                                    <MenuFlyoutItem x:Uid="Network_Dlna_Add" Text="Now Playing에 추가" Click="OnAddItemClick"
                                                    IsEnabled="{x:Bind IsTrack}">
                                        <MenuFlyoutItem.Icon><FontIcon Glyph="&#xE71A;"/></MenuFlyoutItem.Icon>
                                    </MenuFlyoutItem>
                                </MenuFlyout>
                            </Grid.ContextFlyout>
                            <StackPanel Orientation="Horizontal" Spacing="10">
                                <Grid Width="38" Height="38" VerticalAlignment="Center"
                                      Background="{ThemeResource CardBrush}" CornerRadius="4">
                                    <FontIcon Glyph="{x:Bind IconGlyph}" FontSize="13"
                                              Foreground="{ThemeResource TextTertiaryBrush}"/>
                                    <Image Source="{x:Bind Art, Mode=OneWay}" Stretch="UniformToFill"/>
                                </Grid>
                                <StackPanel Spacing="2" VerticalAlignment="Center">
                                    <TextBlock Text="{x:Bind Title}" FontSize="{StaticResource FontBody}" FontWeight="SemiBold"
                                               Foreground="{ThemeResource TextPrimaryBrush}" TextTrimming="CharacterEllipsis"/>
                                    <TextBlock Text="{x:Bind Subtitle}" FontSize="{StaticResource FontCaption}"
                                               Foreground="{ThemeResource TextTertiaryBrush}" TextTrimming="CharacterEllipsis"/>
                                </StackPanel>
                            </StackPanel>
                        </Grid>
                    </DataTemplate>
                </ListView.ItemTemplate>
            </ListView>

            <!-- Empty state: no server found. The hint text carries the diagnosis; the button is
                 the action it points to, so recovery needs no trip to the toolbar. -->
            <StackPanel x:Name="EmptyState" HorizontalAlignment="Center" VerticalAlignment="Center" Spacing="8">
                <FontIcon Glyph="&#xE8F1;" FontSize="28" Foreground="{ThemeResource TextTertiaryBrush}" HorizontalAlignment="Center"/>
                <TextBlock x:Uid="Network_Dlna_NoServers" Text="DLNA 서버를 찾지 못했습니다…" FontSize="{StaticResource FontBodySmall}"
                           Foreground="{ThemeResource TextTertiaryBrush}" TextWrapping="Wrap" MaxWidth="380" TextAlignment="Center"/>
                <Button x:Uid="Network_Dlna_Refresh" Click="OnRefreshServersClick" Padding="10,6" CornerRadius="4"
                        HorizontalAlignment="Center">
                    <TextBlock x:Uid="Network_Dlna_RefreshText" Text="서버 새로고침" FontSize="{StaticResource FontBodySmall}"/>
                </Button>
            </StackPanel>
        </Grid>

        <!-- Pagination footer -->
        <Button x:Name="LoadMoreButton" x:Uid="Network_Dlna_LoadMore" Grid.Row="5" Content="더 불러오기…"
                Click="OnLoadMoreClick" HorizontalAlignment="Center" Padding="14,6" Visibility="Collapsed"/>
    </Grid>
</UserControl>

<?xml version="1.0" encoding="utf-8"?>
<Page
    x:Class="DawnPlayer.App.Views.NetworkPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:network="using:DawnPlayer.App.Views.Network"
    NavigationCacheMode="Enabled">

    <!-- L13(2026-10-04): 네트워크 소스는 한 페이지 안의 섹션으로 살고, 전환은 데이터 소스
         사이드바가 맡는다 — Library/Playlist와 같은 "좌측 사이드바 + 콘텐츠" 골격. 소스 추가는
         여기에 행 1개+섹션 1개면 충분하고 셸 탭 계산기는 다시 만지지 않는다. -->
    <Grid Background="{ThemeResource LayerBgBrush}">
        <Grid.ColumnDefinitions>
            <!-- Panel 1: 데이터 소스 사이드바(고정 — 소스 3종, 크기 조정 필요 없음) -->
            <ColumnDefinition Width="200"/>
            <!-- Panel 2: 선택된 섹션 콘텐츠 -->
            <ColumnDefinition Width="*"/>
        </Grid.ColumnDefinitions>

        <!-- [Panel 1] 데이터 소스 사이드바 (Playlist 사이드바 언어: PanelSubtle + 헤어라인,
             행 32px/R4, 선택 틴트) -->
        <Grid Grid.Column="0" Background="{ThemeResource PanelSubtleBrush}"
              BorderBrush="{ThemeResource SeparatorSubtleBrush}" BorderThickness="0,0,1,0">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="*"/>
            </Grid.RowDefinitions>

            <TextBlock x:Uid="Network_SidebarHeader" Grid.Row="0" Text="데이터 소스"
                       Style="{StaticResource SectionHeaderText}" Margin="16,14,14,8"/>

            <ListView x:Name="SourceList" Grid.Row="1" SelectionMode="Single"
                      SingleSelectionFollowsFocus="True"
                      SelectionChanged="OnSourceSelectionChanged"
                      Padding="6,2,6,16">
                <ListView.ItemContainerStyle>
                    <Style TargetType="ListViewItem">
                        <Setter Property="HorizontalContentAlignment" Value="Stretch"/>
                        <Setter Property="Padding" Value="10,6"/>
                        <Setter Property="MinHeight" Value="32"/>
                        <Setter Property="CornerRadius" Value="4"/>
                        <Setter Property="Margin" Value="0,1"/>
                    </Style>
                </ListView.ItemContainerStyle>
                <ListViewItem IsSelected="True">
                    <StackPanel Orientation="Horizontal" Spacing="8">
                        <FontIcon Glyph="&#xE968;" FontSize="12" Foreground="{ThemeResource TextTertiaryBrush}"/>
                        <TextBlock x:Uid="Network_Section_Radio" Text="라디오" FontSize="{StaticResource FontBody}"
                                   Foreground="{ThemeResource TextPrimaryBrush}" VerticalAlignment="Center"/>
                    </StackPanel>
                </ListViewItem>
                <ListViewItem>
                    <StackPanel Orientation="Horizontal" Spacing="8">
                        <FontIcon Glyph="&#xE8F1;" FontSize="12" Foreground="{ThemeResource TextTertiaryBrush}"/>
                        <TextBlock x:Uid="Network_Section_Dlna" Text="DLNA" FontSize="{StaticResource FontBody}"
                                   Foreground="{ThemeResource TextPrimaryBrush}" VerticalAlignment="Center"/>
                    </StackPanel>
                </ListViewItem>
                <ListViewItem>
                    <StackPanel Orientation="Horizontal" Spacing="8">
                        <FontIcon Glyph="&#xE8F2;" FontSize="12" Foreground="{ThemeResource TextTertiaryBrush}"/>
                        <TextBlock x:Uid="Network_Section_YouTube" Text="YouTube" FontSize="{StaticResource FontBody}"
                                   Foreground="{ThemeResource TextPrimaryBrush}" VerticalAlignment="Center"/>
                    </StackPanel>
                </ListViewItem>
            </ListView>
        </Grid>

        <!-- [Panel 2] 섹션 3종은 겹침 유지 — 가시성만 사이드바 선택을 따른다. 지연 활성화 계약도
             그대로(ActivatePage → 라디오, 첫 방문 → 나머지). L14: 콘텐츠 열 인셋은 의미 토큰
             (Playlist 패밀리 20,14,20,16) — 창 모서리·하단바 헤어라인과의 리듬을 페이지와 무관하게
             유지한다. -->
        <Grid Grid.Column="1" Padding="{ThemeResource PageContentPadding}">
            <network:RadioSection x:Name="RadioSectionControl"/>
            <network:DlnaSection x:Name="DlnaSectionControl" Visibility="Collapsed"/>
            <network:YouTubeSection x:Name="YouTubeSectionControl" Visibility="Collapsed"/>
        </Grid>
    </Grid>
</Page>

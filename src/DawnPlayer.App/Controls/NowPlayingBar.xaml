<?xml version="1.0" encoding="utf-8"?>
<UserControl
    x:Class="DawnPlayer.App.Controls.NowPlayingBar"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:local="using:DawnPlayer.App.Controls"
    Height="96">

    <Grid Background="{ThemeResource PanelBrush}" Padding="18,2,18,6" SizeChanged="OnRootSizeChanged"
          BorderBrush="{ThemeResource SeparatorBrush}" BorderThickness="0,1,0,0">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <!-- 1. Eole-style full-width seek line with edge timestamps -->
        <Grid Grid.Row="0" Margin="0,0,0,3">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="44"/>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="44"/>
            </Grid.ColumnDefinitions>

            <TextBlock x:Name="ElapsedText" Grid.Column="0" Text="0:00" Style="{StaticResource TrackNumText}"
                       FontSize="11" HorizontalAlignment="Left" VerticalAlignment="Center"/>

            <Slider x:Uid="NowPlaying_SeekSlider" x:Name="SeekSlider" Grid.Column="1" Style="{StaticResource EoleSlimSliderStyle}"
                    AutomationProperties.Name="재생 위치"
                    Minimum="0" Maximum="100" StepFrequency="1" MinWidth="40" Margin="10,0"/>

            <TextBlock x:Name="RemainingText" Grid.Column="2" Text="-0:00" Style="{StaticResource TrackDurationText}"
                       FontSize="11" HorizontalAlignment="Right" VerticalAlignment="Center"/>
        </Grid>

        <!-- 2. Main row: Track info | Transport | Volume & tools -->
        <Grid Grid.Row="1">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" MinWidth="0"/>
                <ColumnDefinition Width="Auto"/>
                <ColumnDefinition Width="*" MinWidth="0"/>
            </Grid.ColumnDefinitions>

            <!-- 2a. Track & Album Art Info (Left) -->
            <Grid Grid.Column="0" VerticalAlignment="Center" Margin="0,0,12,0">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="*"/>
                </Grid.ColumnDefinitions>

                <!-- Album Art Card with subtle border and zoom-on-click flyout -->
                <Button x:Uid="NowPlaying_AlbumArtButton" Grid.Column="0" Width="56" Height="56" Padding="0" CornerRadius="6"
                        Background="{ThemeResource CardBrush}" BorderBrush="{ThemeResource BorderSubtleBrush}"
                        BorderThickness="1" AutomationProperties.Name="앨범 커버 크게 보기"
                        ToolTipService.ToolTip="앨범 커버 크게 보기">
                    <Grid>
                        <FontIcon x:Name="ArtPlaceholder" Glyph="&#xE90B;" FontSize="22"
                                  Foreground="{ThemeResource TextTertiaryBrush}"/>
                        <Border CornerRadius="5">
                            <Image x:Name="ArtImage" Stretch="UniformToFill"/>
                        </Border>
                    </Grid>
                    <Button.Flyout>
                        <Flyout Placement="TopEdgeAlignedLeft">
                            <Border Width="280" Height="280" CornerRadius="8" Background="{ThemeResource CardBrush}">
                                <Grid>
                                    <FontIcon Glyph="&#xE90B;" FontSize="64" Foreground="{ThemeResource TextTertiaryBrush}"/>
                                    <Border CornerRadius="8">
                                        <Image x:Name="ArtFlyoutImage" Stretch="UniformToFill"/>
                                    </Border>
                                </Grid>
                            </Border>
                        </Flyout>
                    </Button.Flyout>
                </Button>

                <StackPanel Grid.Column="1" Margin="12,0,8,0" VerticalAlignment="Center" Spacing="1">
                    <TextBlock x:Uid="NowPlaying_TrackTitle_Empty" x:Name="TrackTitle" Text="재생 중인 트랙 없음" FontSize="13" FontWeight="SemiBold"
                               Foreground="{ThemeResource TextPrimaryBrush}" TextTrimming="CharacterEllipsis"/>

                    <TextBlock x:Name="TrackArtist" Text="" FontSize="11.5"
                               Foreground="{ThemeResource TextSecondaryBrush}" TextTrimming="CharacterEllipsis"/>

                    <!-- Audio format and output session badges -->
                    <StackPanel Orientation="Horizontal" Spacing="4" Margin="0,1,0,0">
                        <Border x:Name="FormatBadge" Style="{StaticResource CodecBadge}" HorizontalAlignment="Left"
                                Visibility="Collapsed">
                            <TextBlock x:Name="FormatBadgeText" Text="FLAC · 24bit/96kHz" Style="{StaticResource BadgeText}"
                                       FontSize="9" Foreground="{ThemeResource DawnAccentBrush}"/>
                        </Border>
                        <Border x:Name="OutputBadge" Style="{StaticResource CodecBadge}" HorizontalAlignment="Left"
                                Visibility="Collapsed" MaxWidth="220">
                            <TextBlock x:Name="OutputBadgeText" Text="WASAPI 배타" Style="{StaticResource BadgeText}"
                                       FontSize="9" Foreground="{ThemeResource TextSecondaryBrush}"
                                       TextTrimming="CharacterEllipsis"/>
                        </Border>
                    </StackPanel>
                </StackPanel>
            </Grid>

            <!-- 2b. Transport Controls (Center) -->
            <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center" Spacing="6">
                <ToggleButton x:Uid="NowPlaying_ShuffleButton" x:Name="ShuffleButton" Style="{StaticResource TransportToggleButton}"
                              AutomationProperties.Name="무작위 재생"
                              Click="OnShuffleClick" ToolTipService.ToolTip="무작위 재생">
                    <FontIcon x:Name="ShuffleIcon" Glyph="&#xE8B1;" FontSize="13"/>
                </ToggleButton>

                <Button x:Uid="NowPlaying_PreviousButton" x:Name="PreviousButton" AutomationProperties.Name="이전 트랙"
                        Style="{StaticResource TransportButton}" Click="OnPreviousClick" ToolTipService.ToolTip="이전 트랙">
                    <FontIcon Glyph="&#xE76B;" FontSize="13"/>
                </Button>

                <Button x:Uid="NowPlaying_PlayButton" x:Name="PlayButton" Style="{StaticResource PlayPauseButton}" Click="OnPlayClick"
                        AutomationProperties.Name="재생" ToolTipService.ToolTip="재생/일시정지">
                    <FontIcon x:Name="PlayIcon" Glyph="&#xE768;" FontSize="15" Foreground="{ThemeResource TextPrimaryBrush}"/>
                </Button>

                <Button x:Uid="NowPlaying_NextButton" x:Name="NextButton" AutomationProperties.Name="다음 트랙"
                        Style="{StaticResource TransportButton}" Click="OnNextClick" ToolTipService.ToolTip="다음 트랙">
                    <FontIcon Glyph="&#xE76C;" FontSize="13"/>
                </Button>

                <Button x:Uid="NowPlaying_StopButton" x:Name="StopButton" AutomationProperties.Name="정지"
                        Style="{StaticResource TransportButton}" Click="OnStopClick" ToolTipService.ToolTip="정지">
                    <FontIcon Glyph="&#xE71A;" FontSize="12"/>
                </Button>

                <ToggleButton x:Uid="NowPlaying_RepeatButton" x:Name="RepeatButton" Style="{StaticResource TransportToggleButton}"
                              AutomationProperties.Name="반복"
                              Click="OnRepeatClick" ToolTipService.ToolTip="반복 (끔 / 전체 / 한 곡)">
                    <FontIcon x:Name="RepeatIcon" Glyph="&#xE8EE;" FontSize="13"/>
                </ToggleButton>

                <ToggleButton x:Uid="NowPlaying_ABRepeatButton" x:Name="ABRepeatButton" Style="{StaticResource TransportToggleButton}"
                              AutomationProperties.Name="A-B 반복"
                              Click="OnABRepeatClick" ToolTipService.ToolTip="A-B 반복">
                    <TextBlock x:Name="ABRepeatLabel" Text="A–B" FontSize="11" FontWeight="SemiBold"/>
                </ToggleButton>
            </StackPanel>

            <!-- 2c. Volume / Queue / Lyrics (Right) -->
            <StackPanel Grid.Column="2" Orientation="Horizontal" HorizontalAlignment="Right" VerticalAlignment="Center" Spacing="6">
                <!-- Mute & Volume Slider -->
                <Button x:Uid="NowPlaying_MuteButton" x:Name="MuteButton" Style="{StaticResource TransportButton}" Click="OnMuteClick"
                        AutomationProperties.Name="음소거" ToolTipService.ToolTip="음소거">
                    <FontIcon x:Name="VolumeIcon" Glyph="&#xE767;" FontSize="13"/>
                </Button>

                <Slider x:Uid="NowPlaying_VolumeSlider" x:Name="VolumeSlider" Width="96" Style="{StaticResource EoleSlimSliderStyle}"
                        Minimum="0" Maximum="100" StepFrequency="1"
                        AutomationProperties.Name="볼륨"
                        ValueChanged="OnVolumeChanged" ToolTipService.ToolTip="볼륨"/>

                <!-- Playback Queue Flyout Button -->
                <Button x:Uid="NowPlaying_QueueButton" x:Name="QueueButton" Style="{StaticResource TransportButton}"
                        AutomationProperties.Name="재생 대기열"
                        Click="OnQueueClick" ToolTipService.ToolTip="재생 대기열">
                    <Grid>
                        <FontIcon Glyph="&#xE8FD;" FontSize="13"/>
                        <Border x:Name="QueueBadge" CornerRadius="8" Background="{ThemeResource DawnAccentBrush}"
                                MinWidth="16" Height="16" VerticalAlignment="Top" HorizontalAlignment="Right"
                                Margin="0,-6,-8,0" Padding="4,0" Visibility="Collapsed">
                            <TextBlock x:Name="QueueBadgeText" Text="0" FontSize="9" FontWeight="Bold"
                                       Foreground="Black" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                    </Grid>
                    <Button.Flyout>
                        <Flyout Placement="Top" ShouldConstrainToRootBounds="False">
                            <StackPanel Width="340" MaxHeight="380">
                                <Grid Margin="4,0,4,8">
                                    <TextBlock x:Uid="NowPlaying_QueueTitle" Text="재생 대기열" FontWeight="SemiBold" FontSize="13.5" VerticalAlignment="Center"/>
                                    <StackPanel Orientation="Horizontal" Spacing="6" HorizontalAlignment="Right">
                                        <Button x:Uid="NowPlaying_QueueSaveButton" x:Name="QueueSaveButton" Content="재생목록으로 저장" FontSize="11.5"
                                                Click="OnQueueSaveClick"/>
                                        <Button x:Uid="NowPlaying_QueueClearButton" x:Name="QueueClearButton" Content="비우기" FontSize="11.5"
                                                Click="OnQueueClearClick"/>
                                    </StackPanel>
                                </Grid>
                                <ListView x:Name="QueueList" SelectionMode="None" IsItemClickEnabled="False"
                                          MaxHeight="300">
                                    <ListView.ItemTemplate>
                                        <DataTemplate x:DataType="local:QueueUiEntry">
                                            <Grid ColumnSpacing="8" Padding="2,4">
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition Width="22"/>
                                                    <ColumnDefinition Width="*"/>
                                                    <ColumnDefinition Width="28"/>
                                                </Grid.ColumnDefinitions>
                                                <Border Grid.Column="0" Background="{ThemeResource CardBrush}" CornerRadius="4"
                                                        Width="20" Height="20" VerticalAlignment="Center">
                                                    <TextBlock Text="{x:Bind Index}" FontSize="10" FontWeight="SemiBold"
                                                               Foreground="{ThemeResource DawnAccentBrush}"
                                                               HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                                </Border>
                                                <StackPanel Grid.Column="1" VerticalAlignment="Center">
                                                    <TextBlock Text="{x:Bind Title}" FontSize="12" TextTrimming="CharacterEllipsis"/>
                                                    <TextBlock Text="{x:Bind Subtitle}" FontSize="11"
                                                               Foreground="{ThemeResource TextTertiaryBrush}" TextTrimming="CharacterEllipsis"/>
                                                </StackPanel>
                                                <Button x:Uid="NowPlaying_QueueRemoveButton" Grid.Column="2" Content="&#xE711;" FontFamily="Segoe Fluent Icons" FontSize="10"
                                                        Width="26" Height="26" CornerRadius="13" Background="Transparent"
                                                        BorderThickness="0" Padding="0"
                                                        AutomationProperties.Name="대기열에서 제거"
                                                        ToolTipService.ToolTip="대기열에서 제거"
                                                        Click="OnQueueRemoveClick" Tag="{x:Bind Index}"/>
                                            </Grid>
                                        </DataTemplate>
                                    </ListView.ItemTemplate>
                                </ListView>
                                <TextBlock x:Uid="NowPlaying_QueueEmptyText" x:Name="QueueEmptyText" Text="대기열이 비어 있습니다. 트랙에서 마우스 오른쪽 버튼으로 '대기열에 추가'를 선택하세요."
                                           FontSize="11.5" Foreground="{ThemeResource TextTertiaryBrush}" TextWrapping="Wrap"
                                           Margin="4,10"/>
                            </StackPanel>
                        </Flyout>
                    </Button.Flyout>
                </Button>

                <!-- Lyrics Pane Toggle Button (Spotify/Apple Music Style) -->
                <ToggleButton x:Uid="NowPlaying_LyricsButton" x:Name="LyricsButton" Style="{StaticResource TransportToggleButton}"
                              AutomationProperties.Name="가사 패널"
                              Click="OnLyricsClick" ToolTipService.ToolTip="가사 패널">
                    <FontIcon Glyph="&#xEC4F;" FontSize="13"/>
                </ToggleButton>

                <!-- Settings Button -->
                <Button x:Uid="NowPlaying_SettingsButton" x:Name="SettingsButton" Style="{StaticResource TransportButton}"
                        AutomationProperties.Name="환경설정"
                        Click="OnSettingsClick" ToolTipService.ToolTip="환경설정">
                    <FontIcon Glyph="&#xE713;" FontSize="13"/>
                </Button>
            </StackPanel>
        </Grid>
    </Grid>
</UserControl>

<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net10.0-windows10.0.19041.0</TargetFramework>
    <TargetPlatformMinVersion>10.0.19041.0</TargetPlatformMinVersion>
    <RootNamespace>DawnPlayer.App</RootNamespace>
    <ApplicationManifest>app.manifest</ApplicationManifest>
    <Platforms>x64;ARM64</Platforms>
    <Platform Condition="'$(Platform)' == ''">x64</Platform>
    <RuntimeIdentifiers>win-x64;win-arm64</RuntimeIdentifiers>
    <RuntimeIdentifier Condition="'$(RuntimeIdentifier)' == ''">win-x64</RuntimeIdentifier>
    <UseWinUI>true</UseWinUI>
    <EnableMsixTooling>true</EnableMsixTooling>
    <WindowsPackageType>None</WindowsPackageType>
    <WindowsAppSDKSelfContained>true</WindowsAppSDKSelfContained>
    <DefaultLanguage>ko-KR</DefaultLanguage>
    <AllowUnsafeBlocks>true</AllowUnsafeBlocks>
    <ApplicationIcon>Assets\app.ico</ApplicationIcon>
  </PropertyGroup>

  <ItemGroup>
    <Content Include="Assets\**">
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
    </Content>
  </ItemGroup>

  <!-- Strings/<culture>/Resources.resw files are compiled into the app's resources.pri by the
       WinUI build targets (PRIResource default globs). DefaultLanguage marks ko-KR as the
       fallback language for the MRT Core candidate chain. -->

  <ItemGroup>
    <PackageReference Include="Microsoft.Extensions.DependencyInjection" Version="10.0.0" />
    <PackageReference Include="Microsoft.WindowsAppSDK" Version="2.5.1" />
    <PackageReference Include="Microsoft.Windows.SDK.BuildTools" Version="10.0.28000.2526" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\DawnPlayer.Core\DawnPlayer.Core.csproj" />
  </ItemGroup>

  <!-- Debug builds write a full crash dump (native heap corruption included) so an intermittent
       crash can be analyzed after the fact. The directory must exist — it is created on demand by
       tools/ensure-crash-dump-dir or manually; a missing directory silently skips the dump. -->
  <ItemGroup Condition="'$(Configuration)' == 'Debug'">
    <RuntimeHostConfigurationOption Include="System.DbgEnableMiniDump" Value="1" />
    <RuntimeHostConfigurationOption Include="System.DbgMiniDumpName" Value="E:\coding\dawn-player\crash-dumps\DawnPlayer.dmp" />
    <RuntimeHostConfigurationOption Include="System.DbgMiniDumpType" Value="2" />
  </ItemGroup>

</Project>

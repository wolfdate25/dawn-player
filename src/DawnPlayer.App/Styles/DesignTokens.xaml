<?xml version="1.0" encoding="utf-8"?>
<ResourceDictionary
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <!--
      U0 design-token layer (implementation_plan.md 개정 4판, U0).
      Semantic additions on top of DawnTheme.xaml's Eole palette — DawnTheme keeps every
      existing key; this dictionary only ADDS roles it lacked:
        * status colors (success/danger/warning/info) with per-theme variants that pass
          WCAG 4.5:1 as foreground text on the Eole card/panel surfaces (gated in
          DesignTokenTests).
        * glass tokens for immersive surfaces (fullscreen Now Playing, U4).
      Scale tokens (spacing / typography / motion) live outside ThemeDictionaries because
      they do not vary by theme. Their numeric values are mirrored in
      Styles/DesignTokenValues.cs; DesignTokenTests compares the two so they cannot drift.
      Typography translation rule (skill pairing Righteous/Poppins is a web recommendation):
      stay on Segoe UI Variable — the scale below is the app's size/weight contract.
    -->

    <ResourceDictionary.ThemeDictionaries>
        <ResourceDictionary x:Key="Default">
            <!-- Status semantics (dark theme: lighter tints for text on dark surfaces) -->
            <Color x:Key="StatusSuccessColor">#FF4ADE80</Color>
            <Color x:Key="StatusDangerColor">#FFF87171</Color>
            <Color x:Key="StatusWarningColor">#FFFBBF24</Color>
            <Color x:Key="StatusInfoColor">#FF60A5FA</Color>

            <!-- Immersive glass surfaces (U4 fullscreen Now Playing) -->
            <Color x:Key="GlassFillColor">#B31F1F25</Color>
            <Color x:Key="GlassBorderColor">#33FFFFFF</Color>

            <SolidColorBrush x:Key="StatusSuccessBrush" Color="{StaticResource StatusSuccessColor}" />
            <SolidColorBrush x:Key="StatusDangerBrush" Color="{StaticResource StatusDangerColor}" />
            <SolidColorBrush x:Key="StatusWarningBrush" Color="{StaticResource StatusWarningColor}" />
            <SolidColorBrush x:Key="StatusInfoBrush" Color="{StaticResource StatusInfoColor}" />
            <Color x:Key="OnAccentColor">#FF141414</Color>
            <SolidColorBrush x:Key="OnAccentBrush" Color="{StaticResource OnAccentColor}" />
            <Color x:Key="VisualizerSurfaceColor">#FF141414</Color>
            <SolidColorBrush x:Key="VisualizerSurfaceBrush" Color="{StaticResource VisualizerSurfaceColor}" />
            <SolidColorBrush x:Key="GlassFillBrush" Color="{StaticResource GlassFillColor}" />
            <SolidColorBrush x:Key="GlassBorderBrush" Color="{StaticResource GlassBorderColor}" />
        </ResourceDictionary>

        <ResourceDictionary x:Key="Light">
            <!-- Status semantics (light theme: darker shades for 4.5:1 on light surfaces) -->
            <Color x:Key="StatusSuccessColor">#FF166534</Color>
            <Color x:Key="StatusDangerColor">#FFB91C1C</Color>
            <Color x:Key="StatusWarningColor">#FF92400E</Color>
            <Color x:Key="StatusInfoColor">#FF1D4ED8</Color>

            <!-- Immersive glass surfaces -->
            <Color x:Key="GlassFillColor">#D9F7F6F3</Color>
            <Color x:Key="GlassBorderColor">#22000000</Color>

            <SolidColorBrush x:Key="StatusSuccessBrush" Color="{StaticResource StatusSuccessColor}" />
            <SolidColorBrush x:Key="StatusDangerBrush" Color="{StaticResource StatusDangerColor}" />
            <SolidColorBrush x:Key="StatusWarningBrush" Color="{StaticResource StatusWarningColor}" />
            <SolidColorBrush x:Key="StatusInfoBrush" Color="{StaticResource StatusInfoColor}" />
            <Color x:Key="OnAccentColor">#FF141414</Color>
            <SolidColorBrush x:Key="OnAccentBrush" Color="{StaticResource OnAccentColor}" />
            <Color x:Key="VisualizerSurfaceColor">#FF141414</Color>
            <SolidColorBrush x:Key="VisualizerSurfaceBrush" Color="{StaticResource VisualizerSurfaceColor}" />
            <SolidColorBrush x:Key="GlassFillBrush" Color="{StaticResource GlassFillColor}" />
            <SolidColorBrush x:Key="GlassBorderBrush" Color="{StaticResource GlassBorderColor}" />
        </ResourceDictionary>
    </ResourceDictionary.ThemeDictionaries>

    <!-- Spacing scale (skill density dial, standard desktop tier: 16-64 → 4px base grid) -->
    <x:Double x:Key="SpaceXs">4</x:Double>
    <x:Double x:Key="SpaceS">8</x:Double>
    <x:Double x:Key="SpaceM">12</x:Double>
    <x:Double x:Key="SpaceL">16</x:Double>
    <x:Double x:Key="SpaceXl">24</x:Double>
    <x:Double x:Key="SpaceXxl">32</x:Double>

    <!-- Typography scale (Segoe UI Variable size contract; see header note) -->
    <x:Double x:Key="FontCaption">11</x:Double>
    <x:Double x:Key="FontBodySmall">12</x:Double>
    <x:Double x:Key="FontBody">13</x:Double>
    <x:Double x:Key="FontSubtitle">14</x:Double>
    <x:Double x:Key="FontTitle">17</x:Double>
    <x:Double x:Key="FontDisplay">22</x:Double>

    <!-- Motion durations in milliseconds (micro-interaction tier: 150-200ms hover band) -->
    <x:Double x:Key="MotionDurationFastMs">120</x:Double>
    <x:Double x:Key="MotionDurationNormalMs">180</x:Double>
    <x:Double x:Key="MotionDurationSlowMs">280</x:Double>

    <!-- List density defaults (U3, Cozy == the shipped look). DensityScale.Apply overwrites
         these in the application resource scope when the user switches preset. -->
    <x:Double x:Key="TrackRowMinHeight">28</x:Double>
    <x:Double x:Key="TrackRowSpacing">12</x:Double>
    <x:Double x:Key="ListCoverSize">32</x:Double>

    <!-- Outline radius scale (L13, WinUI Geometry convention): 0 = flush bands (맞닿는 직선
         모서리), 4 = 행·박스·세그먼트(ControlCornerRadius 관례), 5 = 칩(셸 탭 승인 룩),
         8 = 오버레이(시스템 관리). 페이지 XAML의 리터럴 반경은 OutlineUnityGateTests가 이
         스케일로 묶는다 — 3·6은 퇴출. 값의 C# 미러는 DesignTokenValues.Radius/Rows. -->
    <x:Double x:Key="RowCornerRadius">4</x:Double>
    <x:Double x:Key="ChipCornerRadius">5</x:Double>
    <!-- Media rows (썸네일 행: Radio·DLNA) — 밀도 스케일과 무관한 고정 높이. -->
    <x:Double x:Key="MediaRowMinHeight">44</x:Double>

    <!-- L14 의미 인셋 토큰 (Thickness — 스칼라 미러 대상 아님, LayoutRhythmGateTests가 정의와
         소비를 함께 단언). Network 콘텐츠 열과 Playlist 헤더 원점: Playlist 패밀리(20) 기준,
         하단바 인셋 18과 Δ2. -->
    <Thickness x:Key="PageContentPadding">20,14,20,16</Thickness>
    <Thickness x:Key="PageHeaderMargin">20,14,20,6</Thickness>

</ResourceDictionary>

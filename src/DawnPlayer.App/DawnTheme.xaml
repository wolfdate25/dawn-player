<?xml version="1.0" encoding="utf-8"?>
<ResourceDictionary
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <ResourceDictionary.ThemeDictionaries>
        <!-- ==================== DARK THEME (EOLE SIGNATURE SLATE) ==================== -->
        <ResourceDictionary x:Key="Default">
            <!-- Eole signature dark palette -->
            <Color x:Key="LayerBgColor">#FF18181D</Color>
            <Color x:Key="PanelColor">#FF1F1F25</Color>
            <Color x:Key="PanelSubtleColor">#FF19191E</Color>
            <Color x:Key="CardColor">#FF27272F</Color>
            <Color x:Key="CardHoverColor">#FF32323C</Color>
            <Color x:Key="CardPressedColor">#FF3C3C48</Color>
            <Color x:Key="ControlBgColor">#FF2A2A33</Color>
            <Color x:Key="HoverColor">#FF30303A</Color>
            <Color x:Key="SeparatorColor">#FF2F2F39</Color>
            <Color x:Key="SeparatorSubtleColor">#FF24242D</Color>
            <Color x:Key="BorderSubtleColor">#33FFFFFF</Color>

            <Color x:Key="TextPrimaryColor">#FFF3F3F6</Color>
            <Color x:Key="TextSecondaryColor">#FFAEAEBC</Color>
            <Color x:Key="TextTertiaryColor">#FF8F8FA0</Color>

            <!-- Eole Amber Accent -->
            <Color x:Key="DawnAccentColor">#FFE8A33D</Color>
            <Color x:Key="DawnAccentHoverColor">#FFF0B456</Color>
            <Color x:Key="DawnAccentPressedColor">#FFD4881A</Color>
            <Color x:Key="DawnAccentMutedColor">#33E8A33D</Color>
            <Color x:Key="DawnAccentGlowColor">#1AE8A33D</Color>
            <!-- Text/icon-usable accent variant: meets 4.5:1 on every rest surface. Equals the
                 accent on dark; darker on light. ThemeService recomputes it per accent preset. -->
            <Color x:Key="DawnAccentTextColor">#FFE8A33D</Color>

            <Color x:Key="BadgeBgColor">#FF2A2A34</Color>
            <Color x:Key="BadgeTextColor">#FFBDBDCB</Color>

            <!-- Brushes -->
            <SolidColorBrush x:Key="LayerBgBrush" Color="{StaticResource LayerBgColor}" />
            <SolidColorBrush x:Key="PanelBrush" Color="{StaticResource PanelColor}" />
            <SolidColorBrush x:Key="PanelSubtleBrush" Color="{StaticResource PanelSubtleColor}" />
            <SolidColorBrush x:Key="CardBrush" Color="{StaticResource CardColor}" />
            <SolidColorBrush x:Key="CardHoverBrush" Color="{StaticResource CardHoverColor}" />
            <SolidColorBrush x:Key="CardPressedBrush" Color="{StaticResource CardPressedColor}" />
            <SolidColorBrush x:Key="ControlBgBrush" Color="{StaticResource ControlBgColor}" />
            <SolidColorBrush x:Key="HoverBrush" Color="{StaticResource HoverColor}" />
            <SolidColorBrush x:Key="SeparatorBrush" Color="{StaticResource SeparatorColor}" />
            <SolidColorBrush x:Key="SeparatorSubtleBrush" Color="{StaticResource SeparatorSubtleColor}" />
            <SolidColorBrush x:Key="BorderSubtleBrush" Color="{StaticResource BorderSubtleColor}" />

            <SolidColorBrush x:Key="TextPrimaryBrush" Color="{StaticResource TextPrimaryColor}" />
            <SolidColorBrush x:Key="TextSecondaryBrush" Color="{StaticResource TextSecondaryColor}" />
            <SolidColorBrush x:Key="TextTertiaryBrush" Color="{StaticResource TextTertiaryColor}" />

            <SolidColorBrush x:Key="DawnAccentBrush" Color="{StaticResource DawnAccentColor}" />
            <SolidColorBrush x:Key="DawnAccentHoverBrush" Color="{StaticResource DawnAccentHoverColor}" />
            <SolidColorBrush x:Key="DawnAccentPressedBrush" Color="{StaticResource DawnAccentPressedColor}" />
            <SolidColorBrush x:Key="DawnAccentMutedBrush" Color="{StaticResource DawnAccentMutedColor}" />
            <SolidColorBrush x:Key="DawnAccentGlowBrush" Color="{StaticResource DawnAccentGlowColor}" />
            <SolidColorBrush x:Key="DawnAccentTextBrush" Color="{StaticResource DawnAccentTextColor}" />

            <SolidColorBrush x:Key="BadgeBgBrush" Color="{StaticResource BadgeBgColor}" />
            <SolidColorBrush x:Key="BadgeTextBrush" Color="{StaticResource BadgeTextColor}" />

            <!-- WinUI standard control theme overrides for fluent harmony -->
            <SolidColorBrush x:Key="NavigationViewContentBackground" Color="Transparent"/>
            <SolidColorBrush x:Key="NavigationViewDefaultPaneBackground" Color="{StaticResource PanelColor}"/>
            <SolidColorBrush x:Key="NavigationViewTopPaneBackground" Color="{StaticResource PanelColor}"/>

            <SolidColorBrush x:Key="ListViewItemBackgroundSelected" Color="#26E8A33D"/>
            <SolidColorBrush x:Key="ListViewItemBackgroundSelectedPointerOver" Color="#3DE8A33D"/>
            <SolidColorBrush x:Key="ListViewItemBackgroundSelectedPressed" Color="#4DE8A33D"/>
            <SolidColorBrush x:Key="ListViewItemBackgroundPointerOver" Color="#1FFFFFFF"/>
            <SolidColorBrush x:Key="ListViewItemBackgroundPressed" Color="#28FFFFFF"/>

            <!-- PT5-13 (3:1 convergence): the unplayed track is a boundary, not decor — the rest
                 value clears 3:1 against every surface a slider sits on (Panel/LayerBg/Card, the
                 card being the binding constraint at 3.02:1), and hover widens the gap. -->
            <SolidColorBrush x:Key="SliderTrackFill" Color="#FF707079"/>
            <SolidColorBrush x:Key="SliderTrackValueFill" Color="{StaticResource DawnAccentColor}"/>
            <SolidColorBrush x:Key="SliderThumbBackground" Color="{StaticResource DawnAccentColor}"/>
            <SolidColorBrush x:Key="SliderTrackFillPointerOver" Color="#FF7B7B85"/>
            <SolidColorBrush x:Key="SliderTrackValueFillPointerOver" Color="{StaticResource DawnAccentHoverColor}"/>
            <SolidColorBrush x:Key="SliderThumbBackgroundPointerOver" Color="{StaticResource DawnAccentHoverColor}"/>
            <SolidColorBrush x:Key="SliderThumbBackgroundPressed" Color="{StaticResource DawnAccentPressedColor}"/>

            <SolidColorBrush x:Key="TabViewItemHeaderBackground" Color="Transparent"/>
            <SolidColorBrush x:Key="TabViewItemHeaderBackgroundSelected" Color="{StaticResource CardColor}"/>
            <SolidColorBrush x:Key="TabViewItemHeaderBackgroundPointerOver" Color="{StaticResource HoverColor}"/>

            <!-- ToggleButton Fluent Overrides -->
            <SolidColorBrush x:Key="ToggleButtonBackground" Color="Transparent"/>
            <SolidColorBrush x:Key="ToggleButtonBackgroundPointerOver" Color="{StaticResource HoverColor}"/>
            <SolidColorBrush x:Key="ToggleButtonBackgroundPressed" Color="{StaticResource CardPressedColor}"/>
            <SolidColorBrush x:Key="ToggleButtonBackgroundChecked" Color="{StaticResource DawnAccentMutedColor}"/>
            <SolidColorBrush x:Key="ToggleButtonBackgroundCheckedPointerOver" Color="{StaticResource DawnAccentMutedColor}"/>
            <SolidColorBrush x:Key="ToggleButtonBackgroundCheckedPressed" Color="{StaticResource DawnAccentGlowColor}"/>

            <SolidColorBrush x:Key="ToggleButtonBorderBrush" Color="Transparent"/>
            <SolidColorBrush x:Key="ToggleButtonBorderBrushPointerOver" Color="Transparent"/>
            <SolidColorBrush x:Key="ToggleButtonBorderBrushPressed" Color="Transparent"/>
            <SolidColorBrush x:Key="ToggleButtonBorderBrushChecked" Color="{StaticResource DawnAccentGlowColor}"/>
            <SolidColorBrush x:Key="ToggleButtonBorderBrushCheckedPointerOver" Color="{StaticResource DawnAccentColor}"/>
            <SolidColorBrush x:Key="ToggleButtonBorderBrushCheckedPressed" Color="{StaticResource DawnAccentPressedColor}"/>

            <SolidColorBrush x:Key="ToggleButtonForeground" Color="{StaticResource TextSecondaryColor}"/>
            <SolidColorBrush x:Key="ToggleButtonForegroundPointerOver" Color="{StaticResource TextPrimaryColor}"/>
            <SolidColorBrush x:Key="ToggleButtonForegroundPressed" Color="{StaticResource TextPrimaryColor}"/>
            <SolidColorBrush x:Key="ToggleButtonForegroundChecked" Color="{StaticResource DawnAccentTextColor}"/>
            <SolidColorBrush x:Key="ToggleButtonForegroundCheckedPointerOver" Color="{StaticResource DawnAccentTextColor}"/>
            <SolidColorBrush x:Key="ToggleButtonForegroundCheckedPressed" Color="{StaticResource DawnAccentTextColor}"/>
        </ResourceDictionary>

        <!-- ==================== LIGHT THEME (EOLE SIGNATURE WARM SLATE) ==================== -->
        <ResourceDictionary x:Key="Light">
            <Color x:Key="LayerBgColor">#FFF7F6F3</Color>
            <Color x:Key="PanelColor">#FFF0EFEB</Color>
            <Color x:Key="PanelSubtleColor">#FFEBEAE5</Color>
            <Color x:Key="CardColor">#FFE6E4DE</Color>
            <Color x:Key="CardHoverColor">#FFDCDAD3</Color>
            <Color x:Key="CardPressedColor">#FFD2D0C8</Color>
            <Color x:Key="ControlBgColor">#FFE2E0D8</Color>
            <Color x:Key="HoverColor">#FFDDDCD5</Color>
            <Color x:Key="SeparatorColor">#FFD5D3CC</Color>
            <Color x:Key="SeparatorSubtleColor">#FFE0DED8</Color>
            <Color x:Key="BorderSubtleColor">#22000000</Color>

            <Color x:Key="TextPrimaryColor">#FF1A1A20</Color>
            <Color x:Key="TextSecondaryColor">#FF555562</Color>
            <Color x:Key="TextTertiaryColor">#FF62626F</Color>

            <!-- Eole Warm Amber Accent (Light Mode) -->
            <Color x:Key="DawnAccentColor">#FFC77F1B</Color>
            <Color x:Key="DawnAccentHoverColor">#FFD68D25</Color>
            <Color x:Key="DawnAccentPressedColor">#FFAE6C12</Color>
            <Color x:Key="DawnAccentMutedColor">#26C77F1B</Color>
            <Color x:Key="DawnAccentGlowColor">#12C77F1B</Color>
            <!-- Text/icon accent must clear 4.5:1 on the warm light panel/card, which the raw
                 light accent (~2.6:1) cannot — foregrounds use this deeper amber instead. -->
            <Color x:Key="DawnAccentTextColor">#FF8F5408</Color>

            <Color x:Key="BadgeBgColor">#FFE0DED6</Color>
            <Color x:Key="BadgeTextColor">#FF484854</Color>

            <!-- Brushes -->
            <SolidColorBrush x:Key="LayerBgBrush" Color="{StaticResource LayerBgColor}" />
            <SolidColorBrush x:Key="PanelBrush" Color="{StaticResource PanelColor}" />
            <SolidColorBrush x:Key="PanelSubtleBrush" Color="{StaticResource PanelSubtleColor}" />
            <SolidColorBrush x:Key="CardBrush" Color="{StaticResource CardColor}" />
            <SolidColorBrush x:Key="CardHoverBrush" Color="{StaticResource CardHoverColor}" />
            <SolidColorBrush x:Key="CardPressedBrush" Color="{StaticResource CardPressedColor}" />
            <SolidColorBrush x:Key="ControlBgBrush" Color="{StaticResource ControlBgColor}" />
            <SolidColorBrush x:Key="HoverBrush" Color="{StaticResource HoverColor}" />
            <SolidColorBrush x:Key="SeparatorBrush" Color="{StaticResource SeparatorColor}" />
            <SolidColorBrush x:Key="SeparatorSubtleBrush" Color="{StaticResource SeparatorSubtleColor}" />
            <SolidColorBrush x:Key="BorderSubtleBrush" Color="{StaticResource BorderSubtleColor}" />

            <SolidColorBrush x:Key="TextPrimaryBrush" Color="{StaticResource TextPrimaryColor}" />
            <SolidColorBrush x:Key="TextSecondaryBrush" Color="{StaticResource TextSecondaryColor}" />
            <SolidColorBrush x:Key="TextTertiaryBrush" Color="{StaticResource TextTertiaryColor}" />

            <SolidColorBrush x:Key="DawnAccentBrush" Color="{StaticResource DawnAccentColor}" />
            <SolidColorBrush x:Key="DawnAccentHoverBrush" Color="{StaticResource DawnAccentHoverColor}" />
            <SolidColorBrush x:Key="DawnAccentPressedBrush" Color="{StaticResource DawnAccentPressedColor}" />
            <SolidColorBrush x:Key="DawnAccentMutedBrush" Color="{StaticResource DawnAccentMutedColor}" />
            <SolidColorBrush x:Key="DawnAccentGlowBrush" Color="{StaticResource DawnAccentGlowColor}" />
            <SolidColorBrush x:Key="DawnAccentTextBrush" Color="{StaticResource DawnAccentTextColor}" />

            <SolidColorBrush x:Key="BadgeBgBrush" Color="{StaticResource BadgeBgColor}" />
            <SolidColorBrush x:Key="BadgeTextBrush" Color="{StaticResource BadgeTextColor}" />

            <!-- WinUI standard control theme overrides for fluent harmony -->
            <SolidColorBrush x:Key="NavigationViewContentBackground" Color="Transparent"/>
            <SolidColorBrush x:Key="NavigationViewDefaultPaneBackground" Color="{StaticResource PanelColor}"/>
            <SolidColorBrush x:Key="NavigationViewTopPaneBackground" Color="{StaticResource PanelColor}"/>

            <SolidColorBrush x:Key="ListViewItemBackgroundSelected" Color="#22C77F1B"/>
            <SolidColorBrush x:Key="ListViewItemBackgroundSelectedPointerOver" Color="#33C77F1B"/>
            <SolidColorBrush x:Key="ListViewItemBackgroundSelectedPressed" Color="#44C77F1B"/>
            <SolidColorBrush x:Key="ListViewItemBackgroundPointerOver" Color="#12000000"/>
            <SolidColorBrush x:Key="ListViewItemBackgroundPressed" Color="#1A000000"/>

            <!-- PT5-13 (3:1 convergence): the rest value clears 3:1 against every surface a
                 slider sits on (the card being the binding constraint at 3.01:1); hover darkens
                 on light — the old hover lightened, which pushed the boundary below 3:1. -->
            <SolidColorBrush x:Key="SliderTrackFill" Color="#FF85827C"/>
            <SolidColorBrush x:Key="SliderTrackValueFill" Color="{StaticResource DawnAccentColor}"/>
            <SolidColorBrush x:Key="SliderThumbBackground" Color="{StaticResource DawnAccentColor}"/>
            <SolidColorBrush x:Key="SliderTrackFillPointerOver" Color="#FF6E6B65"/>
            <SolidColorBrush x:Key="SliderTrackValueFillPointerOver" Color="{StaticResource DawnAccentHoverColor}"/>
            <SolidColorBrush x:Key="SliderThumbBackgroundPointerOver" Color="{StaticResource DawnAccentHoverColor}"/>
            <SolidColorBrush x:Key="SliderThumbBackgroundPressed" Color="{StaticResource DawnAccentPressedColor}"/>

            <SolidColorBrush x:Key="TabViewItemHeaderBackground" Color="Transparent"/>
            <SolidColorBrush x:Key="TabViewItemHeaderBackgroundSelected" Color="{StaticResource CardColor}"/>
            <SolidColorBrush x:Key="TabViewItemHeaderBackgroundPointerOver" Color="{StaticResource HoverColor}"/>

            <!-- ToggleButton Fluent Overrides (Light Mode) -->
            <SolidColorBrush x:Key="ToggleButtonBackground" Color="Transparent"/>
            <SolidColorBrush x:Key="ToggleButtonBackgroundPointerOver" Color="{StaticResource HoverColor}"/>
            <SolidColorBrush x:Key="ToggleButtonBackgroundPressed" Color="{StaticResource CardPressedColor}"/>
            <SolidColorBrush x:Key="ToggleButtonBackgroundChecked" Color="{StaticResource DawnAccentMutedColor}"/>
            <SolidColorBrush x:Key="ToggleButtonBackgroundCheckedPointerOver" Color="{StaticResource DawnAccentMutedColor}"/>
            <SolidColorBrush x:Key="ToggleButtonBackgroundCheckedPressed" Color="{StaticResource DawnAccentGlowColor}"/>

            <SolidColorBrush x:Key="ToggleButtonBorderBrush" Color="Transparent"/>
            <SolidColorBrush x:Key="ToggleButtonBorderBrushPointerOver" Color="Transparent"/>
            <SolidColorBrush x:Key="ToggleButtonBorderBrushPressed" Color="Transparent"/>
            <SolidColorBrush x:Key="ToggleButtonBorderBrushChecked" Color="{StaticResource DawnAccentGlowColor}"/>
            <SolidColorBrush x:Key="ToggleButtonBorderBrushCheckedPointerOver" Color="{StaticResource DawnAccentColor}"/>
            <SolidColorBrush x:Key="ToggleButtonBorderBrushCheckedPressed" Color="{StaticResource DawnAccentPressedColor}"/>

            <SolidColorBrush x:Key="ToggleButtonForeground" Color="{StaticResource TextSecondaryColor}"/>
            <SolidColorBrush x:Key="ToggleButtonForegroundPointerOver" Color="{StaticResource TextPrimaryColor}"/>
            <SolidColorBrush x:Key="ToggleButtonForegroundPressed" Color="{StaticResource TextPrimaryColor}"/>
            <SolidColorBrush x:Key="ToggleButtonForegroundChecked" Color="{StaticResource DawnAccentTextColor}"/>
            <SolidColorBrush x:Key="ToggleButtonForegroundCheckedPointerOver" Color="{StaticResource DawnAccentTextColor}"/>
            <SolidColorBrush x:Key="ToggleButtonForegroundCheckedPressed" Color="{StaticResource DawnAccentTextColor}"/>
        </ResourceDictionary>
    </ResourceDictionary.ThemeDictionaries>

    <!-- ==================== ROOT FALLBACK BRUSHES FOR DIRECT CODE / RESOURCE LOOKUPS ==================== -->
    <SolidColorBrush x:Key="DawnAccentBrush" Color="#FFE8A33D" />
    <SolidColorBrush x:Key="DawnAccentTextBrush" Color="#FFE8A33D" />
    <SolidColorBrush x:Key="OnAccentBrush" Color="#FF141414" />
    <SolidColorBrush x:Key="TextPrimaryBrush" Color="#FFF3F3F6" />
    <SolidColorBrush x:Key="TextSecondaryBrush" Color="#FFAEAEBC" />
    <SolidColorBrush x:Key="TextTertiaryBrush" Color="#FF8F8FA0" />
    <SolidColorBrush x:Key="LayerBgBrush" Color="#FF18181D" />
    <SolidColorBrush x:Key="PanelBrush" Color="#FF1F1F25" />
    <SolidColorBrush x:Key="PanelSubtleBrush" Color="#FF19191E" />
    <SolidColorBrush x:Key="CardBrush" Color="#FF27272F" />

    <!-- ==================== SHARED TYPOGRAPHY & TEXT STYLES ==================== -->
    <Style x:Key="TrackTitleText" TargetType="TextBlock">
        <Setter Property="FontSize" Value="13"/>
        <Setter Property="FontWeight" Value="Normal"/>
        <Setter Property="Foreground" Value="{ThemeResource TextPrimaryBrush}"/>
        <Setter Property="TextTrimming" Value="CharacterEllipsis"/>
        <Setter Property="VerticalAlignment" Value="Center"/>
    </Style>

    <Style x:Key="TrackDimText" TargetType="TextBlock">
        <Setter Property="FontSize" Value="12"/>
        <Setter Property="Foreground" Value="{ThemeResource TextSecondaryBrush}"/>
        <Setter Property="TextTrimming" Value="CharacterEllipsis"/>
        <Setter Property="VerticalAlignment" Value="Center"/>
    </Style>

    <Style x:Key="TrackNumText" TargetType="TextBlock">
        <Setter Property="FontSize" Value="12"/>
        <Setter Property="Foreground" Value="{ThemeResource TextTertiaryBrush}"/>
        <Setter Property="TextTrimming" Value="Clip"/>
        <Setter Property="VerticalAlignment" Value="Center"/>
        <Setter Property="TextAlignment" Value="Left"/>
    </Style>

    <Style x:Key="TrackDurationText" TargetType="TextBlock">
        <Setter Property="FontSize" Value="12"/>
        <Setter Property="Foreground" Value="{ThemeResource TextSecondaryBrush}"/>
        <Setter Property="TextTrimming" Value="Clip"/>
        <Setter Property="VerticalAlignment" Value="Center"/>
        <Setter Property="TextAlignment" Value="Right"/>
        <Setter Property="HorizontalAlignment" Value="Right"/>
    </Style>

    <Style x:Key="ColumnHeaderText" TargetType="TextBlock" BasedOn="{StaticResource TrackDimText}">
        <Setter Property="FontSize" Value="11.5"/>
        <Setter Property="FontWeight" Value="SemiBold"/>
        <Setter Property="Foreground" Value="{ThemeResource TextTertiaryBrush}"/>
    </Style>

    <Style x:Key="AlbumHeaderTitleText" TargetType="TextBlock">
        <Setter Property="FontSize" Value="14"/>
        <Setter Property="FontWeight" Value="SemiBold"/>
        <Setter Property="Foreground" Value="{ThemeResource TextPrimaryBrush}"/>
        <Setter Property="TextTrimming" Value="CharacterEllipsis"/>
    </Style>

    <Style x:Key="AlbumHeaderSubText" TargetType="TextBlock">
        <Setter Property="FontSize" Value="12"/>
        <Setter Property="Foreground" Value="{ThemeResource TextSecondaryBrush}"/>
        <Setter Property="TextTrimming" Value="CharacterEllipsis"/>
    </Style>

    <Style x:Key="ListIcon" TargetType="FontIcon">
        <Setter Property="FontSize" Value="14"/>
        <Setter Property="Foreground" Value="{ThemeResource TextSecondaryBrush}"/>
    </Style>

    <Style x:Key="BadgeText" TargetType="TextBlock">
        <Setter Property="FontSize" Value="11"/>
        <Setter Property="FontWeight" Value="SemiBold"/>
        <Setter Property="Foreground" Value="{ThemeResource BadgeTextBrush}"/>
        <Setter Property="VerticalAlignment" Value="Center"/>
    </Style>

    <!-- ==================== SHARED CONTROL STYLES ==================== -->

    <!-- Transport round button -->
    <Style x:Key="TransportButton" TargetType="Button">
        <Setter Property="UseSystemFocusVisuals" Value="True"/>
        <Setter Property="Width" Value="36"/>
        <Setter Property="Height" Value="36"/>
        <Setter Property="CornerRadius" Value="18"/>
        <Setter Property="Background" Value="Transparent"/>
        <Setter Property="BorderThickness" Value="0"/>
        <Setter Property="Padding" Value="0"/>
        <Setter Property="HorizontalAlignment" Value="Center"/>
        <Setter Property="VerticalAlignment" Value="Center"/>
    </Style>

    <!-- L11 rating cell: invisible chrome over a list row, click opens the rating flyout.
         The hover tint is the interaction feedback the star text alone never gave. -->
    <Style x:Key="RatingCellButton" TargetType="Button">
        <Setter Property="UseSystemFocusVisuals" Value="True"/>
        <Setter Property="Background" Value="Transparent"/>
        <Setter Property="BorderThickness" Value="0"/>
        <Setter Property="Padding" Value="3,1"/>
        <Setter Property="CornerRadius" Value="3"/>
        <Setter Property="MinWidth" Value="20"/>
        <Setter Property="MinHeight" Value="20"/>
        <Setter Property="VerticalAlignment" Value="Center"/>
        <Setter Property="HorizontalContentAlignment" Value="Center"/>
    </Style>

    <!-- Transport round toggle button (Theme-Integrated, No Solid Blue Circle) -->
    <Style x:Key="TransportToggleButton" TargetType="ToggleButton">
        <Setter Property="UseSystemFocusVisuals" Value="True"/>
        <Setter Property="Width" Value="34"/>
        <Setter Property="Height" Value="34"/>
        <Setter Property="CornerRadius" Value="17"/>
        <Setter Property="Background" Value="Transparent"/>
        <Setter Property="BorderBrush" Value="Transparent"/>
        <Setter Property="BorderThickness" Value="0"/>
        <Setter Property="Padding" Value="0"/>
        <Setter Property="HorizontalAlignment" Value="Center"/>
        <Setter Property="VerticalAlignment" Value="Center"/>
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="ToggleButton">
                    <Grid x:Name="RootGrid" Background="Transparent" CornerRadius="{TemplateBinding CornerRadius}">
                        <VisualStateManager.VisualStateGroups>
                            <VisualStateGroup x:Name="CommonStates">
                                <VisualStateGroup.Transitions>
                                    <!-- 120ms = MotionDurationFast token; XAML Duration cannot take a token resource -->
                                    <VisualTransition GeneratedDuration="0:0:0.12"/>
                                </VisualStateGroup.Transitions>
                                <VisualState x:Name="Normal"/>
                                <VisualState x:Name="PointerOver">
                                    <Storyboard>
                                        <ObjectAnimationUsingKeyFrames Storyboard.TargetName="BackgroundBorder" Storyboard.TargetProperty="Background">
                                            <DiscreteObjectKeyFrame KeyTime="0" Value="{ThemeResource HoverBrush}"/>
                                        </ObjectAnimationUsingKeyFrames>
                                    </Storyboard>
                                </VisualState>
                                <VisualState x:Name="Pressed">
                                    <Storyboard>
                                        <ObjectAnimationUsingKeyFrames Storyboard.TargetName="BackgroundBorder" Storyboard.TargetProperty="Background">
                                            <DiscreteObjectKeyFrame KeyTime="0" Value="{ThemeResource CardPressedBrush}"/>
                                        </ObjectAnimationUsingKeyFrames>
                                    </Storyboard>
                                </VisualState>
                                <VisualState x:Name="Disabled">
                                    <Storyboard>
                                        <DoubleAnimation Storyboard.TargetName="RootGrid" Storyboard.TargetProperty="Opacity" To="0.38" Duration="0"/>
                                    </Storyboard>
                                </VisualState>
                            </VisualStateGroup>
                            <VisualStateGroup x:Name="CheckStates">
                                <!-- Active state is shown by the ICON color (accent vs
                                     secondary), which the player manages in code. The old
                                     filled-circle background competed with the play button. -->
                                <VisualState x:Name="Unchecked"/>
                                <VisualState x:Name="Checked"/>
                                <VisualState x:Name="Indeterminate"/>
                            </VisualStateGroup>
                        </VisualStateManager.VisualStateGroups>

                        <Border x:Name="BackgroundBorder"
                                Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}"
                                CornerRadius="{TemplateBinding CornerRadius}"
                                Width="{TemplateBinding Width}"
                                Height="{TemplateBinding Height}"/>

                        <ContentPresenter x:Name="ContentPresenter"
                                          Content="{TemplateBinding Content}"
                                          ContentTemplate="{TemplateBinding ContentTemplate}"
                                          ContentTransitions="{TemplateBinding ContentTransitions}"
                                          HorizontalAlignment="{TemplateBinding HorizontalContentAlignment}"
                                          VerticalAlignment="{TemplateBinding VerticalContentAlignment}"
                                          Margin="{TemplateBinding Padding}"/>
                    </Grid>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- Play/Pause: the single accent-filled control in the transport row. Glyph on top must
         stay near-black for contrast against every accent preset. -->
    <Style x:Key="PlayPauseButton" TargetType="Button">
        <Setter Property="UseSystemFocusVisuals" Value="True"/>
        <Setter Property="Width" Value="42"/>
        <Setter Property="Height" Value="42"/>
        <Setter Property="CornerRadius" Value="21"/>
        <Setter Property="Background" Value="{ThemeResource DawnAccentBrush}"/>
        <Setter Property="Padding" Value="0"/>
        <Setter Property="HorizontalAlignment" Value="Center"/>
        <Setter Property="VerticalAlignment" Value="Center"/>
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="Button">
                    <Grid x:Name="RootGrid" Background="{TemplateBinding Background}"
                          CornerRadius="{TemplateBinding CornerRadius}">
                        <VisualStateManager.VisualStateGroups>
                            <VisualStateGroup x:Name="CommonStates">
                                <VisualStateGroup.Transitions>
                                    <!-- 120ms = MotionDurationFast token; XAML Duration cannot take a token resource -->
                                    <VisualTransition GeneratedDuration="0:0:0.12"/>
                                </VisualStateGroup.Transitions>
                                <VisualState x:Name="Normal"/>
                                <VisualState x:Name="PointerOver">
                                    <Storyboard>
                                        <!-- 120ms = MotionDurationFast token; XAML Duration cannot
                                             take a token resource, keep in sync with DesignTokens -->
                                        <DoubleAnimation Storyboard.TargetName="RootGrid"
                                                         Storyboard.TargetProperty="Opacity"
                                                         To="0.88" Duration="0:0:0.12"/>
                                    </Storyboard>
                                </VisualState>
                                <VisualState x:Name="Pressed">
                                    <Storyboard>
                                        <DoubleAnimation Storyboard.TargetName="RootGrid"
                                                         Storyboard.TargetProperty="Opacity"
                                                         To="0.72" Duration="0:0:0.12"/>
                                    </Storyboard>
                                </VisualState>
                                <VisualState x:Name="Disabled">
                                    <Storyboard>
                                        <DoubleAnimation Storyboard.TargetName="RootGrid"
                                                         Storyboard.TargetProperty="Opacity"
                                                         To="0.38" Duration="0"/>
                                    </Storyboard>
                                </VisualState>
                            </VisualStateGroup>
                        </VisualStateManager.VisualStateGroups>
                        <ContentPresenter Content="{TemplateBinding Content}"
                                          ContentTemplate="{TemplateBinding ContentTemplate}"
                                          HorizontalAlignment="{TemplateBinding HorizontalContentAlignment}"
                                          VerticalAlignment="{TemplateBinding VerticalContentAlignment}"
                                          Margin="{TemplateBinding Padding}"/>
                    </Grid>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- Eole Audio Format / Codec Badge -->
    <Style x:Key="CodecBadge" TargetType="Border">
        <Setter Property="Background" Value="{ThemeResource BadgeBgBrush}"/>
        <Setter Property="CornerRadius" Value="4"/>
        <Setter Property="Padding" Value="6,2"/>
        <Setter Property="BorderBrush" Value="{ThemeResource BorderSubtleBrush}"/>
        <Setter Property="BorderThickness" Value="1"/>
        <Setter Property="VerticalAlignment" Value="Center"/>
    </Style>

    <!-- Eole slim slider: 3px track, 12px round accent thumb, accent-filled left side.
         Used by both the seek and the volume sliders so they share one visual language.
         The template keeps the part names WinUI's Slider drives at runtime
         (HorizontalTrackRect / HorizontalDecreaseRect / HorizontalThumb + translate transform),
         so value→thumb positioning keeps working without the stock chrome. -->
    <Style x:Key="EoleSlimSliderStyle" TargetType="Slider">
        <Setter Property="UseSystemFocusVisuals" Value="True"/>
        <Setter Property="MinHeight" Value="24"/>
        <Setter Property="VerticalAlignment" Value="Center"/>
        <Setter Property="Padding" Value="0"/>
        <Setter Property="Foreground" Value="{StaticResource DawnAccentTextBrush}"/>
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="Slider">
                    <Grid x:Name="SliderContainer" Background="Transparent">
                        <Grid x:Name="HorizontalTemplate" MinHeight="24">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto"/>
                                <ColumnDefinition Width="Auto"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>
                            <Rectangle x:Name="HorizontalTrackRect"
                                       Grid.Column="0" Grid.ColumnSpan="3"
                                       Height="3" RadiusX="1.5" RadiusY="1.5"
                                       Fill="{ThemeResource SliderTrackFill}"
                                       VerticalAlignment="Center"/>
                            <Rectangle x:Name="HorizontalDecreaseRect"
                                       Grid.Column="0"
                                       Height="3" RadiusX="1.5" RadiusY="1.5"
                                       Fill="{TemplateBinding Foreground}"
                                       VerticalAlignment="Center"/>
                            <Thumb x:Name="HorizontalThumb" Grid.Column="1"
                                   Width="12" Height="12"
                                   VerticalAlignment="Center">
                                <Thumb.RenderTransform>
                                    <TranslateTransform x:Name="HorizontalThumbTransform"/>
                                </Thumb.RenderTransform>
                                <Thumb.Template>
                                    <ControlTemplate TargetType="Thumb">
                                        <Ellipse Fill="{ThemeResource DawnAccentBrush}"
                                                 Stroke="{ThemeResource PanelBrush}"
                                                 StrokeThickness="1.5"/>
                                    </ControlTemplate>
                                </Thumb.Template>
                            </Thumb>
                        </Grid>
                    </Grid>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- Eole Album Year Badge Overlay -->
    <Style x:Key="YearBadgeStyle" TargetType="Border">
        <Setter Property="Background" Value="#A6000000"/>
        <Setter Property="CornerRadius" Value="3"/>
        <Setter Property="Padding" Value="5,1"/>
        <Setter Property="VerticalAlignment" Value="Top"/>
        <Setter Property="HorizontalAlignment" Value="Left"/>
        <Setter Property="Margin" Value="6"/>
    </Style>

    <!-- Sleek Title Bar Icon Button -->
    <Style x:Key="TitleMenuButtonStyle" TargetType="Button">
        <Setter Property="UseSystemFocusVisuals" Value="True"/>
        <Setter Property="Width" Value="32"/>
        <Setter Property="Height" Value="32"/>
        <Setter Property="Background" Value="Transparent"/>
        <Setter Property="BorderThickness" Value="0"/>
        <Setter Property="Padding" Value="0"/>
        <Setter Property="CornerRadius" Value="4"/>
        <Setter Property="HorizontalAlignment" Value="Center"/>
        <Setter Property="VerticalAlignment" Value="Center"/>
    </Style>

    <!-- Accent Button Style -->
    <Style x:Key="AccentButtonStyle" TargetType="Button">
        <Setter Property="UseSystemFocusVisuals" Value="True"/>
        <Setter Property="Background" Value="{ThemeResource DawnAccentBrush}"/>
        <!-- #141414 is the gated play-glyph contract color (DesignTokenTests) — one accent-on
             ink for every accent fill, not a second black. -->
        <Setter Property="Foreground" Value="{StaticResource OnAccentBrush}"/>
        <Setter Property="FontWeight" Value="SemiBold"/>
        <Setter Property="FontSize" Value="12"/>
        <Setter Property="Padding" Value="12,6"/>
        <Setter Property="CornerRadius" Value="4"/>
        <Setter Property="BorderThickness" Value="0"/>
    </Style>

    <!-- Eole Nav Tab Style (Sleek text+icon with bottom active accent underline) -->
    <Style x:Key="EoleNavTabStyle" TargetType="RadioButton">
        <Setter Property="UseSystemFocusVisuals" Value="True"/>
        <Setter Property="Background" Value="Transparent"/>
        <Setter Property="Foreground" Value="{ThemeResource TextSecondaryBrush}"/>
        <Setter Property="Padding" Value="14,0"/>
        <Setter Property="MinHeight" Value="40"/>
        <Setter Property="VerticalAlignment" Value="Stretch"/>
        <Setter Property="HorizontalAlignment" Value="Center"/>
        <Setter Property="BorderThickness" Value="0"/>
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="RadioButton">
                    <Grid Background="{TemplateBinding Background}" Padding="{TemplateBinding Padding}">
                        <ContentPresenter x:Name="ContentPresenter"
                                          Content="{TemplateBinding Content}"
                                          ContentTemplate="{TemplateBinding ContentTemplate}"
                                          VerticalAlignment="Center" HorizontalAlignment="Center"/>
                        <!-- Eole Active Indicator Underline (2px) -->
                        <Border x:Name="ActiveIndicator" Height="2" VerticalAlignment="Bottom"
                                Background="{ThemeResource DawnAccentBrush}" Opacity="0"
                                CornerRadius="1"/>
                        <VisualStateManager.VisualStateGroups>
                            <VisualStateGroup x:Name="CommonStates">
                                <VisualStateGroup.Transitions>
                                    <!-- 120ms = MotionDurationFast token; XAML Duration cannot take a token resource -->
                                    <VisualTransition GeneratedDuration="0:0:0.12"/>
                                </VisualStateGroup.Transitions>
                                <VisualState x:Name="Normal"/>
                                <VisualState x:Name="PointerOver">
                                    <VisualState.Setters>
                                        <Setter Target="ContentPresenter.Foreground" Value="{ThemeResource TextPrimaryBrush}"/>
                                    </VisualState.Setters>
                                </VisualState>
                                <VisualState x:Name="Pressed"/>
                                <VisualState x:Name="Disabled"/>
                            </VisualStateGroup>
                            <VisualStateGroup x:Name="CheckStates">
                                <VisualState x:Name="Checked">
                                    <VisualState.Setters>
                                        <Setter Target="ActiveIndicator.Opacity" Value="1"/>
                                        <Setter Target="ContentPresenter.Foreground" Value="{ThemeResource TextPrimaryBrush}"/>
                                        <Setter Target="ContentPresenter.FontWeight" Value="SemiBold"/>
                                    </VisualState.Setters>
                                </VisualState>
                                <VisualState x:Name="Unchecked"/>
                                <VisualState x:Name="Indeterminate"/>
                            </VisualStateGroup>
                        </VisualStateManager.VisualStateGroups>
                    </Grid>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- Segmented Icon/Text Tab Style (e.g. Grid / List toggle) -->
    <Style x:Key="SegmentedTabStyle" TargetType="RadioButton">
        <Setter Property="UseSystemFocusVisuals" Value="True"/>
        <Setter Property="Background" Value="Transparent"/>
        <Setter Property="Foreground" Value="{ThemeResource TextSecondaryBrush}"/>
        <Setter Property="Padding" Value="8,4"/>
        <Setter Property="MinHeight" Value="24"/>
        <Setter Property="MinWidth" Value="28"/>
        <Setter Property="CornerRadius" Value="3"/>
        <Setter Property="BorderThickness" Value="0"/>
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="RadioButton">
                    <Border x:Name="RootBorder" Background="{TemplateBinding Background}"
                            CornerRadius="{TemplateBinding CornerRadius}"
                            Padding="{TemplateBinding Padding}">
                        <ContentPresenter x:Name="ContentPresenter"
                                          Content="{TemplateBinding Content}"
                                          ContentTemplate="{TemplateBinding ContentTemplate}"
                                          VerticalAlignment="Center" HorizontalAlignment="Center"/>
                        <VisualStateManager.VisualStateGroups>
                            <VisualStateGroup x:Name="CommonStates">
                                <VisualStateGroup.Transitions>
                                    <!-- 120ms = MotionDurationFast token; XAML Duration cannot take a token resource -->
                                    <VisualTransition GeneratedDuration="0:0:0.12"/>
                                </VisualStateGroup.Transitions>
                                <VisualState x:Name="Normal"/>
                                <VisualState x:Name="PointerOver">
                                    <VisualState.Setters>
                                        <Setter Target="ContentPresenter.Foreground" Value="{ThemeResource TextPrimaryBrush}"/>
                                    </VisualState.Setters>
                                </VisualState>
                                <VisualState x:Name="Pressed"/>
                                <VisualState x:Name="Disabled"/>
                            </VisualStateGroup>
                            <VisualStateGroup x:Name="CheckStates">
                                <VisualState x:Name="Checked">
                                    <VisualState.Setters>
                                        <Setter Target="RootBorder.Background" Value="{ThemeResource CardBrush}"/>
                                        <Setter Target="ContentPresenter.Foreground" Value="{ThemeResource DawnAccentTextBrush}"/>
                                    </VisualState.Setters>
                                </VisualState>
                                <VisualState x:Name="Unchecked"/>
                                <VisualState x:Name="Indeterminate"/>
                            </VisualStateGroup>
                        </VisualStateManager.VisualStateGroups>
                    </Border>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

</ResourceDictionary>

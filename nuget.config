<?xml version="1.0" encoding="utf-8"?>
<configuration>
  <packageSources>
    <!-- 로컬 패치 NAudio(3.1.1-directsoundfix.1, PR naudio/NAudio#1456) 조회용 임시 피드.
         패키지는 tools/nuget-local/ 에 밴더링되어 CI에서도 복원된다.
         업스트림 3.1.1 정식 릴리스 후 제거하고 버전을 되돌린다. -->
    <add key="local-naudio-fix" value="tools/nuget-local" />
    <add key="nuget.org" value="https://api.nuget.org/v3/index.json" />
  </packageSources>
</configuration>
